<Page x:Class="SwiftPack.Views.PublishPackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}" Title="Publish Package">

  <Page.Resources>
    <!-- PDBtn - matches PerformQA QABtn exactly -->
    <Style x:Key="PDBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tab button style -->
    <Style x:Key="TabBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Active tab button style -->
    <Style x:Key="TabBtnActiveStyle" TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent"
                    BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section label style -->
    <Style x:Key="SectionLblStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Field label style - matches Program tab field labels (RowLabelStyle): 12px, primary text, normal weight -->
    <Style x:Key="FldLblStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- Rounded checkbox - filled accent box with a check when selected -->
    <Style x:Key="RoundCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                      VerticalAlignment="Center"
                      Background="{DynamicResource InputBgBrush}"
                      BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1">
                <Path x:Name="Tick" Width="10" Height="10" Stretch="Uniform"
                      Stroke="#FFFFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4 12 L9 17 L18 6" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Clear (close) icon button - rounded, transparent at rest with a subtle hover highlight -->
    <Style x:Key="ClearBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderInputBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Add row button -->
    <Style x:Key="AddRowBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReportNavBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid AllowDrop="True"
        Drop="PageGrid_Drop"
        PreviewDragOver="PageGrid_PreviewDragOver">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="8,8,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- Auth/status bar -->
        <RowDefinition Height="8"/>     <!-- gap -->
        <RowDefinition Height="Auto"/>  <!-- Tab strip -->
        <RowDefinition Height="8"/>     <!-- gap -->
        <RowDefinition Height="*"/>     <!-- Tab content -->
      </Grid.RowDefinitions>

      <!-- ═══ AUTH BAR ═══ -->
      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Label - matches PerformQA label style -->
          <TextBlock Grid.Column="0" Text="Intunewin File" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

          <!-- Intunewin file textbox with X clear button -->
          <Grid Grid.Column="2" Margin="0,0,8,0">
            <TextBox x:Name="TxtIntunewinPath"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                     Padding="8,0,28,0"
                     Tag=".intunewin file path…"
                     AllowDrop="True" Drop="IntunewinPath_Drop"
                     PreviewDragOver="PathBox_PreviewDragOver"/>
            <Button Content="✕" Style="{StaticResource ClearBtnStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="22" Height="18" Margin="0,0,4,0"
                    FontSize="10" Cursor="Hand" BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    x:Name="BtnClearPath" Click="BtnClearIntunewinPath_Click" ToolTip="Clear"/>
          </Grid>

          <!-- Browse -->
          <Button x:Name="BtnBrowse" Grid.Column="3" Content="📂 Browse"
                  Style="{StaticResource PDBtn}" Height="28" Width="90"
                  ToolTip="Select intunewin file"
                  Click="BtnBrowseIntunewin_Click"/>

          <!-- Publish -->
          <Button x:Name="BtnPublish" Grid.Column="4"
                  Content="☁ Publish"
                  Style="{StaticResource PDBtn}" Height="28" Width="90" IsEnabled="True"
                  ToolTip="Publish to Intune"
                  Click="BtnPublish_Click"/>

          <!-- Save -->
          <Button x:Name="BtnSave" Grid.Column="5" Content="💾 Save"
                  Style="{StaticResource PDBtn}" Height="28" Width="90"
                  ToolTip="Save JSON file"
                  Click="BtnSave_Click"/>

          <!-- Settings - edits Templates\IntuneSettings.json, same as Create Package /
               Validate Source / Execute Package -->
          <Button x:Name="BtnSettings" Grid.Column="6" Content="⚙ Settings"
                  Style="{StaticResource PDBtn}" Height="28" Width="90"
                  ToolTip="Edit IntuneSettings.json defaults"
                  Click="BtnSettings_Click"/>

          <!-- New -->
          <Button x:Name="BtnNew" Grid.Column="7" Content="🆕 New"
                  Style="{StaticResource PDBtn}" Height="28" Width="90" Margin="0"
                  ToolTip="Start a new app (clear fields)"
                  Click="BtnClear_Click"/>

          <!-- Hidden controls kept for code-behind compatibility -->
          <StackPanel x:Name="PanelTenantInfo" Visibility="Collapsed">
            <TextBlock x:Name="TxtTenantName"/>
          </StackPanel>
          <TextBlock x:Name="TxtAuthStatus" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtAuthSub"    Visibility="Collapsed"/>
          <Button x:Name="BtnSignIn" Visibility="Collapsed" Click="BtnSignIn_Click"/>
        </Grid>
      </Border>

      <!-- ══ PROGRESS BAR - overlaid on bottom edge of toolbar, zero extra height ══ -->
      <ProgressBar x:Name="PrgPublishProgress"
                   Grid.Row="0"
                   Height="3" Minimum="0" Maximum="100" Value="0"
                   IsIndeterminate="True"
                   VerticalAlignment="Bottom"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource AccentBlueBrush}"/>

      <!-- ═══ TAB STRIP ═══ -->
      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="6,3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Tabs. Same markup as the Auto Package sub-nav (Download / Package / Execute / ...):
               a Border "indicator" that carries the active pill fill, wrapping a transparent Button
               that carries the icon + label. Active = AccentBlueBrush fill + white text; inactive =
               transparent + TextSecondaryBrush. Driven from ShowTab(). -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Resources>
              <!-- Tab-strip buttons: rounded hover highlight, no focus rectangle or selected overlay
                   (so the active tab's text stays fully visible in both themes). -->
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#334F8EF7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#4D4F8EF7"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </StackPanel.Resources>

            <Border x:Name="Tab1Indicator" Padding="10,0" Background="{DynamicResource AccentBlueBrush}" CornerRadius="6">
              <Button x:Name="BtnTab1" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="ℹ" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="App Info" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab2Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab2" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⚙" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Program" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab3Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab3" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🖥" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Requirements" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab4Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab4" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Detection" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab5Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab5" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🔗" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Dependencies" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab6Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab6" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⬆" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Supersedence" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab7Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab7" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="👥" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Assignments" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab8Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab8" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="📊" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Reports" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>

            <Border x:Name="Tab9Indicator" Padding="10,0" Background="Transparent" CornerRadius="6">
              <Button x:Name="BtnTab9" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Tab_Click" Tag="9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Log" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══ TAB CONTENT AREA ═══ -->
      <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>

            <!-- ══ TAB 1: APP INFORMATION ══ -->
            <StackPanel x:Name="Tab1" Visibility="Visible" Margin="14,10,14,10">

              <!-- App information laid out as label (left) + control (right) -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="460"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>  <!-- Name -->
                  <RowDefinition Height="Auto"/>  <!-- Description -->
                  <RowDefinition Height="Auto"/>  <!-- Publisher -->
                  <RowDefinition Height="Auto"/>  <!-- App version -->
                  <RowDefinition Height="Auto"/>  <!-- Category -->
                  <RowDefinition Height="Auto"/>  <!-- Featured app -->
                  <RowDefinition Height="Auto"/>  <!-- Information URL -->
                  <RowDefinition Height="Auto"/>  <!-- Privacy URL -->
                  <RowDefinition Height="Auto"/>  <!-- Developer -->
                  <RowDefinition Height="Auto"/>  <!-- Owner -->
                  <RowDefinition Height="Auto"/>  <!-- Notes -->
                  <RowDefinition Height="Auto"/>  <!-- Logo -->
                </Grid.RowDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8"><Run Text="Name"/><Run Text=" *" Foreground="#F7584F"/></TextBlock>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtAppName" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="Auto-filled from package" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Description -->
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Top" Margin="0,3,12,8"><Run Text="Description"/><Run Text=" *" Foreground="#F7584F"/></TextBlock>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtDescription" Style="{StaticResource MultiLineTextBoxStyle}" Height="105" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" Tag="Enter a description for this application…" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Publisher -->
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8"><Run Text="Publisher"/><Run Text=" *" Foreground="#F7584F"/></TextBlock>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtPublisher" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="Auto-filled from package" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- App version -->
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="App version"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtAppVersion" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="Auto-filled from package" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Category -->
                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Category"/>
                <ComboBox x:Name="CmbCategory" Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="28" FontSize="11" Margin="0,0,0,8">
                  <ComboBoxItem Content="(Not configured)" IsSelected="True"/>
                  <ComboBoxItem Content="Business"/>
                  <ComboBoxItem Content="Computer management"/>
                  <ComboBoxItem Content="Productivity"/>
                  <ComboBoxItem Content="Development tools"/>
                  <ComboBoxItem Content="Data management"/>
                  <ComboBoxItem Content="Utilities"/>
                  <ComboBoxItem Content="Photo &amp; video"/>
                  <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Show this as a featured app -->
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Show this as a featured app"/>
                <ComboBox x:Name="CmbFeatured" Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="28" FontSize="11" Margin="0,0,0,8">
                  <ComboBoxItem Content="No" IsSelected="True"/>
                  <ComboBoxItem Content="Yes"/>
                </ComboBox>

                <!-- Information URL -->
                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Information URL"/>
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtInfoUrl" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="https://…" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Privacy URL -->
                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Privacy URL"/>
                <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtPrivacyUrl" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="https://…" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Developer -->
                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Developer"/>
                <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtDeveloper" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="e.g. Smekal Solutions" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Owner -->
                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Center" Margin="0,0,12,8" Text="Owner"/>
                <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtOwner" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="e.g. IT Department" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Notes -->
                <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FldLblStyle}" VerticalAlignment="Top" Margin="0,3,12,8" Text="Notes"/>
                <Grid Grid.Row="10" Grid.Column="1" Margin="0,0,0,8">
                  <TextBox x:Name="TxtNotes" Style="{StaticResource MultiLineTextBoxStyle}" Height="54" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" Tag="Optional notes about this application…" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>

                <!-- Logo -->
                <StackPanel Grid.Row="11" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,8">
                  <TextBlock Style="{StaticResource FldLblStyle}" Margin="0,0,0,0" Text="Logo"/>
                  <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" Text="PNG or JPG, 512×512 recommended"/>
                </StackPanel>
                <Grid Grid.Row="11" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,8">
                  <TextBox x:Name="TxtIconPath" Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Tag="Path to logo PNG or JPG (optional)…" AllowDrop="True" Drop="IconPath_Drop" PreviewDragOver="PathBox_PreviewDragOver" Padding="8,0,28,0"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="18" Margin="0,4,4,0" FontSize="10" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
                <Button Grid.Row="11" Grid.Column="2" Content="📂 Browse" Style="{StaticResource PDBtn}" Height="28" VerticalAlignment="Top" Margin="8,0,0,8" Click="BtnBrowseIcon_Click"/>

              </Grid>

            </StackPanel>

            <!-- ══ TAB 2: PROGRAM ══ -->
            <StackPanel x:Name="Tab2" Visibility="Collapsed" Margin="16,8,16,8">

              <StackPanel.Resources>
                <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="12"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="MinWidth" Value="240"/>
                  <Setter Property="Margin" Value="0,0,12,0"/>
                </Style>
              </StackPanel.Resources>

              <!-- ── Installer type ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Installer type"/>
                <ComboBox x:Name="CmbInstallerType" Grid.Column="1"
                          Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                  <ComboBoxItem Content="Command line" IsSelected="True"/>
                  <ComboBoxItem Content="PowerShell script"/>
                </ComboBox>
              </Grid>

              <!-- ── Install command ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0" Text="Install command"/>
                  <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <TextBox x:Name="TxtInstallCmd"
                           Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                           Padding="8,0,28,0"
                           Tag="e.g. powershell.exe -ExecutionPolicy Bypass -File Invoke-AppDeployToolkit.ps1 -DeploymentType Install -DeployMode Silent"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </Grid>

              <!-- ── Uninstall type ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Uninstall type"/>
                <ComboBox x:Name="CmbUninstallType" Grid.Column="1"
                          Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                  <ComboBoxItem Content="Command line" IsSelected="True"/>
                  <ComboBoxItem Content="PowerShell script"/>
                  <ComboBoxItem Content="MSI product code"/>
                </ComboBox>
              </Grid>

              <!-- ── Uninstall command ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0" Text="Uninstall command"/>
                  <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <TextBox x:Name="TxtUninstallCmd"
                           Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                           Padding="8,0,28,0"
                           Tag="e.g. powershell.exe -ExecutionPolicy Bypass -File Invoke-AppDeployToolkit.ps1 -DeploymentType Uninstall -DeployMode Silent"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </Grid>

              <!-- ── Installation time required ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Installation time required (mins)"/>
                <Grid Grid.Column="1">
                  <TextBox x:Name="TxtInstallTime"
                           Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                           Padding="8,0,28,0" Text="60" Tag="60"/>
                  <Button Content="✕" Style="{StaticResource ClearBtnStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </Grid>

              <!-- ── Allow available uninstall ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Allow available uninstall"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton x:Name="RbUninstallYes" GroupName="AllowUninstall"
                               Content="Yes" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand" Margin="0,0,24,0"/>
                  <RadioButton x:Name="RbUninstallNo" GroupName="AllowUninstall" IsChecked="True"
                               Content="No" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"/>
                </StackPanel>
              </Grid>

              <!-- ── Install behaviour ── -->
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Install behaviour"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton x:Name="RbInstallSystem" GroupName="InstallBehaviour" IsChecked="True"
                               Content="System" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand" Margin="0,0,24,0"/>
                  <RadioButton x:Name="RbInstallUser" GroupName="InstallBehaviour"
                               Content="User" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"/>
                </StackPanel>
              </Grid>

              <!-- ── Device restart behaviour ── -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Device restart behaviour"/>
                <ComboBox x:Name="CmbRestartBehavior" Grid.Column="1"
                          Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                  <ComboBoxItem Content="Determine behaviour based on return codes" IsSelected="True"/>
                  <ComboBoxItem Content="No specific action"/>
                  <ComboBoxItem Content="App install may force a device restart"/>
                  <ComboBoxItem Content="Intune will force a mandatory device restart"/>
                </ComboBox>
              </Grid>

              <!-- ── Return codes table ── -->
              <TextBlock Style="{StaticResource SectionLblStyle}"
                         Text="SPECIFY RETURN CODES TO INDICATE POST-INSTALLATION BEHAVIOUR"
                         Margin="0,0,0,5"/>

              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                          CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Return code" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="Code type" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <StackPanel x:Name="ReturnCodesPanel" Grid.Row="1" Margin="0,2,0,2"/>
                </Grid>
              </Border>

              <Button Content="➕  Add a return code" Style="{StaticResource AddRowBtnStyle}"
                      HorizontalAlignment="Left" Click="BtnAddReturnCode_Click"/>

            </StackPanel>

            <!-- ══ TAB 3: REQUIREMENTS ══ -->
            <StackPanel x:Name="Tab3" Visibility="Collapsed" Margin="16,8,16,8">

              <StackPanel.Resources>
                <Style x:Key="ReqLabelStyle" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="12"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="Width" Value="260"/>
                  <Setter Property="Margin" Value="0,0,12,0"/>
                </Style>
              </StackPanel.Resources>

              <!-- ── Operating system architecture * (mandatory) ── -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Label with required * -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0"
                             Text="Operating system architecture"/>
                  <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 3 checkboxes: 32-bit, 64-bit (default checked), ARM64 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ChkX86" Style="{StaticResource RoundCheckBoxStyle}" FontSize="11"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Content="32-bit" Margin="0,0,20,0" Cursor="Hand"/>
                  <CheckBox x:Name="ChkX64" Style="{StaticResource RoundCheckBoxStyle}" FontSize="11" IsChecked="True"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Content="64-bit" Margin="0,0,20,0" Cursor="Hand"/>
                  <CheckBox x:Name="ChkArm64" Style="{StaticResource RoundCheckBoxStyle}" FontSize="11"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Content="ARM64" Cursor="Hand"/>
                </StackPanel>
              </Grid>

              <!-- ── Minimum operating system * (mandatory) ── -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Label with required * -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0"
                             Text="Minimum operating system"/>
                  <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox x:Name="CmbMinOs" Grid.Column="1"
                          Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                  <ComboBoxItem Content="Windows 10 1607"/>
                  <ComboBoxItem Content="Windows 10 1703"/>
                  <ComboBoxItem Content="Windows 10 1709"/>
                  <ComboBoxItem Content="Windows 10 1803"/>
                  <ComboBoxItem Content="Windows 10 1809"/>
                  <ComboBoxItem Content="Windows 10 1903"/>
                  <ComboBoxItem Content="Windows 10 1909"/>
                  <ComboBoxItem Content="Windows 10 2004"/>
                  <ComboBoxItem Content="Windows 10 20H2"/>
                  <ComboBoxItem Content="Windows 10 21H1"/>
                  <ComboBoxItem Content="Windows 10 21H2" IsSelected="True"/>
                  <ComboBoxItem Content="Windows 10 22H2"/>
                  <ComboBoxItem Content="Windows 11 21H2"/>
                  <ComboBoxItem Content="Windows 11 22H2"/>
                  <ComboBoxItem Content="Windows 11 23H2"/>
                  <ComboBoxItem Content="Windows 11 24H2"/>
                </ComboBox>
              </Grid>

            </StackPanel>

            <!-- ══ TAB 4: DETECTION RULES ══ -->
            <StackPanel x:Name="Tab4" Visibility="Collapsed" Margin="16,10,16,10"
                        Background="Transparent">

              <!-- Rules format selector - label + radio buttons on same line -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource SectionLblStyle}" Text="RULES FORMAT"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <RadioButton x:Name="RbDetectRules" GroupName="DetectMethod" IsChecked="True"
                             Content="Manually configure detection rules" FontSize="11"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,28,0" Cursor="Hand"
                             Checked="DetectMethod_Changed"/>
                <RadioButton x:Name="RbDetectScript" GroupName="DetectMethod"
                             Content="Use a custom detection script" FontSize="11"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Cursor="Hand" Checked="DetectMethod_Changed"/>
              </StackPanel>

              <!-- ── PANEL A: Manually configure ── -->
              <StackPanel x:Name="PanelDetectRules">

                <!-- Rules table -->
                <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBgBrush}"
                        CornerRadius="6" Margin="0,0,0,6">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="26"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header row -->
                    <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                            CornerRadius="6,6,0,0"
                            BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                      <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rule type" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Details" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <!-- Dynamic rows: MSI / File / Registry cards (always shown, toggled via checkbox) -->
                    <StackPanel x:Name="DetectionRulesList" Grid.Row="1" Margin="8,8,8,0"
                                Background="Transparent"/>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- ── PANEL B: Custom detection script ── -->
              <StackPanel x:Name="PanelDetectScript" Visibility="Collapsed" Margin="0,0,0,0">

                <!-- Script file browse -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0" Text="Script file"/>
                    <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Grid>
              <TextBox x:Name="TxtDetectScriptPath" Grid.Column="1"
                           Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                           Tag="Browse for .ps1 detection script…"
                           Margin="0,0,6,0" IsReadOnly="True" Padding="8,0,28,0"/>
              <Button Content="✕" Style="{StaticResource ClearBtnStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="22" Height="18" Margin="0,4,4,0"
                      FontSize="10" Cursor="Hand" BorderThickness="0"
                      Background="Transparent"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Click="FieldClear_PD_Click" ToolTip="Clear"/>
            </Grid>
                  <Button Grid.Column="2" Content="📂 Browse"
                          Style="{StaticResource PDBtn}" Height="28"
                          Click="BtnBrowseDetectScript_Click"/>
                </Grid>

                <!-- Run as 32-bit -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Text="Run script as 32-bit process on 64-bit clients"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbScript32No" GroupName="ScriptBitness" IsChecked="True"
                                 Content="No (default)" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Cursor="Hand" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RbScript32Yes" GroupName="ScriptBitness"
                                 Content="Yes" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Cursor="Hand"/>
                  </StackPanel>
                </Grid>

                <!-- Enforce signature check -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Text="Enforce script signature check"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbSigNo" GroupName="ScriptSig" IsChecked="True"
                                 Content="No (default)" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Cursor="Hand" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RbSigYes" GroupName="ScriptSig"
                                 Content="Yes" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Cursor="Hand"/>
                  </StackPanel>
                </Grid>

              </StackPanel>

            </StackPanel>

            <!-- ══ TAB 5: DEPENDENCIES ══ -->
            <StackPanel x:Name="Tab5" Visibility="Collapsed" Margin="16,8,16,8">

              <TextBlock Style="{StaticResource SectionLblStyle}" Text="APP DEPENDENCIES" Margin="0,0,0,4"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         Text="Apps listed here must be installed before this app. Maximum 100 dependencies (including sub-dependencies)."/>

              <!-- Dependencies table -->
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Column headers -->
                  <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                          CornerRadius="6,6,0,0"
                          BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="App name" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="Automatically install" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <!-- Rows -->
                  <StackPanel x:Name="DependenciesList" Grid.Row="1" Margin="0,3,0,3">
                    <TextBlock Text="No dependencies added." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,7"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Button Content="➕  Add" Style="{StaticResource AddRowBtnStyle}"
                      HorizontalAlignment="Left" Click="BtnAddDependency_Click"/>

            </StackPanel>

            <!-- ══ TAB 6: SUPERSEDENCE ══ -->
            <StackPanel x:Name="Tab6" Visibility="Collapsed" Margin="16,8,16,8">

              <TextBlock Style="{StaticResource SectionLblStyle}" Text="SUPERSEDENCE" Margin="0,0,0,4"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         Text="This app will update or replace the apps listed below. Maximum 10 superseded apps. Setting 'Uninstall previous version' to Yes = Replace. No = Update."/>

              <!-- Supersedence table -->
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Column headers -->
                  <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                          CornerRadius="6,6,0,0"
                          BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="App name" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="Uninstall previous version" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <!-- Rows -->
                  <StackPanel x:Name="SupersedenceList" Grid.Row="1" Margin="0,3,0,3">
                    <TextBlock Text="No superseded apps added." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,7"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Button Content="➕  Add" Style="{StaticResource AddRowBtnStyle}"
                      HorizontalAlignment="Left" Click="BtnAddSupersedence_Click"/>

            </StackPanel>

            <!-- ══ TAB 7: ASSIGNMENTS ══ -->
            <StackPanel x:Name="Tab7" Visibility="Collapsed" Margin="16,8,16,8">

              <StackPanel.Resources>
                <Style x:Key="AssignLblStyle" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
              </StackPanel.Resources>

              <!-- ── AVAILABLE FOR ENROLLED DEVICES ── -->
              <TextBlock Style="{StaticResource SectionLblStyle}" Text="AVAILABLE FOR ENROLLED DEVICES" Margin="0,0,0,2"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="App appears in Company Portal. Users choose to install it."/>
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,0,0,4">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                          CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="8,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="24"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Group"                      Style="{StaticResource AssignLblStyle}"/>
                      <TextBlock Grid.Column="1" Text="Mode"                       Style="{StaticResource AssignLblStyle}"/>
                      <TextBlock Grid.Column="2" Text="End user notifications"     Style="{StaticResource AssignLblStyle}"/>
                      <TextBlock Grid.Column="3" Text="Availability"               Style="{StaticResource AssignLblStyle}"/>
                      <TextBlock Grid.Column="4" Text="Installation deadline"      Style="{StaticResource AssignLblStyle}"/>
                      <TextBlock Grid.Column="5" Text="Delivery optimization"      Style="{StaticResource AssignLblStyle}"/>
                    </Grid>
                  </Border>
                  <StackPanel x:Name="AvailableList" Grid.Row="1" Margin="0,3,0,3">
                    <TextBlock Text="No groups added." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,6"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="➕  Add group"       Style="{StaticResource AddRowBtnStyle}" Margin="0,0,8,0" Click="BtnAddAvailable_Click"         Tag="Available"/>
              </StackPanel>
            </StackPanel>

            <!-- ══ TAB 8: REPORTS ══ -->
            <StackPanel x:Name="Tab8" Visibility="Collapsed" Margin="16,8,16,8">

              <TextBlock Style="{StaticResource SectionLblStyle}" Text="APP INSTALL STATUS" Margin="0,0,0,4"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                         TextWrapping="Wrap"
                         Text="View per-device or per-user install status for a published app (installed, failed, pending, not installed). Requires sign in."/>

              <!-- Actions -->
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Button x:Name="BtnSearchApp" Content="🔍  Search app"
                          Style="{StaticResource AddRowBtnStyle}" Click="BtnSearchApp_Click"/>
                  <Button x:Name="BtnDeviceReport" Content="🖥  Device install status" Margin="8,0,0,0"
                          Style="{StaticResource AddRowBtnStyle}" Click="BtnDeviceReport_Click"/>
                  <Button x:Name="BtnUserReport" Content="👤  User install status" Margin="8,0,0,0"
                          Style="{StaticResource AddRowBtnStyle}" Click="BtnUserReport_Click"/>
                  <Button x:Name="BtnExportReport" Content="⬇  Export (xlsx)" Margin="8,0,0,0"
                          Style="{StaticResource AddRowBtnStyle}" Click="BtnExportReport_Click"/>
                  <Button x:Name="BtnRefreshReport" Content="🔄  Refresh" Margin="8,0,0,0"
                          Style="{StaticResource AddRowBtnStyle}" Click="BtnRefreshReport_Click"/>
                </StackPanel>

                <!-- Find in results: previous | search box (icon + counter) | next -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnReportSearchPrev" Style="{StaticResource ReportNavBtnStyle}"
                          ToolTip="Previous match" Click="BtnReportSearchPrev_Click">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M15 6 L9 12 L15 18"/>
                  </Button>

                  <Border Width="230" Height="30" Margin="6,0,6,0" CornerRadius="6"
                          Background="{DynamicResource InputBgBrush}"
                          BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Path Grid.Column="0" Width="13" Height="13" Margin="8,0,5,0" VerticalAlignment="Center"
                            Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                            Data="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/>
                      <Grid Grid.Column="1">
                        <TextBlock x:Name="TxtReportSearchHint" Text="Find in results"
                                   VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtReportSearch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" FontSize="11" Padding="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,0,4,0" TextChanged="TxtReportSearch_TextChanged" KeyDown="TxtReportSearch_KeyDown"/>
                      </Grid>
                      <TextBlock x:Name="TxtReportSearchCount" Grid.Column="2" VerticalAlignment="Center"
                                 Margin="4,0,8,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                  </Border>

                  <Button x:Name="BtnReportSearchNext" Style="{StaticResource ReportNavBtnStyle}"
                          ToolTip="Next match" Click="BtnReportSearchNext_Click">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M9 6 L15 12 L9 18"/>
                  </Button>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="TxtReportSummary" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,8"
                         TextWrapping="Wrap" Visibility="Collapsed"/>

              <!-- Results table (header + rows built dynamically per report) -->
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,0,0,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                  <StackPanel x:Name="ReportRowsPanel">
                    <TextBlock Text="No report loaded. Choose Device install status or User install status."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,10,12,10"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>

            </StackPanel>

            <!-- ══ TAB 9: LOG ══ -->
            <StackPanel x:Name="Tab9" Visibility="Collapsed" Margin="16,8,16,8">
              <Border Background="#FF1E1E1E" CornerRadius="4" MinHeight="420">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas, Courier New"
                         FontSize="11"
                         Foreground="#FFCCCCCC"
                         Padding="12,10,12,10"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MinHeight="420"/>
              </Border>
            </StackPanel>

          </Grid>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</Page>
