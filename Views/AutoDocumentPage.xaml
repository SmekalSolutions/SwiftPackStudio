<Page x:Class="SwiftPack.Views.AutoDocumentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}">

  <Page.Resources>
    <!-- Read-only value box (selectable so the user can copy) -->
    <Style x:Key="DocValue" TargetType="TextBox">
      <Setter Property="IsReadOnly"      Value="True"/>
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="8,0"/>
      <Setter Property="MinHeight"       Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="TextWrapping"    Value="NoWrap"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DocLabel" TargetType="TextBlock">
      <Setter Property="FontSize"          Value="11"/>
      <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DocSection" TargetType="TextBlock">
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin"     Value="0,0,0,8"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══ DOCUMENT DETAILS CARD ══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="6,6,6,6" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- header -->
          <RowDefinition Height="*"/>      <!-- scrollable content -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource NavBarBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0" Height="34" Padding="12,0">
          <Grid>
            <TextBlock Text="📄  DOCUMENT" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtDocStatus" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
          <StackPanel>

            <!-- ════ PACKAGE DETAILS ════ -->
            <TextBlock Text="Package Details" Style="{StaticResource DocSection}"/>
            <Grid x:Name="PkgGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Package Name:"    Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="0" Grid.Column="2" x:Name="DocPkgName"        Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name:"     Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="1" Grid.Column="2" x:Name="DocDisplayName"    Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher:"        Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="2" Grid.Column="2" x:Name="DocPkgPublisher"   Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Version:"          Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="3" Grid.Column="2" x:Name="DocPkgVersion"     Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Source Location:"  Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="4" Grid.Column="2" x:Name="DocSourceLocation" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Text="Package Location:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="5" Grid.Column="2" x:Name="DocPackageLocation" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Text="Install Location:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="6" Grid.Column="2" x:Name="DocInstallLocation" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="7" Grid.Column="0" Text="Install log path:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="7" Grid.Column="2" x:Name="DocInstallLog"      Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="8" Grid.Column="0" Text="Uninstall log path:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="8" Grid.Column="2" x:Name="DocUninstallLog"    Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
            </Grid>

            <!-- ════ INTUNE DETAILS ════ -->
            <TextBlock Text="Intune Details" Style="{StaticResource DocSection}" Margin="0,14,0,8"/>
            <Grid x:Name="IntuneGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"  Grid.Column="0" Text="Name:"             Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="0"  Grid.Column="2" x:Name="DocIntuneName"      Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1"  Grid.Column="0" Text="Publisher:"        Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="1"  Grid.Column="2" x:Name="DocIntunePublisher" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="2"  Grid.Column="0" Text="Description:"      Style="{StaticResource DocLabel}" Margin="0,0,0,6" VerticalAlignment="Top"/>
              <TextBox   Grid.Row="2"  Grid.Column="2" x:Name="DocIntuneDescription" Style="{StaticResource DocValue}" Margin="0,0,0,6"
                         Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"/>
              <TextBlock Grid.Row="3"  Grid.Column="0" Text="Category:"         Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="3"  Grid.Column="2" x:Name="DocIntuneCategory"  Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="4"  Grid.Column="0" Text="Install command:"  Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="4"  Grid.Column="2" x:Name="DocInstallCommand"  Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="5"  Grid.Column="0" Text="Uninstall command:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="5"  Grid.Column="2" x:Name="DocUninstallCommand" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="6"  Grid.Column="0" Text="Install Behaviour:" Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="6"  Grid.Column="2" x:Name="DocInstallBehavior" Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="7"  Grid.Column="0" Text="Detection Rule:"   Style="{StaticResource DocLabel}" Margin="0,0,0,6" VerticalAlignment="Top"/>
              <TextBox   Grid.Row="7"  Grid.Column="2" x:Name="DocDetectionRule"   Style="{StaticResource DocValue}" Margin="0,0,0,6"
                         MinHeight="56" MaxHeight="320" Padding="8,6"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New, monospace"/>
              <TextBlock Grid.Row="8"  Grid.Column="0" Text="Dependencies:"     Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="8"  Grid.Column="2" x:Name="DocDependencies"    Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="9"  Grid.Column="0" Text="Supersedence:"     Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="9"  Grid.Column="2" x:Name="DocSupersedence"    Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="10" Grid.Column="0" Text="Assignments:"      Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="10" Grid.Column="2" x:Name="DocAssignments"     Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="11" Grid.Column="0" Text="App Owner email:"  Style="{StaticResource DocLabel}" Margin="0,0,0,6"/>
              <TextBox   Grid.Row="11" Grid.Column="2" x:Name="DocAppOwnerEmail"   Style="{StaticResource DocValue}" Margin="0,0,0,6"/>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Page>
