              </ListView.View>
            </ListView>

            <!-- Process tab: every process started while the source ran. Fed by a 200ms poller,
                 not a start/end diff - installer custom actions exit too fast for that. -->
            <ListView x:Name="LvProcess" FontSize="11" Visibility="Collapsed"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      MouseRightButtonUp="LvProcess_MouseRightButtonUp">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <!-- No include checkbox: the Process tab is a record of what ran, not a set of
                       things that can be put into a package. -->
                  <GridViewColumn Header="Process" Width="220" DisplayMemberBinding="{Binding DisplayPath}"/>
                  <GridViewColumn Header="PID"     Width="80"  DisplayMemberBinding="{Binding Value}"/>
                  <GridViewColumn x:Name="ColProcStarted" Header="Started" Width="100" DisplayMemberBinding="{Binding Data}"/>
                  <GridViewColumn Header="Path"    Width="420" DisplayMemberBinding="{Binding DataType}"/>
                  <GridViewColumn x:Name="ColProcCmdLine" Header="Command Line" Width="480"
                                  DisplayMemberBinding="{Binding CommandLine}"/>
                </GridView>
              </ListView.View>
            </ListView>

            <!-- Installed Apps tab: Add/Remove Programs entries created while the source ran.
                 One source often registers several, so every new entry gets its own row. -->
            <ListView x:Name="LvApps" FontSize="11" Visibility="Collapsed"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <!-- View only, like Process: an installed application is evidence of what the
                       source did, not something to select into a package. -->
                  <GridViewColumn Header="Application" Width="300" DisplayMemberBinding="{Binding DisplayPath}"/>
                  <GridViewColumn Header="Publisher"   Width="200" DisplayMemberBinding="{Binding Value}"/>
                  <GridViewColumn x:Name="ColAppVersion" Header="Version" Width="120" DisplayMemberBinding="{Binding Data}"/>
                  <GridViewColumn Header="Scope"        Width="150" DisplayMemberBinding="{Binding DataType}"/>
                  <GridViewColumn Header="Registry Key" Width="480" DisplayMemberBinding="{Binding SourceOnDisk}"/>
                </GridView>
              </ListView.View>
            </ListView>

            <!-- Temp tab: %TEMP% items the installer wrote and then usually deleted.
                 VIEW ONLY. These items are excluded by ValidateSource.json and never enter
                 _allItems, so they cannot be included, saved to .svr or packaged into the MSI.
                 Deliberately has NO checkbox column - there is nothing to include. -->
            <ListView x:Name="LvTemp" FontSize="11" Visibility="Collapsed"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ColTempPath" Header="Path" Width="560" DisplayMemberBinding="{Binding DisplayPath}"/>
                  <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding FileType}"/>
                  <GridViewColumn Header="Size" Width="90"  DisplayMemberBinding="{Binding FileSize}"/>
                  <GridViewColumn Header="Date modified" Width="140" DisplayMemberBinding="{Binding FileDate}"/>
                </GridView>
              </ListView.View>
            </ListView>

            <!-- Event Monitor tab: Windows Application-log entries written while the source ran.
                 VIEW ONLY. Bound to EventLogRow, not SnapItem, so these rows are structurally
                 incapable of being included, saved to .svr or packaged. No checkbox column. -->
            <ListView x:Name="LvEvents" FontSize="11" Visibility="Collapsed"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <!-- Stretch so the row fills the ListView, and top-align so a wrapped Message
                       keeps its first line level with the other cells instead of centring. -->
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="ToolTip" Value="{Binding Message}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                                VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Level"         Width="80"  DisplayMemberBinding="{Binding Level}"/>
                  <GridViewColumn Header="Date and Time" Width="140" DisplayMemberBinding="{Binding Logged}"/>
                  <GridViewColumn Header="Source"        Width="200" DisplayMemberBinding="{Binding Source}"/>
                  <GridViewColumn Header="Event ID"      Width="70"  DisplayMemberBinding="{Binding EventId}"/>
                  <!-- Width is set in code by FitTabColumns: it absorbs whatever the other columns
                       leave over. Cannot be done with a binding - GridViewColumn derives from
                       DependencyObject, not FrameworkElement, so it is not in the visual tree. -->
                  <GridViewColumn x:Name="ColEvtMessage" Header="Message" Width="500">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   Margin="0,1,4,1"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>

          </Grid>

          </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <!-- Hidden element — keeps TxtFooterStatus code-behind reference valid -->
    <TextBlock x:Name="TxtFooterStatus" Visibility="Collapsed"/>
  </Grid>
</Page>