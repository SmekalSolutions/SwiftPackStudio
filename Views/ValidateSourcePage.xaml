<Page x:Class="SwiftPack.Views.ValidateSourcePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SwiftPack.Views"
      Background="{DynamicResource PageBgBrush}"
      AllowDrop="True"
      Unloaded="ValidateSourcePage_Unloaded"
      DragOver="Page_DragOver"
      Drop="Page_Drop">

  <Page.Resources>
    <!-- Fix ScrollViewer track-click scrolling for ListView and TreeView -->
    <Style TargetType="ScrollBar">
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="MinHeight" Value="12"/>
    </Style>

    <!-- Left-align all GridView column headers (Files, Registry, Environment, Firewall, etc.) -->
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="6,0,0,0"/>
      <!-- One EventSetter here makes every column header on the page sortable. The handler works
           out the sort key from the column's own DisplayMemberBinding, so no column declares
           anything, and template columns (checkbox, Open icon) are ignored automatically. -->
      <EventSetter Event="Click" Handler="GridHeader_Click"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <!-- GridView always appends a filler header to the right of the last real column
             (Role="Padding"). It is not a column anyone declared - it is what showed up as an
             empty column on every tab. Collapse it. Applies to every ListView on the page. -->
        <Trigger Property="Role" Value="Padding">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Converters for Open column icon visibility -->
    <local:NullToVisibilityConverter  x:Key="NullToVisibilityConverter"/>
    <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>

    <!-- ══ SVBtn — matches PerformQA QABtn exactly ══ -->
    <Style x:Key="SVBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="MinWidth"        Value="82"/>
      <Setter Property="Padding"         Value="10,0"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Horizontal tab button — rounded pill on active -->
    <Style x:Key="TabBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <!-- Horizontal padding was 14. Fifteen buttons carry it whether their label is "ODBC" or
           "Certificates", so at 14 it contributed 420 units to the strip, about a third of the whole
           width, and no amount of renaming could touch it. At 10 it contributes 300, freeing 120 -
           comfortably more than the strip was overflowing by at 150%. Vertical stays 6. -->
      <Setter Property="Padding" Value="10,6"/>
      <!-- Vertical margin only, so the two rows the strip wraps onto at 150% and above do not touch.
           A row is about 30 units tall plus this 2, which still sits inside the bar's MinHeight of
           34, so the single-row case is pixel identical to before. -->
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InputBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabBtnActiveStyle" TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
      <!-- Was a hardcoded #1565C0. That was the only place in the app using it: the Auto Package
           sub-nav and the Publish Package tab strip both fill from AccentBlueBrush, and the top nav
           pill now does too, so this tab strip was the odd one out. It was also fixed across both
           themes, which meant that in dark mode the selected tab stayed a muddy navy while every
           other selected surface lightened to #4F8EF7. -->
      <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <!-- Own template: the base template's hover trigger repaints the background
           with the light InputBgBrush, which on the active tab left white text on a
           light fill (unreadable). Here the active tab stays blue on hover (a slightly
           lighter blue for feedback) so the white label is always visible. -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBlueHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Expander toggle — must be defined BEFORE TreeViewItem style (StaticResource forward ref) -->
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="16" Height="16" Padding="1">
              <Path x:Name="ExpandPath" Fill="Transparent"
                    Stroke="{DynamicResource TextMutedBrush}"
                    StrokeThickness="1.2"
                    Data="M 6 4 L 10 8 L 6 12"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ExpandPath" Property="Data" Value="M 4 6 L 8 10 L 12 6"/>
                <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="ExpandPath" Property="Data" Value="M 6 4 L 10 8 L 6 12"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tree item style — keeps blue selection when focus moves to context menu -->
    <Style TargetType="TreeViewItem">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Expand/collapse toggle -->
              <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource ExpandCollapseToggleStyle}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>

              <!-- Row background — stays blue whether focused or not -->
              <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter x:Name="PART_Header"
                                  ContentSource="Header"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>

              <!-- Children -->
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"
                              Visibility="Collapsed"/>
            </Grid>

            <ControlTemplate.Triggers>
              <!-- Expand children when IsExpanded = true -->
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
              </Trigger>
              <!-- Hide expander when no children -->
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>

              <!-- Selected + focused: standard blue -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsSelectionActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#3390C5"/>
                <Setter Property="Foreground" Value="White"/>
              </MultiTrigger>

              <!-- Selected + NOT focused: same blue (not grey) -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#3390C5"/>
                <Setter Property="Foreground" Value="White"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ Rounded ComboBox — fully rounded corners (matches input boxes) ══ -->
    <ControlTemplate x:Key="RoundedComboToggle" TargetType="ToggleButton">
      <Border x:Name="tbd"
              Background="{DynamicResource InputBgBrush}"
              BorderBrush="{DynamicResource BorderInputBrush}"
              BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
          </Grid.ColumnDefinitions>
          <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0 0 L 4 4 L 8 0 Z"
                Fill="{DynamicResource TextMutedBrush}"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="tbd" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RoundedCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Template="{StaticResource RoundedComboToggle}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,24,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="Popup" Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Slide">
                <Border x:Name="DropDownBorder"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource BorderInputBrush}"
                        BorderThickness="1" CornerRadius="6"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- toolbar -->
      <RowDefinition Height="Auto"/>   <!-- status bar -->
      <RowDefinition Height="Auto"/>   <!-- tab bar -->
      <RowDefinition Height="*"/>      <!-- content -->
    </Grid.RowDefinitions>

    <!-- ── TOOLBAR ─────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}"
            Margin="8,8,8,8" Padding="14,10">
      <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>  <!-- "Source File" label -->
          <ColumnDefinition Width="*"/>     <!-- textbox fills remaining space -->
          <ColumnDefinition Width="Auto"/>  <!-- right button strip -->
        </Grid.ColumnDefinitions>

        <!-- Label — matches PerformQA "Log File" label -->
        <TextBlock Grid.Column="0" Text="Source Path" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>

        <!-- Source file textbox. Fills the remaining width (Grid.Column 1, Width=*).
             A separate Browse button follows it (no embedded icon inside the box). -->
        <Border Grid.Column="1"
                Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1"
                CornerRadius="6" Height="28"
                VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBox x:Name="TxtSourceFile"
                   Background="Transparent" BorderThickness="0"
                   FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                   TextChanged="TxtSourceFile_TextChanged"
                   Tag="Browse or drag and drop a source file (.exe, .msi, .bat, .ps1)…"
                   ToolTip="Browse to .exe or Invoke-AppDeployToolkit.ps1"/>
        </Border>

        <!-- Right button strip — all SVBtn (=QABtn), equal width 82, height 28, gap 6 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

          <Button x:Name="BtnBrowseSource" Style="{StaticResource SVBtn}"
                  Content="📂 Browse"
                  ToolTip="Select source file"
                  Click="BtnBrowseSource_Click"/>

          <Button x:Name="BtnExecute" Content="▶  Execute"
                  ToolTip="Install source"
                  Background="{DynamicResource InputBgBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderInputBrush}"
                  BorderThickness="1" Height="28" Width="82"
                  FontSize="11" Margin="0,0,6,0" Cursor="Hand"
                  Click="BtnExecute_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Stop occupies the SAME slot as Execute: they swap visibility, so nothing shifts -->
          <Button x:Name="BtnStop" Style="{StaticResource SVBtn}" Content="■ Stop"
                  Visibility="Collapsed" Click="BtnStop_Click"/>

          <!-- Certificate target store — shown only for .cer/.crt sources. Auto = detect from the
               certificate (code-signing -> TrustedPublisher, CA -> Root). -->
          <ComboBox x:Name="CmbCertStore" Style="{StaticResource RoundedCombo}"
                    Width="148" Height="28" Margin="0,0,6,0" VerticalAlignment="Center"
                    Visibility="Collapsed" SelectedIndex="0"
                    ToolTip="Certificate store for .cer/.crt import (Auto detects from the certificate)">
            <ComboBoxItem Content="Auto"/>
            <ComboBoxItem Content="Root"/>
            <ComboBoxItem Content="TrustedPublisher"/>
            <ComboBoxItem Content="CA"/>
            <ComboBoxItem Content="My"/>
          </ComboBox>

          <!-- Run context: Administrator (default, elevated user) or System (via PsExec -s) -->
          <ComboBox x:Name="CmbRunContext" Style="{StaticResource RoundedCombo}"
                    Width="118" Height="28" Margin="0,0,6,0" VerticalAlignment="Center"
                    ToolTip="Run context for Execute: Administrator (elevated) or System (PsExec -s)"
                    SelectedIndex="0">
            <ComboBoxItem Content="Administrator"/>
            <ComboBoxItem Content="System Context"/>
          </ComboBox>

          <!-- Search: ◀ [🔍 query … count] ▶ — same as PerformQA -->
          <Button x:Name="BtnSearchPrev" Style="{StaticResource SVBtn}"
                  Content="◀" Width="28" Margin="0,0,0,0"
                  ToolTip="Previous match" Click="BtnSearchPrev_Click"/>

          <Border Background="{DynamicResource InputBgBrush}"
                  BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1"
                  CornerRadius="6" Height="28" Width="160"
                  VerticalAlignment="Center" Margin="0,0,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="🔍" FontSize="11"
                         VerticalAlignment="Center" Margin="6,0,4,0"
                         Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBox x:Name="TxtSearch" Grid.Column="1"
                       Background="Transparent" BorderThickness="0"
                       FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       CaretBrush="{DynamicResource TextPrimaryBrush}"
                       TextChanged="TxtSearch_TextChanged"
                       ToolTip="Search in current tab"/>
              <!-- Grey placeholder shown only while the search box is empty -->
              <TextBlock Grid.Column="1" Text="Search items" FontSize="11"
                         IsHitTestVisible="False" VerticalAlignment="Center"
                         Margin="2,0,0,0"
                         Foreground="{DynamicResource TextMutedBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock x:Name="TxtSearchCount" Grid.Column="2"
                         FontSize="10" MinWidth="24"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" Margin="2,0,4,0"/>
              <Button x:Name="BtnClearSearch" Grid.Column="3"
                      Content="✕" FontSize="10" Cursor="Hand"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextMutedBrush}"
                      Padding="4,0" Click="BtnClearSearch_Click"/>
            </Grid>
          </Border>

          <Button x:Name="BtnSearchNext" Style="{StaticResource SVBtn}"
                  Content="▶" Width="28" Margin="0"
                  ToolTip="Next match" Click="BtnSearchNext_Click"/>

        </StackPanel>
      </Grid>

      <!-- Second toolbar row: qasnap actions -->
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="BtnCreateQasnap" Style="{StaticResource SVBtn}"
                Content="📸 Create SVR"
                ToolTip="Save the current capture as a .svr (no MSI). Asks for App Name/Vendor/Version."
                IsEnabled="False"
                Click="BtnCreateQasnap_Click"/>
        <Button x:Name="BtnCreateMsi" Style="{StaticResource SVBtn}" Content="📦 Create MSI"
                ToolTip="Build an .msi installer from the included items"
                IsEnabled="False"
                Click="BtnCreateMsi_Click"/>
        <Button x:Name="BtnSaveQasnap" Style="{StaticResource SVBtn}"
                Content="💾 Save"
                ToolTip="Save changes to the current .svr"
                IsEnabled="False"
                Click="BtnSaveQasnap_Click"/>

        <Button x:Name="BtnImport" Style="{StaticResource SVBtn}" Content="📂 Import"
                ToolTip="Open a .svr file to edit and rebuild"
                Click="BtnImport_Click"/>

        <Button x:Name="BtnAdd" Style="{StaticResource SVBtn}" Content="➕ Add ▾"
                ToolTip="Add a file, folder, or registry value to the capture"
                Click="BtnAdd_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📄  Add File…"     Click="BtnAddFile_Click"/>
              <MenuItem Header="📁  Add Folder…"   Click="BtnAddFolder_Click"/>
              <MenuItem Header="🗝  Add Registry…" Click="BtnAddRegistry_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <!-- Item actions moved here from the first row: Include / Exclude / Expand / Collapse / Clear -->
        <Border Width="1" Background="{DynamicResource BorderInputBrush}"
                Margin="6,2,6,2" VerticalAlignment="Stretch"/>

        <Button x:Name="BtnIncludeAll" Style="{StaticResource SVBtn}" Content="✓ Include"
                ToolTip="Include selected items"
                Click="BtnIncludeAll_Click"/>

        <Button x:Name="BtnExcludeAll" Style="{StaticResource SVBtn}" Content="✕ Exclude"
                ToolTip="Exclude selected items"
                Click="BtnExcludeAll_Click"/>

        <Button x:Name="BtnExpandNode" Style="{StaticResource SVBtn}" Content="▼ Expand"
                ToolTip="Expand selected items"
                Click="BtnExpandNode_Click"/>

        <Button x:Name="BtnCollapseNode" Style="{StaticResource SVBtn}" Content="▲ Collapse"
                ToolTip="Collapse selected items"
                Click="BtnCollapseNode_Click"/>

        <Button x:Name="BtnClearAll" Style="{StaticResource SVBtn}" Content="🆕 New"
                ToolTip="Start a new capture (clears all fields)"
                Click="BtnClearAll_Click"/>

        <Button x:Name="BtnSettings" Style="{StaticResource SVBtn}" Content="⚙ Settings"
                ToolTip="Edit ValidateSource.json (SVR output folder and capture exclusions)"
                Click="BtnSettings_Click"/>
      </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ PROGRESS BAR — overlaid on bottom edge of toolbar, zero extra height ══ -->
    <ProgressBar x:Name="PrgExecuteProgress"
                 Grid.Row="0"
                 Height="3"
                 Minimum="0" Maximum="100" Value="0"
                 IsIndeterminate="True"
                 VerticalAlignment="Bottom"
                 Visibility="Collapsed"
                 Margin="8,0,8,0"
                 Foreground="{DynamicResource AccentBlueBrush}"/>

    <!-- ── STATUS BAR — hidden, controls kept for code-behind ──────── -->
    <Border Grid.Row="1" Visibility="Collapsed">
      <Grid>
        <TextBlock x:Name="TxtStatus"/>
        <TextBlock x:Name="TxtCounts"/>
      </Grid>
    </Border>

    <!-- ── 2-COLUMN: Summary (left) | Tabs+Data (right) ─── -->
    <Grid Grid.Row="2" Grid.RowSpan="2" Background="{DynamicResource PageBgBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>  <!-- Summary -->
        <ColumnDefinition Width="8"/>    <!-- gap — matches PerformQA column gap -->
        <ColumnDefinition Width="*"/>    <!-- Tabs + Data -->
      </Grid.ColumnDefinitions>

      <!-- ── COL 0: Summary panel ── -->
      <Border Grid.Column="0" Margin="8,0,0,8"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}"
              BorderThickness="1" CornerRadius="10" Padding="0"
              ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>  <!-- header — matches PerformQA -->
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- Header — same grey style as PerformQA -->
          <Border Grid.Row="0" CornerRadius="10,10,0,0"
                  Background="{DynamicResource FooterBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Summary" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="12,0"/>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SummaryPanel" Margin="12,10"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ── COL 2: Tabs + Data ── -->
      <Border Grid.Column="2" Margin="0,0,8,8"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}"
              BorderThickness="1" CornerRadius="10" Padding="0"
              ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- tab bar - MinHeight 34 matches the PerformQA header,
                                                and Auto lets it grow to a second row when the fifteen
                                                tabs no longer fit on one. Fixed 34 clipped them. -->
            <RowDefinition Height="*"/>   <!-- data content -->
          </Grid.RowDefinitions>

          <!-- Tab bar - same grey header style as PerformQA.

               MinHeight keeps the single-row bar at exactly the 34 it always was, so nothing moves
               at 100% and 125%. WrapPanel, not a horizontal StackPanel: the strip needs about 1250
               logical units and the window only has 1920 / scale to give, so at 150% (which Windows
               calls Recommended on a 15 inch 1080p panel) it is roughly two tabs too long and at
               175% about four. The parent Border sets ClipToBounds, so the overflow was not scrolled
               or hidden behind an affordance, it was simply cut off with nothing on screen saying
               Temp Folder and Event Monitor existed. -->
          <Border Grid.Row="0" CornerRadius="10,10,0,0" MinHeight="34"
                  Background="{DynamicResource FooterBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}"
                  BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
              <Button x:Name="TabAll"       Content="All"          Style="{StaticResource TabBtnActiveStyle}" Click="Tab_Click" Tag="All"/>
              <Button x:Name="TabFiles"     Content="Files"        Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Files"/>
              <Button x:Name="TabShortcuts" Content="Shortcuts"    Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Shortcuts"/>
              <Button x:Name="TabRegistry"  Content="Registry"     Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Registry"/>
              <Button x:Name="TabEnv"       Content="Environment"  Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Environment"/>
              <Button x:Name="TabCerts"     Content="Certificates" Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Certificates"/>
              <Button x:Name="TabServices"  Content="Services"     Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Services"/>
              <Button x:Name="TabFirewall"  Content="Firewall"     Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Firewall"/>
              <Button x:Name="TabDrivers"   Content="Drivers"      Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Drivers"/>
              <Button x:Name="TabOdbc"      Content="ODBC"         Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Odbc"/>
              <Button x:Name="TabTasks"     Content="Schedules" Style="{StaticResource TabBtnStyle}"     Click="Tab_Click" Tag="SchedTask"/>
              <Button x:Name="TabProcess"   Content="Process"      Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Process"/>
              <Button x:Name="TabApps"      Content="Applications" Style="{StaticResource TabBtnStyle}"      Click="Tab_Click" Tag="InstalledApp"/>
              <Button x:Name="TabTemp"      Content="Temp"  Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="Temp"/>
              <Button x:Name="TabEvents"    Content="Events" Style="{StaticResource TabBtnStyle}"      Click="Tab_Click" Tag="Events"/>
            </WrapPanel>
          </Border>

          <!-- Data area — no footer -->
          <Border Grid.Row="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>    <!-- data only — footer removed -->
            </Grid.RowDefinitions>

          <!-- Tree Views (one per tab, visibility controlled in code) -->
          <Grid Grid.Row="0">

            <!-- ALL tab — flat list view -->
            <ListView x:Name="LvAll" FontSize="11"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseRightButtonUp="LvAll_MouseRightButtonUp">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="28">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                  Checked="SnapItem_CheckChanged"
                                  Unchecked="SnapItem_CheckChanged"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColPath" Header="Path / Key / Service Name / Environment" Width="340">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock x:Name="PathTb" Text="{Binding DisplayPath}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}"
                                   Loaded="PathCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColValue" Header="Value" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Value}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="ValueCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColData"  Header="Data" Width="160">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RegistryData}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="DataCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColType"  Header="Type" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RegType}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="TypeCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColDate"  Header="Date" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding FileDate}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="DateCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColSize"  Header="Size" Width="80">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding FileSize}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="SizeCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColItems" Header="Items" Width="80">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Category}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Tag="{Binding}" Loaded="ItemsCell_Loaded"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="ColOpen"  Header="Open"  Width="36">
