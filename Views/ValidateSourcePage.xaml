                      <DataTemplate>
                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Cursor="Hand" ToolTip="{Binding OpenTooltip}"
                              MouseLeftButtonUp="OpenIcon_Click">
                          <!-- Real shell icon for File/Folder/Shortcut -->
                          <Image Source="{Binding ShellIcon}" Width="16" Height="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding ShellIcon, Converter={StaticResource NullToVisibilityConverter}}"/>
                          <!-- Emoji icon for Registry/Service/etc. (when ShellIcon is null) -->
                          <TextBlock Text="{Binding OpenIcon}" FontSize="13"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding OpenIcon, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                        </Grid>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>

            <!-- FILES tab — TreeView -->
            <TreeView x:Name="TvFiles" FontSize="11" Visibility="Collapsed"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✓  Include" Click="CtxInclude_Click"/>
                                    <MenuItem Header="✕  Exclude" Click="CtxExclude_Click"/>
                                    <Separator/>
                                    <MenuItem Header="▼  Expand"   Click="CtxExpand_Click"/>
                                    <MenuItem Header="▲  Collapse" Click="CtxCollapse_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📄  Add File…"     Click="BtnAddFile_Click"/>
                                    <MenuItem Header="📁  Add Folder…"   Click="BtnAddFolder_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="{Binding Name}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

