<Page x:Class="SwiftPack.Views.CreatePackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}" Title="Create Package">
  <Page.Resources>
    <!-- ══ CPBtn — matches PerformQA QABtn exactly ══ -->
    <Style x:Key="CPBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="Width"           Value="82"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ClearBtnStyle" TargetType="Button">
      <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small toolbar button (compact) -->
    <Style x:Key="TbBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="7,3,7,3"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnPressedBgBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TbBtnDisabledFgBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Save button (highlighted) -->
    <Style x:Key="TbSaveBtnStyle" TargetType="Button" BasedOn="{StaticResource TbBtnStyle}">
      <Setter Property="Background" Value="{DynamicResource TbSaveBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ Rounded param TextBox (6px corners) — applied to second-column param boxes ══ -->
    <Style x:Key="RoundedParamTextBox" TargetType="TextBox">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush"      Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Padding"         Value="8,0,8,0"/>
      <Setter Property="Height"          Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ══ Rounded param ComboBox (6px corners) ══ -->
    <ControlTemplate x:Key="RoundedParamComboToggle" TargetType="ToggleButton">
      <Border x:Name="tbd" Background="{DynamicResource InputBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}"
              BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
          </Grid.ColumnDefinitions>
          <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextMutedBrush}"/>
        </Grid>
      </Border>
    </ControlTemplate>

    <Style x:Key="RoundedParamCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Template="{StaticResource RoundedParamComboToggle}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="Popup" Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border x:Name="DropDownBorder" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource BorderMainBrush}"
                        BorderThickness="1" CornerRadius="6"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ══ Rounded param CheckBox (rounded check box) ══ -->
    <Style x:Key="RoundedParamCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                      BorderThickness="1" VerticalAlignment="Center"
                      Background="{DynamicResource InputBgBrush}"
                      BorderBrush="{DynamicResource BorderMainBrush}">
                <Path x:Name="check" Stretch="Uniform" Margin="3"
                      Data="M 0 4 L 3 7 L 8 0"
                      Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="2"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ══ Rounded icon button (browse 📁 / registry 🗂 next to param boxes) ══ -->
    <Style x:Key="RoundedIconButton" TargetType="Button">
      <Setter Property="Background"  Value="{DynamicResource FooterBgBrush}"/>
      <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <!-- Root grid: combined tab+toolbar row, then content -->
  <Grid Margin="8,8,8,8" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/> <!-- Tab strip — auto-sizes to content -->
      <RowDefinition Height="8"/>   <!-- Gap between tab strip and content -->
      <RowDefinition Height="*"/>   <!-- Tab content -->
    </Grid.RowDefinitions>

    <!-- ═══ COMBINED TAB STRIP + TOOLBAR ═══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>  <!-- Tabs -->
          <ColumnDefinition Width="*"/>     <!-- Toolbar (fills remaining) -->
        </Grid.ColumnDefinitions>

        <!-- Tab Buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- No underline — BorderThickness=0 on both -->
          <Border x:Name="TabInfoIndicator" BorderThickness="0" Background="Transparent" CornerRadius="6">
            <Button x:Name="BtnTabInfo" Height="28" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnTabInfo_Click" HorizontalContentAlignment="Stretch">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="hov" Background="Transparent" CornerRadius="6" Padding="10,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="hov" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="Transparent" CornerRadius="5" Width="20" Height="20" Margin="0,0,6,0">
                  <TextBlock Text="ℹ" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Info" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Border>
          <Border x:Name="TabScriptIndicator" BorderThickness="0" Background="Transparent" CornerRadius="6">
            <Button x:Name="BtnTabScript" Height="28" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnTabScript_Click" HorizontalContentAlignment="Stretch">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="hov" Background="Transparent" CornerRadius="6" Padding="10,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="hov" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="Transparent" CornerRadius="5" Width="20" Height="20" Margin="0,0,6,0">
                  <TextBlock Text="📝" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Script" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Border>
          <!-- Separator between tabs and toolbar -->
          <Rectangle Width="1" Fill="{DynamicResource BorderMainBrush}" Margin="4,4"/>
        </StackPanel>

        <!-- Info Toolbar (visible when Info tab active) -->
        <StackPanel Grid.Column="1" x:Name="InfoToolbar" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,0,0" Visibility="Visible">
          <StackPanel x:Name="PanelProgressHdr" Orientation="Vertical" VerticalAlignment="Center"
                      Margin="0,0,16,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtProgressLabelHdr" Text="Working…" FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="PkgProgressBarHdr" Height="3" Width="120" Minimum="0" Maximum="100"
                         Background="{DynamicResource CommandPanelBgBrush}"
                         Foreground="{DynamicResource AccentBlueBrush}" BorderThickness="0"/>
          </StackPanel>
          <Button x:Name="BtnCreate"
                  Style="{StaticResource CPBtn}" Height="28" Width="92"
                  Margin="0,0,6,0" ToolTip="Create folder structure" Click="BtnCreate_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="📦" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Create" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnModify"
                  Style="{StaticResource CPBtn}" Height="28" Width="92"
                  Margin="0,0,6,0" ToolTip="Modify an existing package" Click="BtnModify_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="✏" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Modify" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnInfoSave" Content="💾 Save"
                  Style="{StaticResource CPBtn}" Height="28" Width="92"
                  Margin="0,0,6,0" ToolTip="Save App Variables to script" Click="BtnInfoSave_Click"/>
          <Button x:Name="BtnCancelCreate" Content="✕ Cancel"
                  Style="{StaticResource CPBtn}" Height="28" Width="92"
                  Margin="0,0,6,0" ToolTip="Cancel package creation" IsEnabled="False"
                  Click="BtnCancelCreate_Click"/>
          <Button x:Name="BtnRefreshConfig" Content="🆕 New"
                  Style="{StaticResource CPBtn}" Height="28" Width="92"
                  ToolTip="Re-read CreatePackage.json and populate fields" Click="BtnRefreshConfig_Click"/>
          <Button x:Name="BtnPkgSettings" Content="⚙ Settings"
                  Style="{StaticResource CPBtn}" Height="28" Width="100" Margin="6,0,0,0"
                  ToolTip="Edit CreatePackage.json (template/output folders and injection flags)"
                  Click="BtnPkgSettings_Click"/>
          <Button x:Name="BtnDownloadSwitches" Content="↓ Download Silent Switches"
                  Style="{StaticResource CPBtn}" Height="28" Width="184" Margin="6,0,0,0"
                  ToolTip="Build Templates\SilentSwitches.json from the winget catalog"
                  Click="BtnDownloadSwitches_Click"/>
        </StackPanel>

        <!-- Script Toolbar (only visible when Script tab active) -->
        <Grid Grid.Column="1" x:Name="ScriptToolbarScroll" Visibility="Collapsed" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><!-- Undo -->
            <ColumnDefinition Width="*"/><!-- Redo -->
            <ColumnDefinition Width="*"/><!-- Delete -->
            <ColumnDefinition Width="*"/><!-- Cut -->
            <ColumnDefinition Width="*"/><!-- Copy -->
            <ColumnDefinition Width="*"/><!-- Paste -->
            <ColumnDefinition Width="*"/><!-- Insert -->
            <ColumnDefinition Width="*"/><!-- MoveUp -->
            <ColumnDefinition Width="*"/><!-- MoveDown -->
            <ColumnDefinition Width="*"/><!-- Comment -->
            <ColumnDefinition Width="*"/><!-- Uncomment -->
          </Grid.ColumnDefinitions>

          <Button x:Name="BtnUndo" Grid.Column="0" Click="BtnUndo_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Undo (Ctrl+Z)" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="↩ Undo"/>
          <Button x:Name="BtnRedo" Grid.Column="1" Click="BtnRedo_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Redo (Ctrl+Y)" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="↪ Redo"/>
          <Button x:Name="BtnScriptDelete" Grid.Column="2" Click="BtnScriptDelete_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Delete line(s)" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="🗑 Delete"/>
          <Button x:Name="BtnScriptCut" Grid.Column="3" Click="BtnScriptCut_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Cut line(s)" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="✂ Cut"/>
          <Button x:Name="BtnScriptCopy" Grid.Column="4" Click="BtnScriptCopy_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Copy line(s)" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="⧉ Copy"/>
          <Button x:Name="BtnScriptPaste" Grid.Column="5" Click="BtnScriptPaste_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Paste" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="📋 Paste"/>
          <Button x:Name="BtnScriptInsert" Grid.Column="6" Click="BtnScriptInsert_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Insert empty line" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="➕ Insert"/>
          <Button x:Name="BtnScriptMoveUp" Grid.Column="7" Click="BtnScriptMoveUp_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Move line up" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="▲ MoveUp"/>
          <Button x:Name="BtnScriptMoveDown" Grid.Column="8" Click="BtnScriptMoveDown_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Move line down" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="▼ MoveDown"/>
          <Button x:Name="BtnScriptComment" Grid.Column="9" Click="BtnScriptComment_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Comment selected lines" Height="28"
                  Width="Auto" Margin="0,0,6,0" Content="# Comment"/>
          <Button x:Name="BtnScriptUncomment" Grid.Column="10" Click="BtnScriptUncomment_Click" Focusable="False"
                  Style="{StaticResource CPBtn}" ToolTip="Uncomment selected lines" Height="28"
                  Width="Auto" Margin="0,0,0,0" Content="⊘ Uncomment"/>

          <!-- Close hidden — kept for code-behind reference -->
          <Button x:Name="BtnScriptClose" Visibility="Collapsed" Click="BtnScriptClose_Click"
                  ToolTip="Close script"/>
        </Grid>
      </Grid>
    </Border>

    <!-- ══ PROGRESS BAR — overlaid on bottom edge of toolbar, zero extra height ══ -->
    <ProgressBar x:Name="PrgHeaderProgress"
                 Grid.Row="0"
                 Height="3"
                 Minimum="0" Maximum="100" Value="0"
                 IsIndeterminate="True"
                 VerticalAlignment="Bottom"
                 Visibility="Collapsed"
                 Margin="8,0,8,0"
                 Foreground="{DynamicResource AccentBlueBrush}"/>

    <!-- ═══ TAB CONTENT ═══ -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderMainBrush}"
            BorderThickness="0"
            CornerRadius="10"
            Margin="0"
            Background="{DynamicResource WindowBgBrush}">
    <Grid>

      <!-- ══════ INFO TAB ══════ -->
      <Grid x:Name="TabInfoContent" Visibility="Visible">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- PACKAGE PATHS -->
          <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Border Background="Transparent" CornerRadius="6" Width="24" Height="24" Margin="0,0,7,0">
                  <TextBlock Text="📁" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PACKAGE PATHS" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="LblTemplateFolder" Text="PSADT Template Folder" Style="{StaticResource FieldLabelStyle}" FontSize="11"/>
                  <TextBlock Text=" *" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBox x:Name="TxtTemplatePath" Style="{StaticResource ModernTextBoxStyle}" Height="26" Tag="Select template or package folder..." FontSize="11" Padding="6,0,24,0" HorizontalScrollBarVisibility="Hidden" TextChanged="TemplatePath_TextChanged" AllowDrop="True" Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtTemplatePath" Click="ClearField_Click"/>
                </Grid>
                <Button x:Name="BtnBrowseTemplate" Grid.Column="2" Content="&#x1F4C1; Browse" Style="{StaticResource BrowseButtonStyle}" Height="26" FontSize="11" Click="BrowseTemplate_Click"/>
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source Folder" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBox x:Name="TxtSourcePath" Style="{StaticResource ModernTextBoxStyle}" Height="26" Tag="Browse for source folder…" FontSize="11" Padding="6,0,24,0" HorizontalScrollBarVisibility="Hidden" TextChanged="PathBox_TextChanged" AllowDrop="True" Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtSourcePath" Click="ClearField_Click"/>
                </Grid>
                <Button x:Name="BtnBrowseSource" Grid.Column="2" Content="&#x1F4C1; Browse" Style="{StaticResource BrowseButtonStyle}" Height="26" FontSize="11" Click="BrowseSource_Click"/>
              </Grid>
              <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source File" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBox x:Name="TxtMainFile" Style="{StaticResource ModernTextBoxStyle}" Height="26" Tag="Select .msi or .exe (optional)…" FontSize="11" Padding="6,0,24,0" HorizontalScrollBarVisibility="Hidden" TextChanged="PathBox_TextChanged" AllowDrop="True" Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtMainFile" Click="ClearField_Click"/>
                </Grid>
                <Button x:Name="BtnBrowseMainFile" Grid.Column="2" Content="&#x1F4C4; Browse" Style="{StaticResource BrowseButtonStyle}" Height="26" FontSize="11" Click="BrowseMainFile_Click"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="Package Output Folder" Style="{StaticResource FieldLabelStyle}" FontSize="11"/>
                  <TextBlock Text=" *" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBox x:Name="TxtOutputPath" Style="{StaticResource ModernTextBoxStyle}" Height="26" Tag="Select package output folder..." FontSize="11" Padding="6,0,24,0" HorizontalScrollBarVisibility="Hidden" TextChanged="PathBox_TextChanged" AllowDrop="True" Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtOutputPath" Click="ClearField_Click"/>
                </Grid>
                <Button x:Name="BtnBrowseOutput" Grid.Column="2" Content="&#x1F4C1; Browse" Style="{StaticResource BrowseButtonStyle}" Height="26" FontSize="11" Click="BrowseOutput_Click"/>
              </Grid>
            </Grid>
          </Border>

          <!-- APP VARIABLES -->
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Border Background="Transparent" CornerRadius="6" Width="24" Height="24" Margin="0,0,7,0">
                  <TextBlock Text="📝" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="APP VARIABLES" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="AppVendor" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppVendor" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Smekal Solutions" TextChanged="AppFields_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppVendor" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="AppProcessToClose" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Grid Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppProcesses" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. excel, winword" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppProcesses" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="AppName" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppName" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Smekal Folder Compare" TextChanged="AppFields_Changed" GotFocus="EditBox_GotFocus"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearAppName_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="AppScriptVersion" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtScriptVersion" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 1.0.0" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtScriptVersion" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="AppVersion" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppVersion" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 1.0" TextChanged="AppFields_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppVersion" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="AppScriptDate" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtScriptDate" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 2025-01-01" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtScriptDate" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="AppArch" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppArch" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. x64 or x86" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppArch" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="AppScriptAuthor" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtScriptAuthor" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Packager Name" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtScriptAuthor" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="AppLang" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppLang" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. EN or DE or CH" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppLang" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="3" Text="RequireAdmin" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="4" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtRequireAdmin" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. $true or $false" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtRequireAdmin" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="AppRevision" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtAppRevision" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 01" TextChanged="AppFields_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtAppRevision" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="5" Grid.Column="3" Text="InstallName" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="5" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtInstallName" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Smekal_FolderCompare_1.0_01" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearInstallName_Click"/>
                </Grid>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="AppSuccessExitCodes" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Grid Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtSuccessExitCodes" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 0, 3010" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtSuccessExitCodes" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="6" Grid.Column="3" Text="InstallTitle" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center"/>
                <Grid Grid.Row="6" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtInstallTitle" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Smekal_FolderCompare_1.0_01" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearInstallTitle_Click"/>
                </Grid>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="AppRebootExitCodes" Style="{StaticResource FieldLabelStyle}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Grid Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtRebootExitCodes" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. 1641, 3010" TextChanged="AppVarField_Changed" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtRebootExitCodes" Click="ClearField_Click"/>
                </Grid>
                <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="PackageName" Style="{StaticResource FieldLabelStyle}" FontSize="11" MinWidth="0"/>
                  <TextBlock Text=" *" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="7" Grid.Column="4" VerticalAlignment="Center" Margin="0,3,0,3">
                  <TextBox x:Name="TxtPackageName" Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11" Padding="6,0,24,0" Tag="e.g. Smekal_FolderCompare_1.0_01" GotFocus="EditBox_GotFocus" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource ClearBtnStyle}" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Tag="TxtPackageName" Click="ClearField_Click"/>
                </Grid>
                <TextBlock Grid.Row="8" Grid.Column="0" Visibility="Hidden"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- STATUS BAR hidden — progress controls kept for code-behind -->
        <Border Grid.Row="1" Visibility="Collapsed">
          <Grid>
            <StackPanel x:Name="PanelProgress" VerticalAlignment="Center" Margin="0,0,24,0" Visibility="Collapsed">
              <TextBlock x:Name="TxtProgressLabel" Text="Working…" FontSize="11"/>
              <ProgressBar x:Name="PkgProgressBar" Height="4" Minimum="0" Maximum="100" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Text="* Required fields" FontSize="11"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ══════ SCRIPT TAB ══════ -->
      <Grid x:Name="TabScriptContent" Visibility="Collapsed"
            Background="{DynamicResource WindowBgBrush}">
        <!-- 3-Column Body filling full width to match tab strip -->
        <Grid x:Name="ScriptMainGrid" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColCommands" Width="270" MinWidth="270" MaxWidth="270"/>
            <ColumnDefinition x:Name="ColSplit1"   Width="8"/>
            <ColumnDefinition x:Name="ColParams"   Width="270" MinWidth="270" MaxWidth="270"/>
            <ColumnDefinition x:Name="ColSplit2"   Width="8"/>
            <ColumnDefinition x:Name="ColScript"   Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- ═ COL 1: COMMANDS ═ -->
          <Border Grid.Column="0" Background="{DynamicResource CommandPanelBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1,1,1,1" CornerRadius="10,10,10,10" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>  <!-- header — matches PerformQA -->
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="8,0">
                <Border Margin="0,5,0,5" Background="{DynamicResource SearchBoxBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1" CornerRadius="5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" Margin="7,0,3,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TxtCmdSearchWatermark" Grid.Column="1"
                               Text="Search Commands" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                               Padding="2,0" Panel.ZIndex="1" Visibility="Visible"/>
                    <TextBox x:Name="TxtCmdSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBlueBrush}" TextChanged="TxtCmdSearch_TextChanged" KeyDown="TxtCmdSearch_KeyDown"/>
                    <Button x:Name="BtnClearCmdSearch" Grid.Column="2" Content="✕" Width="22" Height="22" Margin="3,0"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Cursor="Hand"
                            Click="BtnClearCmdSearch_Click" Visibility="Collapsed"/>
                  </Grid>
                </Border>
              </Border>
              <!-- Row 1 now used by command list (search moved to header) -->
              <!-- Command List — name only, no description -->
              <ListBox x:Name="LstCommands" Grid.Row="1" Background="Transparent" BorderThickness="0"
                       Margin="4,0,4,4" SelectionChanged="LstCommands_SelectionChanged"
                       IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                       VirtualizingPanel.IsVirtualizing="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="8,5,8,5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                  Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/>
                              <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <!-- Name only — synopsis removed -->
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        IsEnabled="False" Cursor="Arrow"/>

          <!-- ═ COL 2: PARAMETER BUILDER ═ -->
          <Border Grid.Column="2" Background="{DynamicResource ParamPanelBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1,1,1,1" CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>  <!-- header — matches PerformQA -->
                <RowDefinition Height="*"/>   <!-- params -->
              </Grid.RowDefinitions>

              <!-- Col2 header: Add/Help buttons only -->
              <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="6,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,4">
                  <Button x:Name="BtnAddToScript"
                          Content="➕ Add" IsEnabled="False"
                          Click="BtnAddToScript_Click"
                          Style="{StaticResource TbBtnStyle}" Height="28" Padding="8,0" Margin="0,0,4,0"
                          Background="{DynamicResource TbInsertBgBrush}"
                          BorderBrush="{DynamicResource TbInsertBorderBrush}"
                          Foreground="{DynamicResource TbInsertFgBrush}" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelParams" Margin="10,8,10,4">
                  <!-- Command name shown at top of params panel — full width, wraps if long -->
                  <TextBlock x:Name="TxtParamHeader"
                             Text="← Select a command from the left panel."
                             FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource NavIconIntuneFgBrush}"
                             TextWrapping="Wrap" TextAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="0,4,0,10"
                             Visibility="Visible"/>
                  <TextBlock x:Name="TxtParamPlaceholder"
                             Text=""
                             Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0"/>
                </StackPanel>
              </ScrollViewer>


            </Grid>
          </Border>

          <GridSplitter Grid.Column="3" Width="6" Background="Transparent"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        IsEnabled="False" Cursor="Arrow"/>

          <!-- ═ COL 3: SCRIPT VIEWER ═ -->
          <Border Grid.Column="4" Background="{DynamicResource NoScriptBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1,1,1,1" CornerRadius="10,10,10,10" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>  <!-- header — matches PerformQA -->
                <RowDefinition Height="*"/>
                <!-- footer removed -->
              </Grid.RowDefinitions>

              <!-- Col3 header -->
              <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="10,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock x:Name="TxtScriptFileName" Text=""
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource NavIconExecFgBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtScriptDirty" Text=" ●" Foreground="#F7584F"
                               FontSize="14" VerticalAlignment="Center"
                               Visibility="Collapsed" ToolTip="Unsaved changes"/>
                    <!-- Running status shown during Install/Uninstall/Repair -->
                    <Border x:Name="BorderScriptRunning" Background="{DynamicResource RunningBadgeBgBrush}" CornerRadius="3"
                            Margin="10,0,0,0" Padding="6,2,6,2" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtScriptRunning" Text="Installation in progress. Please wait."
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <!-- Right side: search + action buttons -->
                  <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26"/>        <!-- ◀ prev -->
                      <ColumnDefinition Width="2*"/>        <!-- search box — wider -->
                      <ColumnDefinition Width="26"/>        <!-- ▶ next -->
                      <ColumnDefinition Width="*"/>         <!-- Save -->
                      <ColumnDefinition Width="*"/>         <!-- Open -->
                      <ColumnDefinition Width="*"/>         <!-- Reload -->
                      <ColumnDefinition Width="32"/>        <!-- expand/collapse toggle -->
                    </Grid.ColumnDefinitions>

                    <!-- ◀ Prev -->
                    <Button x:Name="BtnSearchPrev" Grid.Column="0" Click="BtnSearchPrev_Click"
                            Margin="4,0,2,0" Padding="0" Height="28"
                            Cursor="Arrow" ToolTip="Previous match" IsEnabled="False">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <TextBlock Text="◀" FontSize="10" FontWeight="Bold"/>
                    </Button>

                    <!-- Search box with 🔍 icon inside -->
                    <Border Grid.Column="1" Margin="0,0,2,0" Height="28"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderMainBrush}"
                            BorderThickness="1" CornerRadius="3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>  <!-- 🔍 icon -->
                          <ColumnDefinition Width="*"/>     <!-- text box -->
                          <ColumnDefinition Width="Auto"/>  <!-- count -->
                          <ColumnDefinition Width="Auto"/>  <!-- ✕ clear -->
                        </Grid.ColumnDefinitions>
                        <!-- Search icon -->
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center"
                                   Padding="5,0,2,0" Foreground="{DynamicResource TextMutedBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1"
                                   Text="Find in script…" FontSize="11" VerticalAlignment="Center"
                                   Padding="2,0,2,0" Foreground="{DynamicResource TextMutedBrush}"
                                   IsHitTestVisible="False" Panel.ZIndex="1"/>
                        <TextBox x:Name="TxtScriptSearch" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="11" VerticalAlignment="Center" Padding="2,0,2,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 TextChanged="TxtScriptSearch_TextChanged"
                                 KeyDown="TxtScriptSearch_KeyDown"/>
                        <TextBlock x:Name="TxtSearchCount" Grid.Column="2"
                                   FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="2,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnClearScriptSearch" Grid.Column="3"
                                Content="✕" Width="18" Height="18" Margin="2,0,2,0" Padding="0"
                                FontSize="9" Cursor="Hand" Visibility="Collapsed"
                                Click="BtnClearScriptSearch_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                      </Grid>
                    </Border>

                    <!-- ▶ Next -->
                    <Button x:Name="BtnSearchNext" Grid.Column="2" Click="BtnSearchNext_Click"
                            Margin="0,0,6,0" Padding="0" Height="28"
                            Cursor="Arrow" ToolTip="Next match" IsEnabled="False">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <TextBlock Text="▶" FontSize="10" FontWeight="Bold"/>
                    </Button>

                    <!-- Save -->
                    <Button x:Name="BtnScriptSave" Grid.Column="3" Click="BtnScriptSave_Click"
                            Style="{StaticResource CPBtn}" Margin="0,0,2,0" Height="28"
                            Width="Auto" ToolTip="Save script" Content="💾 Save"/>

                    <!-- Open -->
                    <Button x:Name="BtnScriptOpen" Grid.Column="4" Click="BtnScriptOpen_Click"
                            Style="{StaticResource CPBtn}" Margin="0,0,2,0" Height="28"
                            Width="Auto" ToolTip="Open in PowerShell ISE" Content="📂 Open"/>

                    <!-- Reload — re-reads Invoke-AppDeployToolkit.ps1 and refreshes Info + Script tabs -->
                    <Button x:Name="BtnScriptReload" Grid.Column="5" Click="BtnScriptReload_Click"
                            Style="{StaticResource CPBtn}" Margin="0,0,2,0" Height="28"
                            Width="Auto" ToolTip="Reload script from disk and refresh Info &amp; Script tabs" Content="🔄 Reload"/>

                    <!-- Expand/collapse left panels -->
                    <Button x:Name="BtnScriptExpand" Grid.Column="6" Click="BtnScriptExpand_Click"
                            Margin="2,0,2,0" Padding="0" Height="28" Width="28"
                            Cursor="Arrow" ToolTip="Expand script editor (hide left panels)">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
                          <Setter Property="BorderThickness" Value="1"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                      <Grid Width="16" Height="16">
                        <!-- Collapse icon: thick bar on right + bold left arrow — visible when panels are shown -->
                        <Canvas x:Name="IconCollapse" Width="16" Height="16" Visibility="Collapsed">
                          <!-- Vertical bar on the right -->
                          <Rectangle Canvas.Left="12" Canvas.Top="1" Width="3" Height="14"
                                     Fill="{DynamicResource TextPrimaryBrush}" RadiusX="1" RadiusY="1"/>
                          <!-- Arrow pointing left: chevron -->
                          <Path Fill="{DynamicResource TextPrimaryBrush}"
                                Data="M 9,8 L 4,3 L 2,5 L 6,8 L 2,11 L 4,13 Z"/>
                        </Canvas>
                        <!-- Expand icon: thick bar on left + bold right arrow — visible when panels are hidden -->
                        <Canvas x:Name="IconExpand" Width="16" Height="16" Visibility="Visible">
                          <!-- Vertical bar on the left -->
                          <Rectangle Canvas.Left="1" Canvas.Top="1" Width="3" Height="14"
                                     Fill="{DynamicResource TextPrimaryBrush}" RadiusX="1" RadiusY="1"/>
                          <!-- Arrow pointing right: chevron -->
                          <Path Fill="{DynamicResource TextPrimaryBrush}"
                                Data="M 7,8 L 12,3 L 14,5 L 10,8 L 14,11 L 12,13 Z"/>
                        </Canvas>
                      </Grid>
                    </Button>
                  </Grid>
                </Grid>
              </Border>


              <!-- Animated progress bar — visible while running -->
              <ProgressBar x:Name="ScriptProgressBar" Grid.Row="0"
                           Height="3" VerticalAlignment="Bottom"
                           IsIndeterminate="True"
                           Foreground="{DynamicResource AccentGreenBrush}" Background="Transparent"
                           BorderThickness="0"
                           Visibility="Collapsed"
                           Panel.ZIndex="10"/>

              <!-- No-script placeholder -->
              <Border x:Name="PanelNoScript" Grid.Row="1" Background="{DynamicResource NoScriptBgBrush}" Panel.ZIndex="10" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.3"/>
                  <TextBlock Text="No script loaded yet" FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                  <TextBlock Text="Go to the Info tab, fill in the fields and click Create."
                             FontSize="11" Foreground="{DynamicResource BorderInputBrush}" HorizontalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                </StackPanel>
              </Border>

              <!-- Line numbers + editor -->
              <Border Grid.Row="1" CornerRadius="0,0,10,10" ClipToBounds="True" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Line numbers panel — clickable to highlight a line -->
                <Border Grid.Column="0" Background="{DynamicResource LineNumBgBrush}"
                        BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,10" ClipToBounds="True">
                  <ScrollViewer x:Name="LineNumScroll"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Hidden"
                                IsHitTestVisible="True"
                                Cursor="Arrow">
                    <TextBlock x:Name="TxtLineNumbers" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource BorderInputBrush}"
                               TextAlignment="Right" Padding="4,5,6,4"
                               MouseDown="TxtLineNumbers_MouseDown"
                               Cursor="Arrow"/>
                  </ScrollViewer>
                </Border>

                <!-- Editor column.
                     ScriptEditorGrid: ClipToBounds=False so ScrollViewer scrollbars
                     (which render at the Grid edge) are never clipped.
                     The search-highlight overlay is clipped separately inside
                     ScriptOverlayClip which sits behind the ScrollViewer. -->
                <Grid Grid.Column="1" x:Name="ScriptEditorGrid">

                  <!-- Solid background -->
                  <Border Panel.ZIndex="-1"
                          Background="{DynamicResource ScriptBgBrush}"
                          CornerRadius="0,0,10,0"
                          IsHitTestVisible="False"/>

                  <!-- ScrollViewer owns BOTH scrollbars -->
                  <ScrollViewer x:Name="ScriptScrollViewer"
                                Panel.ZIndex="1"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalScrollBarVisibility="Visible"
                                VerticalScrollBarVisibility="Auto"
                                ScrollChanged="ScriptScrollViewer_ScrollChanged"
                                PreviewMouseWheel="ScriptScrollViewer_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="ScriptScrollViewer_PreviewMouseLeftButtonDown"
                                PreviewMouseRightButtonDown="ScriptScrollViewer_RightClick">
                    <TextBox x:Name="TxtScript"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="#FFEE00" BorderThickness="0"
                             IsReadOnly="True"
                             Cursor="Arrow"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="NoWrap"
                             Padding="8,5,8,5"
                             SelectionBrush="Transparent"
                             IsInactiveSelectionHighlightEnabled="True"
                             TextChanged="TxtScript_TextChanged"
                             SelectionChanged="TxtScript_SelectionChanged"
                             PreviewMouseDown="TxtScript_PreviewMouseDown"
                             PreviewMouseMove="TxtScript_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="TxtScript_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="TxtScript_PreviewKeyDown"
                             AllowDrop="True"
                             PreviewDragOver="TxtScript_LnkDragOver"
                             Drop="TxtScript_LnkDrop"/>
                  </ScrollViewer>

                  <!-- Search-highlight overlay and green line highlight live here.
                       ClipToBounds=True on ScriptOverlayClip so overlays never bleed
                       outside the text area. IsHitTestVisible=False on both so all
                       mouse/keyboard events pass through to the ScrollViewer. -->
                  <Border x:Name="ScriptOverlayClip"
                          Panel.ZIndex="2"
                          ClipToBounds="True"
                          IsHitTestVisible="False"
                          Background="Transparent">
                    <Canvas x:Name="LineHighlightCanvas"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                            IsHitTestVisible="False">
                      <Rectangle x:Name="LineHighlightRect"
                                 Fill="#5500CC55"
                                 Height="18" Width="20000"
                                 Canvas.Left="0" Canvas.Top="0"
                                 Visibility="Collapsed"/>
                    </Canvas>
                  </Border>

                </Grid>
              </Grid>
              </Border><!-- /line numbers + editor -->

              <!-- Status bar — hidden, kept for code-behind references -->
              <Border Grid.Row="2" Visibility="Collapsed">
                <Grid>
                  <TextBlock x:Name="TxtScriptPath" Text="No script loaded"/>
                  <TextBlock x:Name="TxtCursorPos" Text="Ln 1, Col 1"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>

    </Grid>
    </Border>
  </Grid>
</Page>
