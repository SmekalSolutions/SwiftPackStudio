<Page x:Class="SwiftPack.Views.AutoPackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}"
      AllowDrop="True"
      PreviewDragOver="Page_DragOver"
      PreviewDrop="Page_Drop">
  <Page.Resources>


    <!-- APBtn - identical to QABtn / PDBtn for consistent look across features -->
    <Style x:Key="APBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- APBtnPrimary - blue Create button -->
    <Style x:Key="APBtnPrimary" TargetType="Button" BasedOn="{StaticResource APBtn}">
      <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Page.Resources>

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><!-- Tab strip -->
      <RowDefinition Height="Auto"/><!-- Toolbar/source bar -->
      <RowDefinition Height="*"/>  <!-- Content fills remaining height -->
    </Grid.RowDefinitions>

    <!-- ══ TAB STRIP ══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}"
            Margin="6,6,6,0" Padding="10,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Resources>
          <!-- Tab-strip buttons: rounded hover highlight, no focus rectangle or selected overlay
               (so the active tab's text stays fully visible in both themes). -->
          <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,0" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#334F8EF7"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#4D4F8EF7"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </StackPanel.Resources>
        <!-- Download Tab -->
        <Border x:Name="TabDownloadIndicator" Padding="10,0" Background="{DynamicResource AccentBlueBrush}" CornerRadius="6">
          <Button x:Name="BtnTabDownload" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabDownload_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="↓" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="White"/>
              <TextBlock Text="Download" FontSize="12" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
        <!-- Package Tab -->
        <Border x:Name="TabPackageIndicator" Padding="10,0" Background="Transparent" CornerRadius="6">
          <Button x:Name="BtnTabPackage" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabPackage_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📦" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Package" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
        <!-- Execute Tab -->
        <Border x:Name="TabExecuteIndicator" Padding="10,0" Background="Transparent" CornerRadius="6">
          <Button x:Name="BtnTabExecute" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabExecute_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="▶" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Execute" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
        <!-- Intunewin Tab -->
        <Border x:Name="TabIntunewinIndicator" Padding="10,0" Background="Transparent" CornerRadius="6">
          <Button x:Name="BtnTabIntunewin" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabIntunewin_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="☁" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Intunewin" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
        <!-- Publish Tab -->
        <Border x:Name="TabPublishIndicator" Padding="10,0" Background="Transparent" CornerRadius="6">
          <Button x:Name="BtnTabPublish" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabPublish_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="🚀" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Publish" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
        <!-- Document Tab -->
        <Border x:Name="TabDocumentIndicator" Padding="10,0" Background="Transparent" CornerRadius="6">
          <Button x:Name="BtnTabDocument" Height="28" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnTabDocument_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Document" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
      </StackPanel>
    </Border>

    <!-- ══ TOOLBAR - Package tab only (Collapsed = zero height) ══ -->
    <Border x:Name="PkgToolbarCard" Grid.Row="1" Style="{StaticResource CardStyle}"
            Margin="6,6,6,0" Padding="14,10" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Source Path *" FontWeight="SemiBold" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>

        <Grid Grid.Column="1" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <TextBox x:Name="HdrTxtSource"
                     Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                     Height="28" Padding="10,0,28,0"
                     AllowDrop="True"
                     TextChanged="HdrTxtSource_TextChanged"/>
            <Button x:Name="HdrBtnCancelSource" Content="✕"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="22" Height="18" Margin="0,0,4,0"
                    FontSize="10" Cursor="Hand" BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="HdrBtnCancelSource_Click" ToolTip="Clear source"/>
          </Grid>
          <Button x:Name="HdrBtnBrowseFile" Height="28" Width="95" Grid.Column="1"
                  Content="📄 Browse" Style="{StaticResource APBtn}"
                  Margin="6,0,0,0" Click="HdrBtnBrowseFile_Click" ToolTip="Select source file"/>
          <Button x:Name="HdrBtnBrowseFolder" Height="28" Width="95" Grid.Column="2"
                  Content="📁 Browse" Style="{StaticResource APBtn}"
                  Margin="6,0,0,0" Click="HdrBtnBrowseFolder_Click" ToolTip="Select source folder"/>
          <Button x:Name="BtnCreate"
                  Content="⚡  Create" Style="{StaticResource APBtn}"
                  Height="28" Width="95" Grid.Column="3"
                  Margin="6,0,0,0" ToolTip="Create package"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
          <Button x:Name="BtnRefresh"
                  Content="🔄 Refresh" Style="{StaticResource APBtn}"
                  Width="95" Margin="0,0,6,0"
                  Click="BtnRefresh_Click" ToolTip="Reload from AutoPackage.json"/>
          <Button x:Name="BtnClearAll"
                  Content="🗑 Clear" Style="{StaticResource APBtn}"
                  Width="95" Margin="0,0,6,0"
                  Click="BtnClearAll_Click" ToolTip="Clear all fields"/>
          <Button x:Name="BtnCancel"
                  Content="✕ Cancel" Style="{StaticResource APBtn}"
                  Width="95" Margin="0,0,6,0" IsEnabled="False"
                  Click="BtnCancel_Click" ToolTip="Cancel package creation"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="TxtStatus" Visibility="Collapsed" Grid.Row="1"/>
    <ProgressBar x:Name="PrgProgress"
                 Grid.Row="1"
                 Height="3" Minimum="0" Maximum="100" Value="0"
                 IsIndeterminate="True" VerticalAlignment="Top"
                 Visibility="Collapsed" Margin="6,0,6,0"
                 Panel.ZIndex="1000"
                 Foreground="{DynamicResource AccentBlueBrush}"/>


    <!-- ══ CONTENT ══ -->
    <!-- Download tab content - Frame hosting SourceDownloadPage, no extra margin (SD page has its own) -->
    <Frame x:Name="FrameDownload" Grid.Row="2"
           NavigationUIVisibility="Hidden"
           ClipToBounds="True"
           Margin="0"
           Visibility="Visible"/>

    <!-- Execute tab content - Frame hosting AutoExecutePage -->
    <Frame x:Name="FrameExecute" Grid.Row="2"
           NavigationUIVisibility="Hidden"
           ClipToBounds="True"
           Margin="0"
           Visibility="Collapsed"/>

    <!-- Publish tab content - Frame hosting AutoPublishPage -->
    <Frame x:Name="FramePublish" Grid.Row="2"
           NavigationUIVisibility="Hidden"
           ClipToBounds="True"
           Margin="0"
           Visibility="Collapsed"/>

    <!-- Document tab content - Frame hosting AutoDocumentPage -->
    <Frame x:Name="FrameDocument" Grid.Row="2"
           NavigationUIVisibility="Hidden"
           ClipToBounds="True"
           Margin="0"
           Visibility="Collapsed"/>

    <!-- Intunewin tab content - Frame hosting AutoIntunewinPage (fully isolated) -->
    <Frame x:Name="FrameIntunewin" Grid.Row="2"
           NavigationUIVisibility="Hidden"
           ClipToBounds="True"
           Margin="0"
           Visibility="Collapsed"/>

    <!-- Package tab content - existing Auto Package UI -->
    <Border x:Name="PkgContentCard" Grid.Row="2"
            Style="{StaticResource CardStyle}" Margin="6,6,6,6" Padding="0"
            Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- package fields (MSI/EXE tabs) -->
          <RowDefinition Height="*"/>      <!-- event log window fills remaining space -->
        </Grid.RowDefinitions>
      <TabControl x:Name="MainTabControl" Grid.Row="0"
                  Background="Transparent" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <TabPanel IsItemsHost="True" Visibility="Hidden" Width="0" Height="0"/>
              <ContentPresenter ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </TabControl.Template>

      <!-- ══ TAB 1: MSI ══ -->
      <TabItem x:Name="TabMsi" Height="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
          <Grid Margin="14,12,14,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>   <!-- Left label -->
                <ColumnDefinition Width="*"/>     <!-- Left value -->
                <ColumnDefinition Width="24"/>    <!-- Gap between columns -->
                <ColumnDefinition Width="160"/>   <!-- Right label -->
                <ColumnDefinition Width="*"/>     <!-- Right value -->
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- R0  Template Folder -->
                <RowDefinition Height="Auto"/><!-- R1  MSI ArgumentList | Additional ArgumentList -->
                <RowDefinition Height="Auto"/><!-- R2  App Name | App Vendor -->
                <RowDefinition Height="Auto"/><!-- R3  App Version | App Revision -->
                <RowDefinition Height="Auto"/><!-- R4  Package Name | Close Applications -->
                <RowDefinition Height="Auto"/><!-- R5  Install Command | Uninstall Command -->
                <RowDefinition Height="Auto"/><!-- R6  Create MST | Remove Desktop Shortcut -->
              </Grid.RowDefinitions>

              <!-- Hidden source textboxes kept for code-behind compatibility -->
              <TextBox x:Name="TxtSource" Visibility="Collapsed"
                       AllowDrop="True"
                       TextChanged="TxtSource_TextChanged"/>
              <TextBlock x:Name="TxtSourceError" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                         Text="⚠  Source file or folder is required"
                         Foreground="#E53935" FontSize="10"
                         VerticalAlignment="Bottom" Margin="2,-12,0,0"
                         Visibility="Collapsed"/>

              <!-- ── R0: PSADT Template Folder ── -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="PSADT Template Folder" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox x:Name="TxtTemplateFolder"
                           Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                           Height="28" Padding="10,0,28,0"
                           AllowDrop="True"
                           TextChanged="TxtTemplateFolder_TextChanged"/>
                  <Button x:Name="BtnClearTemplate" Content="✕"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="BtnClearTemplate_Click" ToolTip="Clear template folder"/>
                </Grid>
                <Button x:Name="BtnBrowseTemplate" Grid.Column="1"
                        Content="📁 Browse" Style="{StaticResource APBtn}"
                        Height="28" Width="90" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Select template folder"
                        Click="BtnBrowseTemplate_Click"/>
              </Grid>

              <!-- ── R2: MSI ArgumentList | Additional ArgumentList ── -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="MSI ArgumentList" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <Grid Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,6"
                    Visibility="Collapsed">
                         <TextBox x:Name="TxtMsiArgumentList"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="MsiArgs_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtMsiArgumentList" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="1" Grid.Column="3"
                         Text="Additional ArgumentList" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <Grid Grid.Row="1" Grid.Column="4" Height="28" Margin="0,0,0,6"
                    Visibility="Collapsed">
                         <TextBox x:Name="TxtAdditionalArgs"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="MsiArgs_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtAdditionalArgs" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R3: Create MST | Remove Desktop Shortcut ── -->
              <TextBlock Grid.Row="6" Grid.Column="0"
                         Text="Create MST" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <StackPanel x:Name="CmbCreateMst" Grid.Row="6" Grid.Column="1" 
                          Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <RadioButton Content="Yes"
                             GroupName="MsiCreateMst"
                             FontSize="11" Margin="0,0,14,0" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton Content="No" IsChecked="True"
                             GroupName="MsiCreateMst"
                             FontSize="11" Margin="0,0,14,0" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
              <TextBlock Grid.Row="6" Grid.Column="3"
                         Text="Remove Desktop Shortcut" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <StackPanel x:Name="CmbRemoveDesktop" Grid.Row="6" Grid.Column="4" 
                          Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <RadioButton Content="Yes"
                             GroupName="MsiRemoveDesktop"
                             FontSize="11" Margin="0,0,14,0" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton Content="No" IsChecked="True"
                             GroupName="MsiRemoveDesktop"
                             FontSize="11" Margin="0,0,14,0" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>

              <!-- ── R4: Name | Publisher ── -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="App Name" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtAppName"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="AppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtAppName" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="2" Grid.Column="3"
                         Text="App Vendor" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="2" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtPublisher"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="AppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtPublisher" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R5: App Version | App Revision ── -->
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="App Version" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtAppVersion"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="AppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtAppVersion" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="3" Grid.Column="3"
                         Text="App Revision" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="3" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtAppRevision"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="AppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtAppRevision" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <!-- Hidden ProductCode - still used for detection/uninstall -->
              <TextBox x:Name="TxtProductCode" Visibility="Collapsed" TextChanged="ProductCode_TextChanged"/>

              <!-- ── R6: Package Name | Close Applications ── -->
              <TextBlock Grid.Row="4" Grid.Column="0"
                         Text="Package Name" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtPackageName"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtPackageName" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock x:Name="LblCloseApps" Grid.Row="4" Grid.Column="3"
                         Text="Close Applications" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="4" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="TxtCloseApps"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       IsEnabled="False"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtCloseApps" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <Border x:Name="PanelCloseApps" Grid.Row="4" Grid.Column="3"
                      Height="0" Visibility="Collapsed"/>


              <Border x:Name="PanelDeploySection" Grid.Row="9" Grid.Column="0"
                      Height="0" Visibility="Collapsed"/>

              <!-- ── R9: Install Command | Uninstall Command (hidden until template folder set) ── -->
              <TextBlock x:Name="LblInstallCmd" Grid.Row="5" Grid.Column="0"
                         Text="Install Command" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Grid x:Name="GridInstallCmd" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,6" Visibility="Collapsed">
                         <TextBox x:Name="TxtInstallCmd"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtInstallCmd" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock x:Name="LblUninstallCmd" Grid.Row="5" Grid.Column="3"
                         Text="Uninstall Command" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Grid x:Name="GridUninstallCmd" Grid.Row="5" Grid.Column="4" Height="28" Margin="0,0,0,6" Visibility="Collapsed">
                         <TextBox x:Name="TxtUninstallCmd"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="TxtUninstallCmd" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>


              <!-- DividerBottom proxy kept for code-behind compat -->
              <Rectangle x:Name="DividerBottom" Grid.Row="1" Grid.Column="0"
                         Height="0" Visibility="Collapsed"/>

          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ══ TAB 2: EXE ══ -->
      <TabItem x:Name="TabExe" Height="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
          <Grid Margin="14,12,14,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>   <!-- Left label -->
                <ColumnDefinition Width="*"/>     <!-- Left value -->
                <ColumnDefinition Width="24"/>    <!-- Gap between columns -->
                <ColumnDefinition Width="160"/>   <!-- Right label -->
                <ColumnDefinition Width="*"/>     <!-- Right value -->
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- R0  Source Path -->
                <RowDefinition Height="Auto"/><!-- R1  Uninstall Path -->
                <RowDefinition Height="Auto"/><!-- R2  Template Folder -->
                <RowDefinition Height="Auto"/><!-- R3  ArgumentLists -->
                <RowDefinition Height="Auto"/><!-- R4  App Name | App Vendor -->
                <RowDefinition Height="Auto"/><!-- R5  App Version | App Revision -->
                <RowDefinition Height="Auto"/><!-- R6  Package Name | Close Applications -->
                <RowDefinition Height="Auto"/><!-- R7  Install Command | Uninstall Command -->
              </Grid.RowDefinitions>


              <!-- ── R0: Install Source ── -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="Source Path *" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <!-- ExeTxtSource hidden - source is set from the header toolbar -->
              <TextBox x:Name="ExeTxtSource" Visibility="Collapsed"
                       AllowDrop="True"
                       TextChanged="ExeTxtSource_TextChanged"/>
              <Button x:Name="ExeBtnCancelSource" Visibility="Collapsed"
                      Click="ExeBtnCancelSource_Click"/>
              <Button x:Name="ExeBtnBrowseFile" Visibility="Collapsed"
                      Click="ExeBtnBrowseFile_Click"/>
              <Button x:Name="ExeBtnBrowseFolder" Visibility="Collapsed"
                      Click="ExeBtnBrowseFolder_Click"/>
              <TextBlock x:Name="ExeTxtSourceError" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                         Text="⚠  Source file or folder is required"
                         Foreground="#E53935" FontSize="10"
                         VerticalAlignment="Bottom" Margin="2,-12,0,0"
                         Visibility="Collapsed"/>

              <!-- ── R1: Uninstall Source ── -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="Uninstall Path" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Height="28" Margin="0,0,0,6"
                    Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox x:Name="ExeTxtUninstallSource"
                           Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                           Height="28" Padding="10,0,28,0"
                           AllowDrop="True"/>
                  <Button x:Name="ExeBtnCancelUninstallSource" Content="✕"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="ExeBtnCancelUninstallSource_Click" ToolTip="Clear"/>
                </Grid>
                <Button x:Name="ExeBtnBrowseUninstallFile" Grid.Column="1"
                        Content="📄 Browse" Style="{StaticResource APBtn}"
                        Height="28" Width="90" Padding="8,0" Margin="6,0,0,0" Click="ExeBtnBrowseUninstallFile_Click" ToolTip="Select uninstall file"/>
              </Grid>

              <!-- ── R2: PSADT Template Folder ── -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="PSADT Template Folder" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Height="28" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox x:Name="ExeTxtTemplateFolder"
                           Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                           Height="28" Padding="10,0,28,0"
                           AllowDrop="True"
                           TextChanged="ExeTxtTemplateFolder_TextChanged"/>
                  <Button x:Name="ExeBtnClearTemplate" Content="✕"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="22" Height="18" Margin="0,0,4,0"
                          FontSize="10" Cursor="Hand" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="ExeBtnClearTemplate_Click" ToolTip="Clear template folder"/>
                </Grid>
                <Button x:Name="ExeBtnBrowseTemplate" Grid.Column="1"
                        Content="📁 Browse" Style="{StaticResource APBtn}"
                        Height="28" Width="90" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Select template folder"
                        Click="ExeBtnBrowseTemplate_Click"/>
              </Grid>

              <!-- ── R2: Name | Publisher ── -->
              <!-- ── R2: Install Args | Uninstall Args ── -->
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="Install ArgumentList" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <Grid Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,6"
                    Visibility="Collapsed">
                         <TextBox x:Name="ExeTxtInstallArgs"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeArgsField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtInstallArgs" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="3" Grid.Column="3"
                         Text="Uninstall ArgumentList" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="Collapsed"/>
              <Grid Grid.Row="3" Grid.Column="4" Height="28" Margin="0,0,0,6"
                    Visibility="Collapsed">
                         <TextBox x:Name="ExeTxtUninstallArgs"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeArgsField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtUninstallArgs" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R4: Name | Publisher ── -->
              <TextBlock Grid.Row="4" Grid.Column="0"
                         Text="App Name" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtAppName"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeAppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtAppName" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="4" Grid.Column="3"
                         Text="App Vendor" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="4" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtPublisher"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeAppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtPublisher" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R5: App Version | App Revision ── -->
              <TextBlock Grid.Row="5" Grid.Column="0"
                         Text="App Version" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtAppVersion"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeAppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtAppVersion" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock Grid.Row="5" Grid.Column="3"
                         Text="App Revision" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="5" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtAppRevision"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       TextChanged="ExeAppField_TextChanged"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtAppRevision" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R4: Package Name | Close Applications ── -->
              <TextBlock Grid.Row="6" Grid.Column="0"
                         Text="Package Name" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="6" Grid.Column="1" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtPackageName"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtPackageName" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock x:Name="ExeLblCloseApps" Grid.Row="6" Grid.Column="3"
                         Text="Close Applications" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Grid Grid.Row="6" Grid.Column="4" Height="28" Margin="0,0,0,6">
                         <TextBox x:Name="ExeTxtCloseApps"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"
                       IsEnabled="False"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtCloseApps" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

              <!-- ── R7: Install Command | Uninstall Command (hidden until template folder set) ── -->
              <TextBlock x:Name="ExeLblInstallCmd" Grid.Row="7" Grid.Column="0"
                         Text="Install Command" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Grid x:Name="ExeGridInstallCmd" Grid.Row="7" Grid.Column="1" Height="28" Margin="0,0,0,6" Visibility="Collapsed">
                         <TextBox x:Name="ExeTxtInstallCmd"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtInstallCmd" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>
              <TextBlock x:Name="ExeLblUninstallCmd" Grid.Row="7" Grid.Column="3"
                         Text="Uninstall Command" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Grid x:Name="ExeGridUninstallCmd" Grid.Row="7" Grid.Column="4" Height="28" Margin="0,0,0,6" Visibility="Collapsed">
                         <TextBox x:Name="ExeTxtUninstallCmd"
                       Style="{StaticResource ModernTextBoxStyle}" FontSize="11"
                       Padding="6,0,20,0"
                         Height="28"/>
                         <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="18" Height="16" Margin="0,0,2,0" FontSize="9"
                                 Cursor="Hand" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Tag="ExeTxtUninstallCmd" Click="FieldClear_Click" ToolTip="Clear"/>
                       </Grid>

          </Grid>
        </ScrollViewer>
      </TabItem>

      </TabControl>

        <!-- ══ EVENT LOG - cmd-style window showing package-creation details ══ -->
        <Border Grid.Row="1" Margin="14,0,14,14" CornerRadius="6"
                MinHeight="240"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderMainBrush}"
                Background="#1E1E1E">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#2D2D30" CornerRadius="6,6,0,0" Padding="10,5">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="EVENT LOG" FontSize="11" FontWeight="Bold"
                           Foreground="#D4D4D4" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ScrollViewer x:Name="PkgEventLogScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="10,6">
              <TextBox x:Name="PkgEventLog"
                       Background="Transparent" BorderThickness="0"
                       Foreground="#D4D4D4" FontFamily="Consolas" FontSize="11"
                       IsReadOnly="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Disabled"
                       HorizontalScrollBarVisibility="Disabled"
                       Text="Waiting for package creation…"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border><!-- PkgContentCard -->
  </Grid>

</Page>
