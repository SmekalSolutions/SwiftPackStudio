<Page x:Class="SwiftPack.Views.CreateDocumentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBgBrush}"
      FontFamily="Segoe UI">
  <Page.Resources>
    <Style x:Key="SecHdr" TargetType="Border">
      <Setter Property="Background"   Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="CornerRadius" Value="6,6,0,0"/>
      <Setter Property="Padding"      Value="12,7"/>
      <Setter Property="Margin"       Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background"      Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="0,0,6,6"/>
      <Setter Property="Padding"         Value="12,12,12,8"/>
      <Setter Property="Margin"          Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize"          Value="11"/>
      <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Width"             Value="200"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin"            Value="0,0,12,0"/>
    </Style>
    <!-- One field per row: each field block gets a small bottom margin for spacing -->
    <Style x:Key="Field" TargetType="DockPanel">
      <Setter Property="LastChildFill" Value="True"/>
      <Setter Property="Margin"        Value="0,0,0,8"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize"   Value="12"/>
    </Style>
    <!-- ScrollBar with up/down arrows -->
    <Style x:Key="SbLineBtn" TargetType="RepeatButton">
      <Setter Property="Height"          Value="18"/>
      <Setter Property="Background"      Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Focusable"       Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SbPageBtn" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable"  Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SbThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="VertSB" TargetType="ScrollBar">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <RepeatButton Grid.Row="0" Style="{StaticResource SbLineBtn}"
                      Command="ScrollBar.LineUpCommand"
                      Content="▲" FontSize="8"/>
        <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource SbPageBtn}" Command="ScrollBar.PageUpCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource SbThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource SbPageBtn}" Command="ScrollBar.PageDownCommand"/>
          </Track.IncreaseRepeatButton>
        </Track>
        <RepeatButton Grid.Row="2" Style="{StaticResource SbLineBtn}"
                      Command="ScrollBar.LineDownCommand"
                      Content="▼" FontSize="8"/>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width"    Value="14"/>
          <Setter Property="Template" Value="{StaticResource VertSB}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- TextBox: rounded corners + watermark -->
    <Style TargetType="TextBox">
      <Setter Property="Height"                   Value="30"/>
      <Setter Property="Padding"                  Value="8,0"/>
      <Setter Property="FontSize"                 Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background"               Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"              Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness"          Value="1"/>
      <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="IsReadOnly"               Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}"
                           Margin="{TemplateBinding Padding}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{TemplateBinding FontSize}"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text"      Value=""/>
                  <Condition Property="IsFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Height"          Value="32"/>
      <Setter Property="Padding"         Value="16,0"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Background"      Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Height"          Value="32"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RadioPill" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Padding="10,5" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderMainBrush}"
                    Background="{DynamicResource InputBgBrush}" Cursor="Hand">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource NavIconQABrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Pinned header: title + actions, always visible -->
    <Border Grid.Row="0" Background="{DynamicResource PageBgBrush}" Padding="8,8,22,8">
      <Border Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
              CornerRadius="8" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Package Delivery Details" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Generate a Package Delivery Document. Fill in the fields and export." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="📄  Export .docx" Style="{StaticResource SecondaryBtn}" Click="BtnExportDocx_Click" Margin="0,0,8,0"/>
            <Button Content="📝  Export .txt" Style="{StaticResource SecondaryBtn}" Click="BtnExportTxt_Click" Margin="0,0,8,0"/>
            <Button Content="💾  Save"        Style="{StaticResource SecondaryBtn}" Click="BtnDocSave_Click"   Margin="0,0,8,0"/>
            <Button Content="📄  New"         Style="{StaticResource SecondaryBtn}" Click="BtnDocClear_Click"/>
            <Button Content="⚙  Settings"     Style="{StaticResource SecondaryBtn}" Click="BtnDocSettings_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,6">
      <StackPanel>
        <!-- ══ 2 REQUEST DETAILS ══════════════════════════════════════════ -->
        <Border Style="{StaticResource SecHdr}" Margin="0">
          <TextBlock Text="📋  Request Details" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Request Number"/>
              <TextBox x:Name="TxtRequestId" Tag="e.g. REQ-20260001"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Source Location"/>
              <TextBox x:Name="TxtSourceLocation"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Requestor Name &amp; Email"/>
              <TextBox x:Name="TxtRequestorName" Tag="Full name, email@company.com"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Application Owner Name &amp; Email"/>
              <TextBox x:Name="TxtAppOwner" Tag="Full name, email@company.com"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Department Name"/>
              <TextBox x:Name="TxtDepartment"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Country"/>
              <TextBox x:Name="TxtCountry"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <!-- ══ 1 PACKAGE INFORMATION ══════════════════════════════════════ -->
        <Border Style="{StaticResource SecHdr}">
          <TextBlock Text="📦  Package Information" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Package Name"/>
              <TextBox x:Name="TxtPackageName"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Application Name"/>
              <TextBox x:Name="TxtAppNameDisp"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Application Vendor"/>
              <TextBox x:Name="TxtVendorDisp"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Application Version"/>
              <TextBox x:Name="TxtVersionDisp"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Package Location"/>
              <TextBox x:Name="TxtSourceMedia"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Package Created By"/>
              <TextBox x:Name="TxtCreatedBy"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Package Validated By"/>
              <TextBox x:Name="TxtValidatedBy"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Close Applications"/>
              <TextBox x:Name="TxtCloseAppsDoc"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Shortcuts Created"/>
              <TextBox x:Name="TxtShortcutsDoc"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Install Log Path"/>
              <TextBox x:Name="TxtInstallLog"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Uninstall Log Path"/>
              <TextBox x:Name="TxtUninstallLog"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <!-- ══ 3 DEPLOYMENT CONFIGURATION ════════════════════════════════ -->
        <Border Style="{StaticResource SecHdr}">
          <TextBlock Text="⚙️  Deployment Configuration" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Intunewin File Name"/>
              <TextBox x:Name="TxtIntunewinName" Tag="Invoke-AppDeployToolkit.intunewin"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Intunewin File Size"/>
              <TextBox x:Name="TxtIntunewinSize" Tag="e.g. 43.8 MB"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Name (Intune App Name)"/>
              <TextBox x:Name="TxtIntuneName"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Publisher"/>
              <TextBox x:Name="TxtPublisher"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="App Version"/>
              <TextBox x:Name="TxtIntuneVersion"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Category"/>
              <TextBox x:Name="TxtCategory" Tag="e.g. Productivity"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="Description"/>
              <TextBox x:Name="TxtDescription" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Install Command"/>
              <TextBox x:Name="TxtInstallCmd"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Uninstall Command"/>
              <TextBox x:Name="TxtUninstallCmd"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Install Behaviour"/>
              <TextBox x:Name="TxtInstallBehaviour" Tag="System / User"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Operating System"/>
              <TextBox x:Name="TxtOSDisp"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="Detection Rules"/>
              <!-- Height sized to show the FULL MSI + File + Registry detection block
                   (~17 lines of Consolas 12) without scrolling; scrollbar stays as a
                   safety net but will not appear for the standard three-rule block. -->
              <TextBox x:Name="TxtDetectionTypeDoc" Height="300" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                       FontFamily="Consolas"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Dependencies"/>
              <TextBox x:Name="TxtDependencies" Tag="None"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Supersedence"/>
              <TextBox x:Name="TxtSupersedence" Tag="None"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Deployment Type"/>
              <TextBox x:Name="TxtDeploymentType" Tag="Available"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Assignment Group"/>
              <TextBox x:Name="TxtAssignmentGroup"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" Text="Package Completed On"/>
              <TextBox x:Name="TxtDateDisp"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="UAT Users"/>
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      CornerRadius="6" MinHeight="34" Padding="6,3"
                      Background="{DynamicResource InputBgBrush}">
                <WrapPanel x:Name="UatTagsPanel">
                  <TextBox x:Name="TxtUatInput" Width="180" Height="24"
                           BorderThickness="0" Background="Transparent"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           CaretBrush="{DynamicResource TextPrimaryBrush}"
                           VerticalContentAlignment="Center"
                           Tag="Type name, press Enter…"
                           KeyDown="TxtUatInput_KeyDown"/>
                </WrapPanel>
              </Border>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="Rollback Plan"/>
              <TextBox x:Name="TxtRollbackPlan" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <!-- ══ 4 OTHER DETAILS ════════════════════════════════════════════ -->
        <Border Style="{StaticResource SecHdr}">
          <TextBlock Text="📝  Other Details" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Style="{StaticResource Field}">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="Known Issues"/>
              <TextBox x:Name="TxtKnownIssues" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Tag="Leave blank if none"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Style="{StaticResource Lbl}" DockPanel.Dock="Left" VerticalAlignment="Top" Text="Additional Information"/>
              <TextBox x:Name="TxtAdditionalInfo" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <!-- Footer bar hidden; TxtDocStatus kept so code-behind status writes still resolve -->
    <Border Grid.Row="2" Visibility="Collapsed"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderMainBrush}"
            BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="TxtDocStatus" VerticalAlignment="Center"
                 FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Fill in the fields then export."/>
    </Border>
  </Grid>
</Page>
