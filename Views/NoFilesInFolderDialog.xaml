<Window x:Class="SwiftPack.Views.NoFilesInFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Intunewin — No Files in Folder"
        Width="460" MaxWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource BorderMainBrush}"
          BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ── Title bar ── -->
      <Border Grid.Row="0"
              Background="{DynamicResource NavBarBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0"
              Padding="16,6,12,6"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="☁" FontSize="14"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="1" Text="Create Intunewin — No Files in Folder"
                     FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="✕" FontSize="11"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  Background="Transparent" BorderThickness="0"
                  Cursor="Hand" VerticalAlignment="Center"
                  Padding="6,2,6,2" Click="BtnClose_Click"/>
        </Grid>
      </Border>

      <!-- ── Content ── -->
      <Grid Grid.Row="1" Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="62"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status row -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <Border Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6">
          <TextBlock Text="The source folder contains no files. IntuneWinAppUtil requires at least one file inside the folder."
                     FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <!-- Folder row -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Path"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <Border Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6">
          <TextBlock x:Name="TxtFolderPath" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas"/>
        </Border>

        <!-- OK button — full width of col 1 -->
        <UniformGrid Grid.Row="4" Grid.Column="1" Rows="1" Columns="1">
          <Button Content="✔ OK"
                  FontSize="11" FontWeight="SemiBold" Height="28"
                  Padding="6,0"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Click="BtnClose_Click" IsDefault="True"/>
        </UniformGrid>

      </Grid>
    </Grid>
  </Border>
</Window>
