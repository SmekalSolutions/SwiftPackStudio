<Page x:Class="SwiftPack.Views.AutoIntunewinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}"
      AllowDrop="True">
  <Page.Resources>

    <!-- APBtn — identical to AutoPackagePage for consistent look -->
    <Style x:Key="APBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <!-- Root fills whatever space AutoPackagePage gives via FrameIntunewin -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Package Paths card -->
      <RowDefinition Height="6"/>     <!-- gap -->
      <RowDefinition Height="*"/>     <!-- Event Log -->
    </Grid.RowDefinitions>

    <!-- ══ PACKAGE PATHS CARD ══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="6,6,6,0" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0">
          <TextBlock Text="PACKAGE PATHS" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="12,10,12,6"/>
        </Grid>

        <!-- Fields -->
        <Grid Grid.Row="1" Margin="12,0,12,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Source Folder -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Source Folder" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="IwTxtPackageFolderPath" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Margin="0"
                     AllowDrop="True" PreviewDragOver="IwTextBox_PreviewDragOver"
                     Drop="IwTxtPackageFolderPath_Drop"
                     TextChanged="IwTxtPackageFolderPath_TextChanged"
                     GotFocus="IwPathBox_GotFocus"/>
            <Button x:Name="IwBtnBrowseFolder" Grid.Column="2" Content="&#x1F4C1; Browse"
                    Style="{StaticResource APBtn}" Height="28" Margin="0"
                    Click="IwBtnBrowseFolder_Click"/>
          </Grid>

          <!-- Source File -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Source File" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="IwTxtSetupFile" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11" Margin="0"
                     AllowDrop="True" PreviewDragOver="IwTextBox_PreviewDragOver"
                     Drop="IwTxtSetupFile_Drop"
                     TextChanged="IwTxtSetupFile_TextChanged"
                     GotFocus="IwPathBox_GotFocus"/>
            <Button x:Name="IwBtnBrowseSetupFile" Grid.Column="2" Content="&#x1F4C4; Browse"
                    Style="{StaticResource APBtn}" Height="28" Margin="0"
                    Click="IwBtnBrowseSetupFile_Click"/>
          </Grid>

          <!-- Output Folder -->
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Output Folder" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="IwTxtOutputFolder" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                     Margin="0"
                     AllowDrop="True" PreviewDragOver="IwTextBox_PreviewDragOver"
                     Drop="IwTxtOutputFolder_Drop"
                     TextChanged="IwTxtOutputFolder_TextChanged"
                     GotFocus="IwPathBox_GotFocus"/>
            <Button x:Name="IwBtnBrowseOutputFolder" Grid.Column="2" Content="&#x1F4C1; Browse"
                    Style="{StaticResource APBtn}" Height="28" Margin="0"
                    Click="IwBtnBrowseOutputFolder_Click"/>
          </Grid>

          <!-- Intunewin File Name (full width; action buttons moved to Event Log header) -->
          <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Intunewin File Name" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBox x:Name="IwTxtIntunewinName" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                     Margin="0"
                     TextChanged="IwTxtIntunewinName_TextChanged"
                     AllowDrop="True" PreviewDragOver="IwTextBox_PreviewDragOver"
                     Drop="IwTxtIntunewinName_Drop"
                     GotFocus="IwPathBox_GotFocus"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- ══ EVENT LOG ══ -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="6,0,6,6" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="34"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                CornerRadius="10,10,0,0"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                Padding="12,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#x1F4CB;" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="EVENT LOG" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="IwBtnCancelCreate" Content="&#x2715; Cancel"
                      Style="{StaticResource APBtn}" Height="26" Margin="0,0,8,0"
                      IsEnabled="False" ToolTip="Cancel intunewin creation"
                      Click="IwBtnCancelCreate_Click"/>
              <Button x:Name="IwBtnCreate" Content="&#x2601; Create"
                      Style="{StaticResource APBtn}" Height="26" Margin="0"
                      IsEnabled="False" ToolTip="Create intunewin"
                      Click="IwBtnCreate_Click"/>
            </StackPanel>
            <Button x:Name="IwBtnClearLog" Content="&#x2715;" HorizontalAlignment="Right"
                    Style="{StaticResource APBtn}" Height="28" Margin="0"
                    ToolTip="Clear log"
                    Click="IwBtnClearLog_Click" VerticalAlignment="Center"
                    Visibility="Collapsed"/>
            <Button x:Name="IwBtnClearAll" Content="&#x1F5D1; Clear"
                    Style="{StaticResource APBtn}" Height="28" Margin="0"
                    ToolTip="Clear all fields" Click="IwBtnClearAll_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Visibility="Collapsed"/>
          </Grid>
        </Border>

        <Border Grid.Row="1" CornerRadius="0,0,10,10" Background="{DynamicResource LogPanelBgBrush}">
          <ScrollViewer x:Name="IwLogScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Background="Transparent">
            <TextBox x:Name="IwTxtEventLog"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11"
                     Foreground="{DynamicResource LogPanelFgBrush}"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     AcceptsReturn="True" Padding="14,10"
                     Text="[Ready] Select a Source Folder, Source File and Output Folder, then click Create…"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- Create-intunewin thin progress bar — OVERLAY pinned to the very top of the tab,
         matching the Download/Package/Publish tabs (does not push content). -->
    <ProgressBar x:Name="IwPrgCreateProgress"
                 Grid.Row="0" Grid.RowSpan="3"
                 Height="3" Minimum="0" Maximum="100" Value="0"
                 IsIndeterminate="True"
                 VerticalAlignment="Top" Margin="6,0,6,0"
                 Visibility="Collapsed"
                 BorderThickness="0"
                 Foreground="{DynamicResource AccentBlueBrush}"
                 Panel.ZIndex="1000"/>

  </Grid>
</Page>
