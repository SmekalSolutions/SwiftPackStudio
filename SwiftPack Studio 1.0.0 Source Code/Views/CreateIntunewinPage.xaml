<Page x:Class="SwiftPack.Views.CreateIntunewinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}" Title="Create Intunewin">

  <Page.Resources>
    <!-- CIBtn - matches PerformQA QABtn exactly -->
    <Style x:Key="CIBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- MAIN CONTENT - 8px all sides matching PerformQA -->
    <Grid Grid.Row="0" Margin="8,8,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- Package Paths card -->
        <RowDefinition Height="8"/>     <!-- gap -->
        <RowDefinition Height="*"/>     <!-- Event Log -->
      </Grid.RowDefinitions>

      <!-- Package Paths Card -->
      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header row with actions + progress bar overlay -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PACKAGE PATHS" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,6,12,6">
              <Button x:Name="BtnCancelCreate" Content="&#x2715; Cancel"
                      Style="{StaticResource CIBtn}" Height="28"
                      IsEnabled="False" ToolTip="Cancel intunewin"
                      Click="BtnCancelCreate_Click"/>
              <Button x:Name="BtnRefresh" Content="🆕 New"
                      Style="{StaticResource CIBtn}" Height="28"
                      ToolTip="Reset the fields for a new intunewin"
                      Click="BtnRefresh_Click"/>
              <Button x:Name="BtnCreate" Content="&#x2601; Create"
                      Style="{StaticResource CIBtn}" Height="28" Margin="0"
                      IsEnabled="False" ToolTip="Create intunewin"
                      Click="BtnCreate_Click"/>
            </StackPanel>
            <!-- Thin progress bar - overlaid on bottom edge of header -->
            <ProgressBar x:Name="PrgCreateProgress" Grid.ColumnSpan="2"
                         Height="3" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True"
                         VerticalAlignment="Bottom"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlueBrush}"/>
          </Grid>

          <!-- Content -->
          <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Source Folder -->
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Source Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
              </StackPanel>
              <TextBox x:Name="TxtPackageFolderPath" Grid.Column="1"
                       Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                       Tag="Browse for source folder&#x2026;" Margin="0,0,8,0"
                       AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver"
                       Drop="TxtPackageFolderPath_Drop"
                       TextChanged="TxtPackageFolderPath_TextChanged"
                       GotFocus="PathBox_GotFocus"/>
              <Button x:Name="BtnBrowseFolder" Grid.Column="2" Content="&#x1F4C1; Browse"
                      Style="{StaticResource CIBtn}" Height="28" Margin="0"
                      Click="BtnBrowseFolder_Click"/>
            </Grid>

            <!-- Source File -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Source File" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
              </StackPanel>
              <TextBox x:Name="TxtSetupFile" Grid.Column="1"
                       Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                       Tag="Browse for source file&#x2026;" Margin="0,0,8,0"
                       AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver"
                       Drop="TxtSetupFile_Drop"
                       TextChanged="TxtSetupFile_TextChanged"
                       GotFocus="PathBox_GotFocus"/>
              <Button x:Name="BtnBrowseSetupFile" Grid.Column="2" Content="&#x1F4C4; Browse"
                      Style="{StaticResource CIBtn}" Height="28" Margin="0"
                      Click="BtnBrowseSetupFile_Click"/>
            </Grid>

            <!-- Output Folder -->
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Output Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text=" *" Foreground="#F7584F" FontSize="11"/>
              </StackPanel>
              <TextBox x:Name="TxtOutputFolder" Grid.Column="1"
                       Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                       Tag="Browse or type the output folder path&#x2026;"
                       Margin="0,0,8,0"
                       AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver"
                       Drop="TxtOutputFolder_Drop"
                       TextChanged="TxtOutputFolder_TextChanged"
                       GotFocus="PathBox_GotFocus"/>
              <Button x:Name="BtnBrowseOutputFolder" Grid.Column="2" Content="&#x1F4C1; Browse"
                      Style="{StaticResource CIBtn}" Height="28" Margin="0"
                      Click="BtnBrowseOutputFolder_Click"/>
            </Grid>

            <!-- Intunewin File Name -->
            <Grid Grid.Row="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Intunewin File Name" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBox x:Name="TxtIntunewinName" Grid.Column="1"
                       Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                       Tag="Auto-filled from Package File - you may rename&#x2026;"
                       Margin="0,0,8,0"
                       TextChanged="TxtIntunewinName_TextChanged"
                       AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver"
                       Drop="TxtIntunewinName_Drop"
                       GotFocus="PathBox_GotFocus"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- Event Log -->
      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                  CornerRadius="10,10,0,0"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                  Padding="12,0">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x1F4CB;" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="EVENT LOG" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Border x:Name="BorderRunning" Background="#1A3ECFA0" BorderBrush="#3ECFA0"
                        BorderThickness="1" CornerRadius="4" Padding="8,2"
                        Margin="10,0,0,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x23F3;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRunningLabel" Text="Creating .intunewin &#x2014; please wait&#x2026;"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Button x:Name="BtnClearLog" Content="&#x2715;" HorizontalAlignment="Right"
                      Style="{StaticResource CIBtn}" Height="28" Margin="0"
                      ToolTip="Clear log"
                      Click="BtnClearLog_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" CornerRadius="0,0,10,10" Background="{DynamicResource LogPanelBgBrush}">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent">
              <TextBox x:Name="TxtEventLog"
                       Background="Transparent" BorderThickness="0"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource LogPanelFgBrush}"
                       IsReadOnly="True" TextWrapping="NoWrap"
                       AcceptsReturn="True" Padding="14,10"
                       Text="[Ready] Select a Source Folder, Source File and Output Folder, then click Create&#x2026;"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Page>
