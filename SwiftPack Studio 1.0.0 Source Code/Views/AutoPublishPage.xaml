<Page x:Class="SwiftPack.Views.AutoPublishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}">

  <Page.Resources>

    <!-- PDBtn — identical to PublishDeployPage -->
    <Style x:Key="PDBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Publish primary button (blue) -->
    <Style x:Key="PDBtnPrimary" TargetType="Button" BasedOn="{StaticResource PDBtn}">
      <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
    </Style>

    <!-- Tab button — inactive -->
    <Style x:Key="TabBtnStyle" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="34"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tab button — active -->
    <Style x:Key="TabBtnActiveStyle" TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent"
                    BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section label -->
    <Style x:Key="SectionLblStyle" TargetType="TextBlock">
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin"     Value="0,0,0,8"/>
    </Style>

    <!-- Field label -->
    <Style x:Key="FldLblStyle" TargetType="TextBlock">
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin"     Value="0,0,0,3"/>
    </Style>

    <!-- Add row button -->
    <Style x:Key="AddRowBtnStyle" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Height"          Value="26"/>
      <Setter Property="Padding"         Value="10,0"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TbBtnHoverBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Intunewin bar -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- Tab strip -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="*"/>     <!-- Tab content -->
    </Grid.RowDefinitions>

    <!-- ═══ INTUNEWIN FILE BAR ═══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="6,6,6,0" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><!-- Cancel -->
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Intunewin File" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

        <Grid Grid.Column="2" Margin="0,0,8,0">
          <TextBox x:Name="TxtIntunewinFile"
                   Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                   Padding="8,0,28,0"/>
          <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Width="22" Height="18" Margin="0,0,4,0" FontSize="10"
                  Cursor="Hand" BorderThickness="0" Background="Transparent"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  Click="BtnClearIntunewin_Click" ToolTip="Clear"/>
        </Grid>

        <Button Grid.Column="3" Content="📂 Browse"  Style="{StaticResource PDBtn}"
                Width="90" Click="BtnBrowseIntunewin_Click" ToolTip="Select intunewin file"
                Visibility="Collapsed"/>
        <Button Grid.Column="4" Content="☁ Publish"  Style="{StaticResource PDBtnPrimary}"
                x:Name="BtnPublish" Width="90" Click="BtnPublish_Click" ToolTip="Publish to Intune"/>
        <Button Grid.Column="5" Content="💾 Save"    Style="{StaticResource PDBtn}"
                x:Name="BtnSavePD" Width="90" Click="BtnSave_Click" ToolTip="Save JSON file"/>
        <Button Grid.Column="6" Content="🔄 Refresh" Style="{StaticResource PDBtn}"
                Width="90" Click="BtnRefresh_Click" ToolTip="Refresh"
                Visibility="Collapsed"/>
        <Button Grid.Column="7" Content="🗑 Clear"   Style="{StaticResource PDBtn}"
                Width="90" Margin="0" Click="BtnClear_Click" ToolTip="Clear fields"
                Visibility="Collapsed"/>
        <Button Grid.Column="8" Content="✕ Cancel"  Style="{StaticResource PDBtn}"
                x:Name="PdBtnCancel" Width="90" Margin="8,0,0,0" IsEnabled="False"
                Click="PdBtnCancel_Click" ToolTip="Cancel publish to Intune"/>
      </Grid>
    </Border>

    <!-- ═══ TAB STRIP ═══ -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="6,0,6,0" Padding="6,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnTab1" Content="1  App Info"      Style="{StaticResource TabBtnActiveStyle}" Click="Tab_Click" Tag="1"/>
          <Button x:Name="BtnTab2" Content="2  Program"       Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="2"/>
          <Button x:Name="BtnTab3" Content="3  Requirements"  Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="3"/>
          <Button x:Name="BtnTab4" Content="4  Detection"     Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="4"/>
          <Button x:Name="BtnTab5" Content="5  Dependencies"  Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="5"/>
          <Button x:Name="BtnTab6" Content="6  Supersedence"  Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="6"/>
          <Button x:Name="BtnTab7" Content="7  Assignments"   Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="7"/>
          <Button x:Name="BtnTab8" Content="8  Log"            Style="{StaticResource TabBtnStyle}"       Click="Tab_Click" Tag="8"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ TAB CONTENT ═══ -->
    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="6,0,6,6" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>

          <!-- ══ TAB 1: APP INFO ══ -->
          <StackPanel x:Name="Tab1" Visibility="Visible" Margin="14,10,14,10">

            <!-- Name | Description -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Name -->
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FldLblStyle}">
                  <Run Text="Name"/><Run Text=" *" Foreground="#F7584F"/>
                </TextBlock>
                <Grid>
                  <TextBox x:Name="TxtAppName" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>

              <!-- Description (spans 3 rows right) -->
              <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
                <TextBlock Style="{StaticResource FldLblStyle}">
                  <Run Text="Description"/><Run Text=" *" Foreground="#F7584F"/>
                </TextBlock>
                <Grid>
                  <TextBox x:Name="TxtDescription" Style="{StaticResource MultiLineTextBoxStyle}"
                           Height="105" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>

              <!-- Publisher -->
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FldLblStyle}">
                  <Run Text="Publisher"/><Run Text=" *" Foreground="#F7584F"/>
                </TextBlock>
                <Grid>
                  <TextBox x:Name="TxtAppVendor" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>

              <!-- App Version -->
              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="App version"/>
                <Grid>
                  <TextBox x:Name="TxtAppVersion" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>

              <!-- Category -->
              <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Category"/>
                <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBoxStyle}"
                          Height="28" FontSize="11">
                  <ComboBoxItem Content="(Not configured)" IsSelected="True"/>
                  <ComboBoxItem Content="Business"/>
                  <ComboBoxItem Content="Computer management"/>
                  <ComboBoxItem Content="Productivity"/>
                  <ComboBoxItem Content="Development tools"/>
                  <ComboBoxItem Content="Data management"/>
                  <ComboBoxItem Content="Utilities"/>
                  <ComboBoxItem Content="Photo &amp; video"/>
                  <ComboBoxItem Content="Other"/>
                </ComboBox>
              </StackPanel>

              <!-- Featured App -->
              <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Show this as a featured app"/>
                <ComboBox x:Name="CmbFeatured" Style="{StaticResource ModernComboBoxStyle}"
                          Height="28" FontSize="11">
                  <ComboBoxItem Content="No" IsSelected="True"/>
                  <ComboBoxItem Content="Yes"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <!-- Information URL | Privacy URL -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Information URL"/>
                <Grid>
                  <TextBox x:Name="TxtInfoUrl" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Privacy URL"/>
                <Grid>
                  <TextBox x:Name="TxtPrivacyUrl" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Developer | Owner -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Developer"/>
                <Grid>
                  <TextBox x:Name="TxtDeveloper" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Owner"/>
                <Grid>
                  <TextBox x:Name="TxtOwner" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Notes -->
            <StackPanel Margin="0,0,0,6">
              <TextBlock Style="{StaticResource FldLblStyle}" Text="Notes"/>
              <Grid>
                <TextBox x:Name="TxtNotes" Style="{StaticResource MultiLineTextBoxStyle}"
                         Height="54" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,0,28,0"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="FieldClear_PD_Click" ToolTip="Clear"/>
              </Grid>
            </StackPanel>

            <!-- Logo -->
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FldLblStyle}" Text="Logo (PNG, 512×512 recommended)"/>
                <Grid>
                  <TextBox x:Name="TxtIconPath" Style="{StaticResource ModernTextBoxStyle}"
                           Height="28" FontSize="11" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,4,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
              </StackPanel>
              <Button Grid.Column="2" Content="📂 Browse" Style="{StaticResource PDBtn}"
                      Height="28" VerticalAlignment="Bottom" Margin="8,0,0,0"
                      Click="BtnBrowseIcon_Click"/>
            </Grid>

          </StackPanel>

          <!-- ══ TAB 2: PROGRAM ══ -->
          <StackPanel x:Name="Tab2" Visibility="Collapsed" Margin="16,8,16,8">
            <StackPanel.Resources>
              <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="12"/>
                <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth"          Value="240"/>
                <Setter Property="Margin"            Value="0,0,12,0"/>
              </Style>
            </StackPanel.Resources>

            <!-- Install command -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" Text="Install command"/>
                <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Column="1">
                <TextBox x:Name="TxtInstallCmd" Style="{StaticResource ModernTextBoxStyle}"
                         Height="26" FontSize="11" Padding="8,0,28,0"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="22" Height="18" Margin="0,0,4,0" FontSize="10"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="FieldClear_PD_Click" ToolTip="Clear"/>
              </Grid>
            </Grid>

            <!-- Uninstall command -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" Text="Uninstall command"/>
                <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Column="1">
                <TextBox x:Name="TxtUninstallCmd" Style="{StaticResource ModernTextBoxStyle}"
                         Height="26" FontSize="11" Padding="8,0,28,0"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="22" Height="18" Margin="0,0,4,0" FontSize="10"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="FieldClear_PD_Click" ToolTip="Clear"/>
              </Grid>
            </Grid>

            <!-- Install time -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Installation time required (mins)"/>
              <Grid Grid.Column="1">
                <TextBox x:Name="TxtInstallTime" Style="{StaticResource ModernTextBoxStyle}"
                         Height="26" FontSize="11" Padding="8,0,28,0" Text="60"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="22" Height="18" Margin="0,0,4,0" FontSize="10"
                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="FieldClear_PD_Click" ToolTip="Clear"/>
              </Grid>
            </Grid>

            <!-- Allow available uninstall -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Allow available uninstall"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RbUninstallYes" GroupName="PubAllowUninstall"
                             Content="Yes" FontSize="11" Cursor="Hand" Margin="0,0,24,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RbUninstallNo" GroupName="PubAllowUninstall" IsChecked="True"
                             Content="No" FontSize="11" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Install behaviour -->
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Install behaviour"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RbInstallSystem" GroupName="PubInstallBehaviour" IsChecked="True"
                             Content="System" FontSize="11" Cursor="Hand" Margin="0,0,24,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RbInstallUser" GroupName="PubInstallBehaviour"
                             Content="User" FontSize="11" Cursor="Hand"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Device restart behaviour -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Device restart behaviour"/>
              <ComboBox x:Name="CmbRestartBehavior" Grid.Column="1"
                        Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                <ComboBoxItem Content="Determine behaviour based on return codes" IsSelected="True"/>
                <ComboBoxItem Content="No specific action"/>
                <ComboBoxItem Content="App install may force a device restart"/>
                <ComboBoxItem Content="Intune will force a mandatory device restart"/>
              </ComboBox>
            </Grid>
          </StackPanel>

          <!-- ══ TAB 3: REQUIREMENTS ══ -->
          <StackPanel x:Name="Tab3" Visibility="Collapsed" Margin="16,8,16,8">
            <StackPanel.Resources>
              <Style x:Key="ReqLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="12"/>
                <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width"             Value="260"/>
                <Setter Property="Margin"            Value="0,0,12,0"/>
              </Style>
            </StackPanel.Resources>

            <!-- Architecture -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           Text="Operating system architecture"/>
                <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkX86"   Content="32-bit" FontSize="11" Cursor="Hand" Margin="0,0,20,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="ChkX64"   Content="64-bit" FontSize="11" IsChecked="True" Cursor="Hand" Margin="0,0,20,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="ChkArm64" Content="ARM64"  FontSize="11" Cursor="Hand"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Minimum OS -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" Text="Minimum operating system"/>
                <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <ComboBox x:Name="CmbMinOs" Grid.Column="1"
                        Style="{StaticResource ModernComboBoxStyle}" Height="26" FontSize="11">
                <ComboBoxItem Content="Windows 10 1607"/>
                <ComboBoxItem Content="Windows 10 1703"/>
                <ComboBoxItem Content="Windows 10 1709"/>
                <ComboBoxItem Content="Windows 10 1803"/>
                <ComboBoxItem Content="Windows 10 1809"/>
                <ComboBoxItem Content="Windows 10 1903"/>
                <ComboBoxItem Content="Windows 10 1909"/>
                <ComboBoxItem Content="Windows 10 2004"/>
                <ComboBoxItem Content="Windows 10 20H2"/>
                <ComboBoxItem Content="Windows 10 21H1"/>
                <ComboBoxItem Content="Windows 10 21H2" IsSelected="True"/>
                <ComboBoxItem Content="Windows 10 22H2"/>
                <ComboBoxItem Content="Windows 11 21H2"/>
                <ComboBoxItem Content="Windows 11 22H2"/>
                <ComboBoxItem Content="Windows 11 23H2"/>
                <ComboBoxItem Content="Windows 11 24H2"/>
              </ComboBox>
            </Grid>
          </StackPanel>

          <!-- ══ TAB 4: DETECTION ══ -->
          <StackPanel x:Name="Tab4" Visibility="Collapsed" Margin="16,10,16,10">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
              <TextBlock Style="{StaticResource SectionLblStyle}" Text="RULES FORMAT"
                         VerticalAlignment="Center" Margin="0,0,16,0"/>
              <RadioButton x:Name="RbDetectManual" GroupName="PubDetectMethod" IsChecked="True"
                           Content="Manually configure detection rules" FontSize="11" Cursor="Hand"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,28,0"
                           Checked="DetectMethod_Changed"/>
              <RadioButton x:Name="RbDetectScript" GroupName="PubDetectMethod"
                           Content="Use a custom detection script" FontSize="11" Cursor="Hand"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Checked="DetectMethod_Changed"/>
            </StackPanel>

            <!-- Manual rules panel -->
            <StackPanel x:Name="PanelManualRules">
              <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                      Background="{DynamicResource CardBgBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                          CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Rule type" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="Details"   FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <StackPanel x:Name="DetectionRulesList" Grid.Row="1" Margin="8,8,8,0">
                    <TextBlock Text="No detection rules added." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,6"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <!-- Custom script panel -->
            <StackPanel x:Name="PanelDetectScript" Visibility="Collapsed">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0" Text="Script file"/>
                  <TextBlock Text="*" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <TextBox x:Name="TxtDetectScriptPath" Style="{StaticResource ModernTextBoxStyle}"
                           Height="26" FontSize="11"
                           Margin="0,0,6,0" Padding="8,0,28,0"/>
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="22" Height="18" Margin="0,4,10,0" FontSize="10"
                          Cursor="Hand" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Click="FieldClear_PD_Click" ToolTip="Clear"/>
                </Grid>
                <Button Grid.Column="2" Content="📂 Browse" Style="{StaticResource PDBtn}"
                        Height="28" Click="BtnBrowseDetectScript_Click"/>
              </Grid>

              <!-- Run as 32-bit -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Text="Run script as 32-bit process on 64-bit clients"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton x:Name="RbScript32No" GroupName="PubScriptBitness" IsChecked="True"
                               Content="No (default)" FontSize="11" Cursor="Hand" Margin="0,0,20,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <RadioButton x:Name="RbScript32Yes" GroupName="PubScriptBitness"
                               Content="Yes" FontSize="11" Cursor="Hand"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
              </Grid>

              <!-- Enforce signature check -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Text="Enforce script signature check"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton x:Name="RbSigNo" GroupName="PubScriptSig" IsChecked="True"
                               Content="No (default)" FontSize="11" Cursor="Hand" Margin="0,0,20,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <RadioButton x:Name="RbSigYes" GroupName="PubScriptSig"
                               Content="Yes" FontSize="11" Cursor="Hand"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
              </Grid>
            </StackPanel>

          </StackPanel>

          <!-- ══ TAB 5: DEPENDENCIES ══ -->
          <StackPanel x:Name="Tab5" Visibility="Collapsed" Margin="16,8,16,8">
            <TextBlock Style="{StaticResource SectionLblStyle}" Text="APP DEPENDENCIES" Margin="0,0,0,4"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       Text="Apps listed here must be installed before this app. Maximum 100 dependencies (including sub-dependencies)."/>
            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="26"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                        CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                  <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="160"/>
                      <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="App name"             FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Automatically install" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel x:Name="DependenciesList" Grid.Row="1" Margin="0,3,0,3">
                  <TextBlock Text="No dependencies added." FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="10,7"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- ══ TAB 6: SUPERSEDENCE ══ -->
          <StackPanel x:Name="Tab6" Visibility="Collapsed" Margin="16,8,16,8">
            <TextBlock Style="{StaticResource SectionLblStyle}" Text="SUPERSEDENCE" Margin="0,0,0,4"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       Text="This app will update or replace the apps listed below. Maximum 10 superseded apps. Setting 'Uninstall previous version' to Yes = Replace. No = Update."/>
            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="26"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                        CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                  <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="200"/>
                      <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="App name"                FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Uninstall previous version" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel x:Name="SupersedenceList" Grid.Row="1" Margin="0,3,0,3">
                  <TextBlock Text="No superseded apps added." FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="10,7"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- ══ TAB 7: ASSIGNMENTS ══ -->
          <StackPanel x:Name="Tab7" Visibility="Collapsed" Margin="16,8,16,8">
            <StackPanel.Resources>
              <Style x:Key="AssignLblStyle" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="11"/>
                <Setter Property="FontWeight"        Value="SemiBold"/>
                <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
            </StackPanel.Resources>

            <!-- AVAILABLE -->
            <TextBlock Style="{StaticResource SectionLblStyle}" Text="AVAILABLE FOR ENROLLED DEVICES" Margin="0,0,0,2"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" TextWrapping="Wrap"
                       Text="App appears in Company Portal. Users choose to install it."/>
            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,4">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="26"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}"
                        CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Group" Style="{StaticResource AssignLblStyle}"/>
                    <TextBlock Grid.Column="1" Text="Mode"  Style="{StaticResource AssignLblStyle}"/>
                  </Grid>
                </Border>
                <StackPanel x:Name="AvailableList" Grid.Row="1" Margin="0,3,0,3">
                  <TextBlock Text="No groups added." FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="8,6"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- ══ TAB 8: LOG ══ -->
          <StackPanel x:Name="Tab8" Visibility="Collapsed">
            <Border Background="#FF1E1E1E" CornerRadius="4" Margin="8,8,8,8" MinHeight="400">
              <TextBox x:Name="LogTextBox"
                       IsReadOnly="True"
                       Background="Transparent"
                       BorderThickness="0"
                       FontFamily="Consolas, Courier New"
                       FontSize="11"
                       Foreground="#FFCCCCCC"
                       Padding="12,10,12,10"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       MinHeight="400"/>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Border>

    <!-- ── Publish-to-Intune thin progress bar — OVERLAY (does not push content) ──
         Pinned to the top, spans all rows, matches the Package-tab accent. -->
    <ProgressBar x:Name="PublishProgressBar"
                 Grid.Row="0" Grid.RowSpan="5"
                 Height="3" Minimum="0" Maximum="100" IsIndeterminate="True"
                 VerticalAlignment="Top" Margin="6,0,6,0"
                 Foreground="{DynamicResource AccentBlueBrush}"
                 BorderThickness="0"
                 Visibility="Collapsed"
                 Panel.ZIndex="1000"/>

  </Grid>
</Page>
