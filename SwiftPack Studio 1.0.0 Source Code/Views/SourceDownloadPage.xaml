<Page x:Class="SwiftPack.Views.SourceDownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBgBrush}"
      FontFamily="Segoe UI">

  <Page.Resources>
    <!-- Category chip style -->
    <Style x:Key="ChipStyle" TargetType="Button">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Active chip style — clearly visible accent background, text colour unchanged -->
    <Style x:Key="ChipActiveStyle" TargetType="Button" BasedOn="{StaticResource ChipStyle}">
      <Setter Property="Background" Value="#DDE0F5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- App card style -->
    <Style x:Key="AppCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Action button style -->
    <Style x:Key="ActionBtnStyle" TargetType="Button">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded TextBox style for Package Information panel -->
    <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded ComboBox style for Package Information panel -->
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="border"
                      Background="{DynamicResource InputBgBrush}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="▾" FontSize="16" FontWeight="Bold"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Opacity="0"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Slide"
                     Placement="Bottom">
                <Border Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource BorderMainBrush}"
                        BorderThickness="1" CornerRadius="4"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- toolbar card -->
      <RowDefinition Height="*"/>      <!-- main content -->
    </Grid.RowDefinitions>

    <!-- ── Toolbar ── -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="6,6,6,0" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="225"/>   <!-- vendor column width only -->
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>  <!-- Cancel button (visible during silent install/uninstall) -->
          <ColumnDefinition Width="Auto"/>  <!-- Settings button -->
          <ColumnDefinition Width="Auto"/>  <!-- Updates button -->
          <ColumnDefinition Width="Auto"/>  <!-- Add App button -->
        </Grid.ColumnDefinitions>

        <!-- Search box with ✕ clear button -->
        <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,0" Margin="0,0,12,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"
                         IsHitTestVisible="False"/>
              <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                       FontSize="11" Height="28" Padding="18,0,0,0" VerticalContentAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Tag="Search Application"
                       TextChanged="TxtSearch_TextChanged"/>
              <TextBlock x:Name="TxtSearchPlaceholder" Text="Search Application"
                         FontSize="11" VerticalAlignment="Center" Padding="20,0,0,0"
                         Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
            </Grid>
            <!-- Clear button — only visible when search has text -->
            <Button x:Name="BtnClearSearch" Grid.Column="1"
                    Content="✕" FontSize="11" Width="20" Height="20"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Cursor="Hand" Visibility="Collapsed"
                    Click="BtnClearSearch_Click"
                    ToolTip="Clear search"/>
          </Grid>
        </Border>

        <!-- All button + Category filter chips -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnChipAll" Content="All"
                    Style="{StaticResource ChipActiveStyle}"
                    Click="BtnChipAll_Click"/>
            <StackPanel x:Name="PnlCategories" Orientation="Horizontal" VerticalAlignment="Center"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Cancel button — visible only during silent Install/Uninstall source -->
        <Button x:Name="BtnCancelSilent" Grid.Column="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Content="✕  Cancel" Margin="0,0,8,0"
                Height="30" Padding="10,0" VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="BtnCancelSilent_Click"
                ToolTip="Cancel the running silent install/uninstall"/>

        <!-- Cancel button — visible only during download (sits before Refresh) -->
        <Button x:Name="BtnCancelDownloadTop" Grid.Column="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Content="✕  Cancel" Margin="0,0,8,0"
                Height="30" Padding="10,0" VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="BtnCancelDownload_Click"
                ToolTip="Cancel the running download"/>

        <!-- Settings button - opens the AutoPackage.json settings editor -->
        <Button x:Name="BtnSettings" Grid.Column="3"
                Style="{StaticResource ActionBtnStyle}"
                Content="⚙  Settings" Margin="0,0,8,0"
                Height="30" Padding="10,0" VerticalAlignment="Center"
                Click="BtnSettings_Click"
                ToolTip="Edit global settings (AutoPackage.json)"/>

        <!-- Updates button - opens the Downloads window (Missed Schedules / Updates Available)
             on demand. Content is set in code so it can carry the live count. -->
        <Button x:Name="BtnUpdates" Grid.Column="4"
                Style="{StaticResource ActionBtnStyle}"
                Content="⬆  Updates" Margin="0,0,8,0"
                Height="30" Padding="10,0" VerticalAlignment="Center"
                Click="BtnUpdates_Click"
                ToolTip="Apps with a newer version available"/>

        <!-- Add App button -->
        <Button x:Name="BtnAddApp" Grid.Column="5"
                Style="{StaticResource ActionBtnStyle}"
                Content="＋  Add App" Margin="0"
                Click="BtnAddApp_Click"
                ToolTip="Add a new app to the catalog"/>
      </Grid>
    </Border>

    <!-- ── Main content ── -->
    <Grid Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="462" MinWidth="462"/>  <!-- 6(margin-L) + 225(vendor) + 6(gap) + 225(app) -->
        <ColumnDefinition Width="237" MinWidth="237"/>  <!-- Download Information — 225px card + 12px margins -->
        <ColumnDefinition Width="*"/>                   <!-- Package Information — takes remaining space -->
      </Grid.ColumnDefinitions>

      <!-- ── LEFT: Vendor | Application ── -->
      <Grid Grid.Column="0" Margin="6,0,0,6" ClipToBounds="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="225"/>  <!-- Vendor — fixed 225px -->
          <ColumnDefinition Width="6"/>    <!-- 6px gap -->
          <ColumnDefinition Width="225"/>  <!-- Application — fixed 225px -->
        </Grid.ColumnDefinitions>

        <!-- Vendor column card -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
          <Grid Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource NavBarBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
              <TextBlock Text="Vendor" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ScrollViewer x:Name="SvVendors" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
              <StackPanel x:Name="PnlVendors" Margin="0,8,0,4"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Application column card -->
        <Border Grid.Column="2"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
          <Grid Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource NavBarBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
              <TextBlock Text="Application" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ScrollViewer x:Name="SvCards" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
              <StackPanel x:Name="PnlCards" Margin="0,8,0,4"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ── CENTRE: Download Information Panel ── -->
      <Border Grid.Column="1" Margin="6,0,3,6"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
              CornerRadius="8" ClipToBounds="True">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header title -->
            <RowDefinition Height="*"/>      <!-- info content -->
            <RowDefinition Height="Auto"/>   <!-- download progress footer -->
          </Grid.RowDefinitions>

        <!-- Header — title only (progress moved to bottom footer) -->
        <Border Grid.Row="0" Background="{DynamicResource NavBarBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0" Height="34" Padding="10,0">
          <Grid x:Name="PnlHeaderContent">
            <TextBlock x:Name="TxtInfoTitle" Text="Download Information"
                       FontSize="11" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Visible"/>
          </Grid>
        </Border>

        <!-- Info content area -->
        <ScrollViewer x:Name="SvInfo" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
          <StackPanel x:Name="PnlInfoContent">
            <StackPanel x:Name="PnlInfoPlaceholder" HorizontalAlignment="Center" Margin="0,60,0,0"/>
            <StackPanel x:Name="PnlAppInfo" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ── Download progress FOOTER (bottom of column) — shown only while downloading ── -->
        <Border x:Name="PnlHeaderProgress" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource NavBarBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8" Padding="10,6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- label -->
                <ColumnDefinition Width="*"/>      <!-- status (truncates) -->
                <ColumnDefinition Width="Auto"/>   <!-- pause -->
                <ColumnDefinition Width="Auto"/>   <!-- cancel -->
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TxtProgressLabel" Grid.Column="0"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="TxtProgressStatus" Grid.Column="1"
                         FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Margin="8,0,6,0"/>
              <Button x:Name="BtnPauseDownload" Grid.Column="2"
                      Content="❚❚" FontSize="10"
                      Background="{DynamicResource InputBgBrush}"
                      Width="22" Height="22" Padding="0" Margin="0,0,4,0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Cursor="Hand"
                      ToolTip="Pause download"
                      Click="BtnPauseDownload_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BorderMainBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="BtnCancelDownload" Grid.Column="3"
                      Content="✕" FontSize="11"
                      Background="{DynamicResource InputBgBrush}"
                      Width="22" Height="22" Padding="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Cursor="Hand"
                      ToolTip="Cancel download"
                      Click="BtnCancelDownload_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BorderMainBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
            <ProgressBar x:Name="HeaderProgressBar" Grid.Row="1"
                         Height="6" Minimum="0" Maximum="100" Value="0"
                         Foreground="{DynamicResource AccentBlueBrush}"
                         Background="{DynamicResource BorderMainBrush}"
                         BorderThickness="0"/>
          </Grid>
        </Border>

        <!-- ── Auto-flow STATUS panel (bottom of column) — shown after the flow completes ── -->
        <Border x:Name="PnlAutoFlowStatus" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource NavBarBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8" Padding="10,8">
          <StackPanel x:Name="PnlAutoFlowStatusItems"/>
        </Border>
        </Grid>
      </Border>

      <!-- ── RIGHT: Package Information Panel — fixed 220px sidebar ── -->
      <Border Grid.Column="2" Margin="3,0,6,6"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
              CornerRadius="8" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>   <!-- section tab strip -->
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Border Grid.Row="0" Background="{DynamicResource NavBarBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                  CornerRadius="8,8,0,0" Height="34" Padding="10,0">
            <TextBlock Text="Package Information" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <!-- Section tab strip: App Information / Package settings / Intune settings.
               The three buttons are built in code (BuildPackageInfoTabStrip) so their active
               styling can follow the selected tab. Hidden until the first app renders. -->
          <Border x:Name="PkgTabStripHost" Grid.Row="1" Visibility="Collapsed"
                  Background="{DynamicResource NavBarBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1"
                  Padding="8,6"/>

          <!-- Checkboxes — built dynamically by RenderInfoPanel via PnlPackageInfo -->
          <ScrollViewer x:Name="SvPackage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
            <StackPanel x:Name="PnlPackageInfo"/>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>

    <!-- ── Silent Install/Uninstall thin progress bar — OVERLAY (does not push content) ──
         Placed last so it renders on top; spans both rows and pins to the very top.
         Matches the Package tab's progress bar (AccentBlueBrush, 3px). -->
    <ProgressBar x:Name="TopSilentProgressBar"
                 Grid.Row="0" Grid.RowSpan="2"
                 Height="3" Minimum="0" Maximum="100" IsIndeterminate="True"
                 VerticalAlignment="Top" Margin="6,0,6,0"
                 Foreground="{DynamicResource AccentBlueBrush}"
                 BorderThickness="0"
                 Visibility="Collapsed"
                 Panel.ZIndex="1000"/>
  </Grid>
</Page>
