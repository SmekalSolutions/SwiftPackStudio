<Page x:Class="SwiftPack.Views.AutoExecutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}" Title="Auto Execute">

  <Page.Resources>
    <!-- EPBtn — exact copy from ExecutePackagePage -->
    <Style x:Key="EPBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Log source tabs (Install / Uninstall) shown next to the EVENT LOG title. -->
    <Style x:Key="LogTabBtn" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="22"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="6,0,0,0"/>
      <Setter Property="Padding"         Value="12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Applied on top of LogTabBtn (via code-behind) to mark the selected tab. -->
    <Style x:Key="LogTabBtnActive" TargetType="Button" BasedOn="{StaticResource LogTabBtn}">
      <Setter Property="Background"  Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
    </Style>
  </Page.Resources>

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ══ PSADT COMMAND TOOLBAR ══ -->
      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="6,6,6,0" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- PSADT Install (was Script File) -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="PSADT Install" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text=" *" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="TxtScriptPath" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                     Margin="0,0,8,0"/>
            <Button x:Name="BtnBrowse" Grid.Column="2" Content="📄 Browse"
                    Style="{StaticResource EPBtn}" Height="28" MinWidth="88" Margin="0,0,6,0"
                    Click="BtnBrowse_Click"/>
            <Button x:Name="BtnClear" Grid.Column="3" Content="✕ Clear"
                    Style="{StaticResource EPBtn}" Height="28" MinWidth="82" Margin="0,0,6,0"
                    Click="BtnClear_Click"/>
            <Button x:Name="BtnCancelHeader" Grid.Column="4" Content="✕ Cancel"
                    Style="{StaticResource EPBtn}" Height="28" MinWidth="82" Margin="0"
                    IsEnabled="False"
                    Click="BtnCancelHeader_Click"/>
          </Grid>

          <!-- PSADT Uninstall -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="PSADT Uninstall" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <TextBox x:Name="TxtPsadtUninstall" Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                     Margin="0,0,8,0"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ══ TWO CONTEXT BOXES ══ -->
      <Grid Grid.Row="2" Margin="6,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ADMINISTRATOR -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource FooterBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="🛡️" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="ADMINISTRATOR" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ProgressBar x:Name="PrgAdminProgress" Grid.Row="0"
                         Height="3" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True" VerticalAlignment="Bottom"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlueBrush}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="12,12,12,12">
              <Button x:Name="BtnAdminInstall"   Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0,0,8,0"
                      Content="▶  Install"   Click="BtnAdminInstall_Click"/>
              <Button x:Name="BtnAdminUninstall" Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0,0,8,0"
                      Content="◀  Uninstall" Click="BtnAdminUninstall_Click"/>
              <Button x:Name="BtnAdminRepair"    Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0"
                      Content="🔧  Repair"   Click="BtnAdminRepair_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- SYSTEM CONTEXT -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource FooterBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="⚙️" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="SYSTEM CONTEXT" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ProgressBar x:Name="PrgSystemProgress" Grid.Row="0"
                         Height="3" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True" VerticalAlignment="Bottom"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlueBrush}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="12,12,12,12">
              <Button x:Name="BtnSystemInstall"   Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0,0,8,0"
                      Content="▶  Install"   Click="BtnSystemInstall_Click"/>
              <Button x:Name="BtnSystemUninstall" Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0,0,8,0"
                      Content="◀  Uninstall" Click="BtnSystemUninstall_Click"/>
              <Button x:Name="BtnSystemRepair"    Style="{StaticResource EPBtn}" Height="28" Width="120" Margin="0"
                      Content="🔧  Repair"   Click="BtnSystemRepair_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ══ EVENT LOG ══ -->
      <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="6,0,6,6" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}" CornerRadius="10,10,0,0"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="EVENT LOG" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <!-- Install / Uninstall log tabs: each keeps its own buffer so the install
                     output is still viewable after an uninstall run (and vice-versa). -->
                <Button x:Name="BtnLogTabInstall"   Content="Install"   Style="{StaticResource LogTabBtn}"
                        VerticalAlignment="Center" Click="BtnLogTabInstall_Click"/>
                <Button x:Name="BtnLogTabUninstall" Content="Uninstall" Style="{StaticResource LogTabBtn}"
                        VerticalAlignment="Center" Click="BtnLogTabUninstall_Click"/>
                <Border x:Name="BorderExecRunning" Background="{DynamicResource RunningBadgeBgBrush}"
                        CornerRadius="4" Margin="10,0,0,0" Padding="7,2" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtExecRunning" Text="Running…"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnClearLog" Content="🗑 Clear"
                        Style="{StaticResource EPBtn}" Height="28" Margin="0"
                        Click="BtnClearLog_Click"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" CornerRadius="0,0,10,10" Background="{DynamicResource LogPanelBgBrush}">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent">
              <TextBox x:Name="TxtEventLog"
                       Background="Transparent" BorderThickness="0"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource LogPanelFgBrush}"
                       IsReadOnly="True" TextWrapping="NoWrap"
                       AcceptsReturn="True" Padding="14,10,14,10"
                       Text="[Ready] Select a script file and click a Install / Uninstall / Repair button…"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

    </Grid>

    <!-- Hidden controls kept for code-behind compatibility -->
    <Grid Grid.Row="1" Height="0" Visibility="Collapsed">
      <TextBlock x:Name="TxtAdminRunning"/>
      <TextBlock x:Name="TxtSystemRunning"/>
      <Border x:Name="BorderAdminRunning"/>
      <Border x:Name="BorderSystemRunning"/>
    </Grid>

    <!-- Top thin progress bar — same position as the Download tab (just under the tab
         strip), shown during Install/Uninstall instead of the per-context header bars. -->
    <ProgressBar x:Name="ExecTopProgressBar"
                 Grid.Row="0" Grid.RowSpan="2"
                 Height="3" Minimum="0" Maximum="100" IsIndeterminate="True"
                 VerticalAlignment="Top" Margin="6,0,6,0"
                 Foreground="{DynamicResource AccentBlueBrush}"
                 BorderThickness="0"
                 Visibility="Collapsed"
                 Panel.ZIndex="1000"/>

  </Grid>
</Page>
