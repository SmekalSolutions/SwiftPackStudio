<Page x:Class="SwiftPack.Views.ExecutePackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}" Title="Execute Package">

  <Page.Resources>
    <!-- EPBtn — matches PerformQA QABtn exactly -->
    <Style x:Key="EPBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderInputBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="28"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavBarBgBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
              </Trigger>
              <!-- Active deployment highlight — set via Tag while the action is running.
                   Placed AFTER the IsEnabled trigger so Opacity=1.0 wins while disabled. -->
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource AccentBlueBrush}"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter TargetName="Bg" Property="Opacity"     Value="1.0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Main content — 8px all sides matching PerformQA -->
    <Grid Grid.Row="0" Margin="8,8,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- Script file toolbar -->
        <RowDefinition Height="8"/>     <!-- gap -->
        <RowDefinition Height="Auto"/>  <!-- Two context boxes -->
        <RowDefinition Height="8"/>     <!-- gap -->
        <RowDefinition Height="*"/>     <!-- Event log -->
      </Grid.RowDefinitions>

      <!-- ══ SCRIPT FILE TOOLBAR — matches PerformQA toolbar card ══ -->
      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- PSADT Install -->
            <RowDefinition Height="6"/>     <!-- gap -->
            <RowDefinition Height="Auto"/>  <!-- PSADT Uninstall -->
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- Label -->
            <ColumnDefinition Width="*"/>     <!-- Textbox (fills the row) -->
            <ColumnDefinition Width="Auto"/>  <!-- Browse -->
            <ColumnDefinition Width="Auto"/>  <!-- New / Cancel -->
            <ColumnDefinition Width="Auto"/>  <!-- Settings / Clear -->
          </Grid.ColumnDefinitions>

          <!-- ── PSADT Install row ── -->
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="PSADT Install" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text=" *" Foreground="#F7584F" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBox x:Name="TxtScriptPath" Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                   Tag="PSADT install command"
                   Margin="0,0,8,0"
                   HorizontalScrollBarVisibility="Hidden"
                   TextChanged="TxtScriptPath_TextChanged"
                   AllowDrop="True" Drop="ScriptPath_Drop"
                   PreviewDragOver="ScriptPath_DragOver"/>
          <Button x:Name="BtnBrowse" Grid.Row="0" Grid.Column="2" Content="📄 Browse"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="88" Margin="0,0,6,0"
                  Click="BrowseScript_Click"/>
          <Button x:Name="BtnClearPath" Grid.Row="0" Grid.Column="3" Content="🆕 New"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="88" Margin="0,0,6,0"
                  ToolTip="Start over"
                  Click="BtnClearPath_Click"/>
          <Button x:Name="BtnExecSettings" Grid.Row="0" Grid.Column="4" Content="⚙ Settings"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="92" Margin="0"
                  ToolTip="Edit ExecutePackage.json settings"
                  Click="BtnExecSettings_Click"/>

          <!-- ── PSADT Uninstall row ── -->
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="PSADT Uninstall" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <TextBox x:Name="TxtUninstallPath" Grid.Row="2" Grid.Column="1"
                   Style="{StaticResource ModernTextBoxStyle}" Height="28" FontSize="11"
                   Tag="PSADT uninstall command…"
                   Margin="0,0,8,0"
                   HorizontalScrollBarVisibility="Hidden"/>
          <Button x:Name="BtnBrowseUninstall" Grid.Row="2" Grid.Column="2" Content="📄 Browse"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="88" Margin="0,0,6,0"
                  ToolTip="Select Invoke-AppDeployToolkit.ps1"
                  Click="BrowseScript_Click"/>
          <Button x:Name="BtnCancelHeader" Grid.Row="2" Grid.Column="3" Content="✕ Cancel"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="88" Margin="0,0,6,0"
                  ToolTip="Cancel running script" IsEnabled="False"
                  Click="BtnCancel_Click"/>
          <Button x:Name="BtnClearLog" Grid.Row="2" Grid.Column="4" Content="🗑 Clear"
                  Style="{StaticResource EPBtn}" Height="28" MinWidth="92" Margin="0"
                  ToolTip="Clear log"
                  Click="BtnClearLog_Click"/>
        </Grid>
      </Border>

      <!-- ══ TWO CONTEXT BOXES — 8px gap, equal width ══ -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ADMINISTRATOR BOX -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>   <!-- header — matches PerformQA -->
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header — same grey as PerformQA column headers -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource FooterBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="🛡" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="ADMINISTRATOR" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <!-- Thin progress bar — overlaid on bottom edge of header -->
            <ProgressBar x:Name="PrgAdminProgress"
                         Grid.Row="0"
                         Height="3" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True"
                         VerticalAlignment="Bottom"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlueBrush}"/>
            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="12,12,12,12">
              <Button x:Name="BtnAdminInstall" Click="BtnAdminInstall_Click"
                      Style="{StaticResource EPBtn}" Height="28" Content="▶  Install"/>
              <Button x:Name="BtnAdminUninstall" Click="BtnAdminUninstall_Click"
                      Style="{StaticResource EPBtn}" Height="28" Content="◀  Uninstall"/>
              <Button x:Name="BtnAdminRepair" Click="BtnAdminRepair_Click"
                      Style="{StaticResource EPBtn}" Height="28" Margin="0" Content="🔧  Repair"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- SYSTEM CONTEXT BOX -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>   <!-- header — matches PerformQA -->
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    Background="{DynamicResource FooterBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="⚙" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="SYSTEM CONTEXT" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <!-- Thin progress bar — overlaid on bottom edge of header -->
            <ProgressBar x:Name="PrgSystemProgress"
                         Grid.Row="0"
                         Height="3" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True"
                         VerticalAlignment="Bottom"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBlueBrush}"/>
            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="12,12,12,12">
              <Button x:Name="BtnSystemInstall" Click="BtnSystemInstall_Click"
                      Style="{StaticResource EPBtn}" Height="28" Content="▶  Install"/>
              <Button x:Name="BtnSystemUninstall" Click="BtnSystemUninstall_Click"
                      Style="{StaticResource EPBtn}" Height="28" Content="◀  Uninstall"/>
              <Button x:Name="BtnSystemRepair" Click="BtnSystemRepair_Click"
                      Style="{StaticResource EPBtn}" Height="28" Margin="0" Content="🔧  Repair"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ══ EVENT LOG ══ -->
      <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>   <!-- header — matches PerformQA -->
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Log header -->
          <Border Grid.Row="0" Background="{DynamicResource FooterBgBrush}" CornerRadius="10,10,0,0"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="EVENT LOG" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <!-- Install / Uninstall log tabs: each keeps its own buffer so the install output
                     stays viewable after an uninstall run (and vice-versa). -->
                <Button x:Name="BtnLogTabInstall"   Content="Install"   Style="{StaticResource EPBtn}"
                        Height="22" MinWidth="72" Margin="10,0,0,0" FontSize="11"
                        VerticalAlignment="Center" Click="BtnLogTabInstall_Click"/>
                <Button x:Name="BtnLogTabUninstall" Content="Uninstall" Style="{StaticResource EPBtn}"
                        Height="22" MinWidth="72" Margin="4,0,0,0" FontSize="11"
                        VerticalAlignment="Center" Click="BtnLogTabUninstall_Click"/>
                <Border x:Name="BorderExecRunning" Background="{DynamicResource RunningBadgeBgBrush}"
                        CornerRadius="4" Margin="10,0,0,0" Padding="7,2" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtExecRunning" Text="Running…"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Terminal log -->
          <Border Grid.Row="1" CornerRadius="0,0,10,10" Background="{DynamicResource LogPanelBgBrush}">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent">
              <TextBox x:Name="TxtEventLog"
                       Background="Transparent" BorderThickness="0"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource LogPanelFgBrush}"
                       CaretBrush="{DynamicResource AccentBlueBrush}"
                       IsReadOnly="True" TextWrapping="NoWrap"
                       AcceptsReturn="True" Padding="14,10,14,10"
                       Text="[Ready] Select a script file and click a Install / Uninstall / Repair button…"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

    </Grid>

    <!-- Progress/status — hidden, kept for code-behind compatibility -->
    <Grid Grid.Row="1" Height="0" Visibility="Collapsed">
      <StackPanel x:Name="PanelExecProgress" Visibility="Collapsed">
        <TextBlock x:Name="TxtExecProgressLabel"/>
        <ProgressBar x:Name="ExecProgressBar" Height="4" IsIndeterminate="True" BorderThickness="0"/>
      </StackPanel>
      <TextBlock x:Name="TxtExecStatus"/>
    </Grid>

  </Grid>
</Page>
