<Page x:Class="SwiftPack.Views.EditMSIPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBgBrush}"
      FontFamily="Segoe UI"
      Title="Edit MSI">
    <Page.Resources>
        <!-- One look for every node icon in the Visual view: the categories list and the
             Files, Registry, Shortcuts and Features trees beside it. Each use supplies only
             the Data and the Stroke, so the shapes stay a fixed size and weight throughout. -->
        <Style x:Key="TreeNodeIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Segmented Form/Tables toggle. Active state is driven by Tag="Active"
             with DynamicResource brushes so it stays correct across theme changes
             (capturing brushes in code left the inactive button's text invisible). -->
        <Style x:Key="SegToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             BorderThickness="0" Background="Transparent" Margin="4,0,0,0"
                                             Foreground="{TemplateBinding Foreground}"
                                             VerticalContentAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="▾" FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderMainBrush}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="180" MaxHeight="220">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="IsEditable" Value="True"/>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#556C63FF"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Clean, list-style header and cell for the friendly Files grid (no cell
             gridlines; a single underline below the header row). -->
        <Style x:Key="FilesHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMainBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="FilesCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#556C63FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilesRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>

        <!-- Shared GridView row template for the bottom ListViews. The default
             Windows selection paints a light highlight that hides light dark-mode
             text; this keeps hover/selection readable in both themes. -->
        <ControlTemplate x:Key="GvItemTemplate" TargetType="ListViewItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="2,2"
                    SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        Columns="{Binding View.Columns,
                                  RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                        TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="GvItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource GvItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22808080"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#556C63FF"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Enable touch / precision-touchpad panning (both directions) on every
             scroll area. WPF delivers precision-touchpad two-finger scroll as
             manipulation input, which a ScrollViewer ignores unless PanningMode is
             set; the default (None) is why touchpad scrolling does nothing. An
             implicit style reaches the internal scrollviewers of the data grid and
             the lists. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="Both"/>
            <Setter Property="PanningDeceleration" Value="0.001"/>
        </Style>
        <!-- Rounded check boxes. The stock WPF box is a square with a system-drawn
             tick that ignores the page's brushes, so it read as a leftover from a
             different application next to the rounded buttons and inputs. Implicit,
             so every check box on the page picks it up rather than the handful that
             happened to be restyled. The indeterminate state gets a bar rather than
             a tick, since a three-state box that showed nothing would be
             indistinguishable from an unchecked one. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="5"
                                    BorderThickness="1" SnapsToDevicePixels="True"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource BorderMainBrush}">
                                <Grid>
                                    <Path x:Name="tick" Visibility="Collapsed"
                                          Data="M0,4 L3.5,7.5 L10,0.5" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <Rectangle x:Name="dash" Visibility="Collapsed"
                                               Width="8" Height="2" RadiusX="1" RadiusY="1"
                                               Fill="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box"  Property="Background"  Value="#7C6CF0"/>
                                <Setter TargetName="box"  Property="BorderBrush" Value="#7C6CF0"/>
                                <Setter TargetName="tick" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box"  Property="Background"  Value="#7C6CF0"/>
                                <Setter TargetName="box"  Property="BorderBrush" Value="#7C6CF0"/>
                                <Setter TargetName="dash" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#7C6CF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: toolbar + property input (one box) -->
            <RowDefinition Height="Auto"/>   <!-- 1: (spare) -->
            <RowDefinition Height="*"/>      <!-- 2: tables + data -->
            <RowDefinition Height="Auto"/>   <!-- 3: staged changes list -->
            <RowDefinition Height="Auto"/>   <!-- 4: status + pending-edit count -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar + property input (one box) ────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,6" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Margin="0,0,8,0" Height="30" CornerRadius="6"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnFormView" Content="Visual" Width="58" Height="26" Margin="1"
                                    Style="{StaticResource SegToggleStyle}"
                                    Click="BtnFormView_Click" ToolTip="Visual view (categorized)"/>
                            <Button x:Name="BtnTablesView" Content="Tables" Width="58" Height="26" Margin="1"
                                    Style="{StaticResource SegToggleStyle}"
                                    Click="BtnTablesView_Click" ToolTip="Tables view"/>
                        </StackPanel>
                    </Border>
                    <!-- Search cluster (Create Package style): ◀  [🔍  box  N/M  ✕]  ▶ -->
                    <Button x:Name="BtnSearchNext" Content="▶" Width="28" Height="30"
                            Margin="6,0,0,0" Click="BtnSearchNext_Click" Cursor="Hand"
                            IsEnabled="False" DockPanel.Dock="Right" ToolTip="Next match (Enter)"/>
                    <Border x:Name="SearchBox" DockPanel.Dock="Right" Width="240" Height="30" Margin="6,0,0,0"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderMainBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 🔍 icon -->
                                <ColumnDefinition Width="*"/>     <!-- text box -->
                                <ColumnDefinition Width="Auto"/>  <!-- N/M count -->
                                <ColumnDefinition Width="Auto"/>  <!-- ✕ clear -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center"
                                       Padding="7,0,2,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1"
                                       Text="Search all tables…" FontSize="12" VerticalAlignment="Center"
                                       Padding="3,0,2,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsHitTestVisible="False" Panel.ZIndex="1"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" VerticalContentAlignment="Center" Padding="3,0,2,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     ToolTip="Search all tables" IsEnabled="False"
                                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
                            <TextBlock x:Name="TxtSearchCount" Grid.Column="2"
                                       FontSize="10" VerticalAlignment="Center" Margin="2,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="3" Content="✕"
                                    Width="18" Height="18" Margin="2,0,5,0" Padding="0" FontSize="10"
                                    Cursor="Hand" Visibility="Collapsed" Click="BtnClearSearch_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="Clear search (Esc)"/>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnSearchPrev" Content="◀" Width="28" Height="30"
                            Margin="6,0,0,0" Click="BtnSearchPrev_Click" Cursor="Hand"
                            IsEnabled="False" DockPanel.Dock="Right" ToolTip="Previous match (Shift+Enter)"/>
                    <Button x:Name="BtnSaveMsi" Content="💾 Save" Width="100" Height="30"
                            Margin="6,0,0,0" Click="BtnSaveMsi_Click" Cursor="Hand"
                            IsEnabled="False" DockPanel.Dock="Right" ToolTip="Save the MSI with your edits, or the MST when a transform is applied"/>
                    <Button x:Name="BtnViewMst" Content="👓 Apply MST" Width="104" Height="30"
                            Margin="6,0,0,0" Click="BtnViewMst_Click" Cursor="Hand"
                            IsEnabled="False" DockPanel.Dock="Right"
                            ToolTip="Apply a transform and preview the result"/>
                    <Button x:Name="BtnCreateMst" Content="🛠 Create MST" Width="120" Height="30"
                            Margin="6,0,0,0" Click="BtnCreateMst_Click" Cursor="Hand"
                            IsEnabled="False" DockPanel.Dock="Right"/>
                    <Button x:Name="BtnOpenMsi" Content="📂 Browse" Width="110" Height="30"
                            Margin="6,0,0,0" Click="BtnOpenMsi_Click" Cursor="Hand" DockPanel.Dock="Right"
                            ToolTip="Browse for an MSI file"/>
                    <TextBox x:Name="TxtMsiPath" IsReadOnly="True" Height="30" Margin="0,0,0,0"
                             VerticalContentAlignment="Center" Padding="8,0"
                             Background="{DynamicResource InputBgBrush}"
                             BorderBrush="{DynamicResource BorderMainBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>

                <!-- Actions (same box, second row) -->
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="BtnRemoveDesktop" Content="🧹 Remove Desktop Shortcuts" Width="190" Height="28"
                            Click="BtnRemoveDesktop_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Stages deletion of all Shortcut rows targeting the desktop"/>
                    <Button x:Name="BtnApplyProps" Content="⚙ Apply Properties" Width="160" Height="28"
                            Margin="6,0,0,0" Click="BtnApplyProps_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Adds the properties from EditMSI.json that are not already present"/>
                    <Button x:Name="BtnValidate" Content="✔ Validate" Width="90" Height="28"
                            Margin="6,0,0,0" Click="BtnValidate_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Run SwiftPack's built-in consistency checks on the MSI with your staged edits applied"/>
                    <Button x:Name="BtnViewChanges" Content="📝 View Changes" Width="120" Height="28"
                            Margin="6,0,0,0" Click="BtnViewChanges_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Show the list of changes your staged edits will make"/>
                    <Button x:Name="BtnMsiSettings" Content="⚙ Settings" Width="100" Height="28"
                            Margin="6,0,0,0" Click="BtnMsiSettings_Click" Cursor="Hand"
                            ToolTip="Edit EditMSI.json (the property list used by Apply Properties)"/>
                    <Button x:Name="BtnMsiNew" Content="✚ New" Width="80" Height="28"
                            Margin="6,0,0,0" Click="BtnMsiNew_Click" Cursor="Hand"
                            ToolTip="Close the open package and start over, as if Edit MSI had just been opened"/>
                    <Button x:Name="BtnAddRow" Content="➕ Add Row" Width="90" Height="28"
                            Margin="6,0,0,0" Click="BtnAddRow_Click" Cursor="Hand" IsEnabled="False"/>
                    <Button x:Name="BtnDeleteRow" Content="🗑 Delete Row" Width="100" Height="28"
                            Margin="6,0,0,0" Click="BtnDeleteRow_Click" Cursor="Hand" IsEnabled="False"/>
                    <Button x:Name="BtnCopyRow" Content="⧉ Copy Row" Width="100" Height="28"
                            Margin="6,0,0,0" Click="BtnCopyRow_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Copy the selected row (Ctrl+C)"/>
                    <Button x:Name="BtnPasteRow" Content="📋 Paste Row" Width="100" Height="28"
                            Margin="6,0,0,0" Click="BtnPasteRow_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Paste the copied row as a new row (Ctrl+V)"/>
                    <Button x:Name="BtnCancelValidate" Content="✖ Cancel" Width="80" Height="28"
                            Margin="6,0,0,0" Click="BtnCancelValidate_Click" Cursor="Hand"
                            Visibility="Collapsed" ToolTip="Cancel the running validation"/>
                    <TextBlock/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ── Tables + Data (raw "Tables" view) ───────────────────── -->
        <Grid Grid.Row="2" x:Name="TablesViewRoot" PreviewKeyDown="TablesViewRoot_PreviewKeyDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock x:Name="TxtTablesHeader" DockPanel.Dock="Top" Text="Tables"
                               FontWeight="SemiBold" FontSize="12"
                               Margin="6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ListBox x:Name="LstTables" BorderThickness="0" FontSize="12"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             SelectionChanged="LstTables_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22808080"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#556C63FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <!-- CanUserAddRows puts a blank line at the bottom of the grid: click it and
                         type, rather than having to find Add Row on the toolbar. Both work. -->
                    <DataGrid x:Name="GridRows" AutoGenerateColumns="True" IsReadOnly="False"
                              CanUserAddRows="True" CanUserDeleteRows="False" FontSize="12"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False"
                              Background="Transparent" BorderThickness="0"
                              AutoGeneratingColumn="GridRows_AutoGeneratingColumn"
                              CellEditEnding="GridRows_CellEditEnding"
                              RowBackground="Transparent"
                              CellStyle="{StaticResource CellStyle}"
                              RowStyle="{StaticResource RowStyle}"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="GridRowsContextMenu" Opened="GridRowsContextMenu_Opened">
                                <MenuItem x:Name="CtxSearch" Header="Search" InputGestureText="Ctrl+F" Click="CtxSearch_Click">
                                    <MenuItem.Icon><TextBlock Text="🔍" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxSearchReplace" Header="Search &amp; Replace" InputGestureText="Ctrl+H" Click="CtxSearchReplace_Click">
                                    <MenuItem.Icon><TextBlock Text="🔁" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="CtxAddRow" Header="Add Row" InputGestureText="Ctrl+N" Click="BtnAddRow_Click">
                                    <MenuItem.Icon><TextBlock Text="➕" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxDeleteRow" Header="Delete Row" InputGestureText="Del" Click="BtnDeleteRow_Click">
                                    <MenuItem.Icon><TextBlock Text="🗑" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxCopyRow" Header="Copy Row" InputGestureText="Ctrl+C" Click="BtnCopyRow_Click">
                                    <MenuItem.Icon><TextBlock Text="⧉" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxPasteRow" Header="Paste Row" InputGestureText="Ctrl+V" Click="BtnPasteRow_Click">
                                    <MenuItem.Icon><TextBlock Text="📋" FontSize="12"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
