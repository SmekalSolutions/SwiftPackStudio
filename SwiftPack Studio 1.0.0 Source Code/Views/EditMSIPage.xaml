                                        Background="{DynamicResource PageBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}">
                                    <DockPanel>
                                        <Button x:Name="RegPrev" DockPanel.Dock="Left" Content="◀" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="RegPrev_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11" Margin="2,0,2,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Button x:Name="RegNext" DockPanel.Dock="Right" Content="▶" Width="20" Height="20"
