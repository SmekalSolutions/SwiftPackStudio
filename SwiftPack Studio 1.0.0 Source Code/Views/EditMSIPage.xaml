                                        <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="1*"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.6*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </DockPanel>

                    <!-- Dialogs: dialogs with their controls, and the three behaviour tables
                         (events, conditions, subscriptions) under the editor. -->
                    <DockPanel x:Name="FormDialogsPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="DlgCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Dialogs" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Content="Properties" Tag="props" Height="24" Width="82" Margin="0,0,4,0"
                                        Cursor="Hand" FontSize="11" Click="DlgViewToggle_Click"/>
                                <Button Content="Layout" Tag="layout" Height="24" Width="70" Margin="0,0,4,0"
                                        Cursor="Hand" FontSize="11" Click="DlgViewToggle_Click"/>
