                                <TextBlock Text="INI File" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Environment">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#34D399"
                                      Data="M9,4.5 L4.5,12 L9,19.5 M15,4.5 L19.5,12 L15,19.5 M13.5,7.5 L10.5,16.5"/>
                                <TextBlock Text="Environment Variables" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Certificates">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#F472B6"
                                      Data="M12,2.5 L20,6 V12 C20,16.5 16.6,20 12,21.5 C7.4,20 4,16.5 4,12 V6 Z M8.5,12 L11,14.5 L15.5,9.5"/>
                                <TextBlock Text="Certificates" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Drivers">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#94A3B8"
                                      Data="M4,15.5 H20 M4,15.5 V19 H20 V15.5 M7,17.25 H9 M6,4.5 H18 V11.5 H6 Z M9,8 H15 M12,11.5 V15.5"/>
                                <TextBlock Text="Drivers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Firewall">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#EF4444"
                                      Data="M12,2.5 L20,6 V12 C20,16.5 16.6,20 12,21.5 C7.4,20 4,16.5 4,12 V6 Z M4,10 H20 M12,2.5 V21.5"/>
                                <TextBlock Text="Firewall" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:ServiceInstall">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#10B981"
                                      Data="M3.5,4 H20.5 V9.5 H3.5 Z M3.5,14.5 H20.5 V20 H3.5 Z M6.5,6.75 H8 M6.5,17.25 H8"/>
                                <TextBlock Text="Services" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:AppSearch">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#818CF8"
                                      Data="M10.5,3.5 A7,7 0 0,1 10.5,17.5 A7,7 0 0,1 10.5,3.5 Z M15.5,15.5 L21,21"/>
                                <TextBlock Text="System Search" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="group:mergemod">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#C084FC"
                                      Data="M3.5,3.5 H14 V14 H3.5 Z M10,10 H20.5 V20.5 H10 Z"/>
                                <TextBlock Text="Merge Modules" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Dialog">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#FB923C"
                                      Data="M3,4.5 H21 V19.5 H3 Z M3,8.5 H21 M6,12 H11 M6,15.5 H10 M13.5,13 H18.5 V17 H13.5 Z"/>
                                <TextBlock Text="Dialogs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="sequences">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#38BDF8"
                                      Data="M4,6.5 H6.5 M9.5,6.5 H20 M4,12 H6.5 M9.5,12 H20 M4,17.5 H6.5 M9.5,17.5 H20"/>
                                <TextBlock Text="Sequences" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:Upgrade">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#34C77B"
                                      Data="M12,20.5 V4.5 M5.5,11 L12,4.5 L18.5,11"/>
                                <TextBlock Text="Upgrade" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <ScrollViewer x:Name="FormProductScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!-- Product information -->
                            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🧾  Product information" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Product name" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FpProductName" Height="30" Tag="prop:ProductName"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Product version" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FpProductVersion" Height="30" Tag="prop:ProductVersion"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Manufacturer" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FpManufacturer" Height="30" Tag="prop:Manufacturer"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Product code" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnRegenProduct" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="↻" Cursor="Hand"
                                                Click="BtnRegenProduct_Click" ToolTip="Generate a new GUID"/>
                                        <TextBox x:Name="FpProductCode" Height="30" Tag="prop:ProductCode"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Upgrade code" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnRegenUpgrade" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="↻" Cursor="Hand"
                                                Click="BtnRegenUpgrade_Click" ToolTip="Generate a new GUID"/>
                                        <TextBox x:Name="FpUpgradeCode" Height="30" Tag="prop:UpgradeCode"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="INSTALLDIR" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnBrowseInstallDir" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="📁" Cursor="Hand"
                                                Click="BtnBrowseInstallDir_Click"
                                                ToolTip="Choose from the folders this package installs to (its Directory table)"/>
                                        <!-- The box shows the location the package resolves to, so a
                                             bracketed path such as [ProgramFiles64Folder]PuTTY is a real
                                             value here. Committing it edits the Directory table rather
                                             than adding an INSTALLDIR property, and re-committing an
                                             untouched value stages nothing. The hint behind the box is
                                             left for the case where nothing resolves at all. -->
                                        <Grid>
                                            <TextBox x:Name="FpInstallDir" Height="30" Tag="prop:INSTALLDIR"
                                                     VerticalContentAlignment="Center" Padding="6,0"
                                                     Background="{DynamicResource InputBgBrush}"
                                                     BorderBrush="{DynamicResource BorderMainBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     ToolTip="Where the package installs. A bracketed path such as [ProgramFilesFolder]MyApp is staged in the Directory table and resolves on any machine; an absolute path is stored as an INSTALLDIR override and only fits machines laid out like this one."
                                                     LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                            <TextBlock x:Name="FpInstallDirHint" IsHitTestVisible="False"
                                                       VerticalAlignment="Center" Margin="8,0,42,0" FontSize="12"
                                                       FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </DockPanel>
                                    <!-- Install condition is the LaunchCondition table: the install stops
                                         when one of its rows is false and shows that row's message. The
                                         box is a summary because a condition is an expression plus a
                                         message, which is more than one line's worth. -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Install condition" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnEditLaunchCond" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="✎" Cursor="Hand"
                                                Click="BtnEditLaunchCond_Click" ToolTip="Edit the install conditions"/>
                                        <TextBox x:Name="FpLaunchCond" Height="30" IsReadOnly="True"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ToolTip="LaunchCondition rows. The install stops when one evaluates to false and shows its message."/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Add / remove programs -->
                            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="🧩  Add / remove programs" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <!-- ARPPRODUCTICON: the icon Add / remove programs shows beside
                                         the entry. Its value is an Icon-table key, not a path, so it
                                         is picked rather than typed; the picker's Browse brings one
                                         in from this machine when the package carries none. -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Icon" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnBrowseArpIcon" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="📁" Cursor="Hand"
                                                Click="BtnBrowseArpIcon_Click"
                                                ToolTip="Pick an icon from the package, or browse for one on this machine"/>
                                        <TextBox x:Name="FaProductIcon" Height="30" Tag="prop:ARPPRODUCTICON"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ToolTip="Name of a row in the Icon table."
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Contact" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FaContact" Height="30" Tag="prop:ARPCONTACT"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Phone number" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FaPhone" Height="30" Tag="prop:ARPTELEPHONE"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Support URL" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FaSupportUrl" Height="30" Tag="prop:ARPURLINFOABOUT"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Update URL" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FaUpdateUrl" Height="30" Tag="prop:ARPURLUPDATEINFO"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Help link" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FaHelpLink" Height="30" Tag="prop:ARPHELPLINK"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <WrapPanel Margin="130,8,0,0">
                                        <CheckBox x:Name="ChkHideModify" Content="Hide modify" Tag="flag:ARPNOMODIFY"
                                                  Click="ChkArp_Click" Margin="0,0,18,6"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <CheckBox x:Name="ChkHideRepair" Content="Hide repair" Tag="flag:ARPNOREPAIR"
                                                  Click="ChkArp_Click" Margin="0,0,18,6"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <CheckBox x:Name="ChkHideRemove" Content="Hide remove" Tag="flag:ARPNOREMOVE"
                                                  Click="ChkArp_Click" Margin="0,0,18,6"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <CheckBox x:Name="ChkSystemComponent" Content="Hide application name" Tag="flag:ARPSYSTEMCOMPONENT"
                                                  Click="ChkArp_Click" Margin="0,0,18,6"
                                                  ToolTip="ARPSYSTEMCOMPONENT. Keeps the product out of the Add / remove programs list entirely."
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Summary information -->
                            <Border BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="📝  Summary information" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Applied when saving a new MSI. Windows Installer transforms do not carry the package summary stream, so these are not part of a generated .mst."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Title" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FsTitle" Height="30" Tag="sum:2"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Subject" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FsSubject" Height="30" Tag="sum:3"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Author (company)" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FsAuthor" Height="30" Tag="sum:4"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Keywords" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FsKeywords" Height="30" Tag="sum:5"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Comments" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <!-- The same single line as the fields around it. Comments
                                             is one sentence in practice, and Return has to stay out
                                             of it: the summary stream holds one string, and a
                                             newline in it renders as a stray glyph wherever the
                                             value is shown. Long text scrolls sideways instead. -->
                                        <TextBox x:Name="FsComments" Height="30" Tag="sum:6"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ToolTip="Shown to the user in the package's Properties dialog."
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Code page" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="FsCodePage" Width="320" HorizontalAlignment="Left" Height="30"
                                                  IsReadOnly="True" FontSize="12"
                                                  VerticalContentAlignment="Center" Padding="6,0"
                                                  ToolTip="Encoding of the summary text above: Title, Subject, Author, Keywords and Comments. Not the database tables, and not the same thing as Language. Changing it on its own reinterprets the existing text rather than converting it, so retype those fields if they were already wrong."
                                                  SelectionChanged="FsCodePage_SelectionChanged"/>
                                    </DockPanel>
                                    <!-- Package code identifies this exact build. Two packages
                                         sharing one are the same package as far as Windows
                                         Installer is concerned, so a rebuild needs a new one. -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Package code" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button x:Name="BtnRegenPackageCode" DockPanel.Dock="Right" Width="34" Height="30"
                                                Margin="6,0,0,0" Content="↻" Cursor="Hand"
                                                Click="BtnRegenPackageCode_Click"
                                                ToolTip="Stamp a new package code"/>
                                        <TextBox x:Name="FsPackageCode" Height="30" Tag="sum:9"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ToolTip="Revision Number summary property. A GUID identifying this build of the package."
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="UAC" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="FsUac" Width="240" HorizontalAlignment="Left" Height="30"
                                                  IsReadOnly="True" FontSize="12"
                                                  VerticalContentAlignment="Center" Padding="6,0"
                                                  ToolTip="Whether installing needs elevated privileges. Stored as bit 3 of the Word Count summary property."
                                                  SelectionChanged="FsUac_SelectionChanged"/>
                                    </DockPanel>
                                    <!-- Language is the second half of the Template summary
                                         property, whose first half is the platform. Only this half
                                         is shown, and the platform is preserved on commit. -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Language" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBox x:Name="FsLanguage" Width="240" Height="30"
                                                     VerticalContentAlignment="Center" Padding="6,0"
                                                     Background="{DynamicResource InputBgBrush}"
                                                     BorderBrush="{DynamicResource BorderMainBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     ToolTip="Language ID, e.g. 1033 for English (United States). Several may be listed, separated by commas."
                                                     LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                            <Button x:Name="BtnPickLanguage" Width="34" Height="30"
                                                    Margin="6,0,0,0" Content="🌐" Cursor="Hand"
                                                    Click="BtnPickLanguage_Click"
                                                    ToolTip="Pick languages from the list"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- The other half of Template, and the one Windows Installer
                                         enforces: a package whose platform does not match the
                                         processor stops with error 1633 before anything is staged.
                                         Edited through the same merge as Language so neither half
                                         can drop the other. -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Platform" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="FsPlatform" Width="240" HorizontalAlignment="Left" Height="30"
                                                  IsReadOnly="True" FontSize="12"
                                                  VerticalContentAlignment="Center" Padding="6,0"
                                                  ToolTip="Processor the package may run on. This is a gate, not a conversion: setting x64 does not make the package install 64-bit content. That is decided by each component's 64-bit attribute and the folders it points at."
                                                  SelectionChanged="FsPlatform_SelectionChanged"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="Schema" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="FsSchema" Width="120" HorizontalAlignment="Left" Height="30" Tag="sum:14"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 ToolTip="Lowest Windows Installer version the package needs (200 = 2.0, 300 = 3.0, 405 = 4.5, 500 = 5.0)"
                                                 LostFocus="FormField_Commit" KeyDown="FormField_KeyDown"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel x:Name="FormGridPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,6">
                                <Button x:Name="FormDeleteRow" DockPanel.Dock="Right" Content="🗑 Delete Row"
                                        Width="106" Height="26" Margin="6,0,0,0" Cursor="Hand"
                                        Click="FormDeleteRow_Click"/>
                                <Button x:Name="FormAddRow" DockPanel.Dock="Right" Content="➕ Add Row"
                                        Width="92" Height="26" Margin="6,0,0,0" Cursor="Hand" Click="FormAddRow_Click"/>
                                <TextBlock x:Name="FormGridTitle" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="TxtGridFilter" Height="26" VerticalContentAlignment="Center" Padding="8,0"
                                         Background="{DynamicResource NavBarBgBrush}"
                                         BorderBrush="{DynamicResource BorderMainBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         ToolTip="Filter rows" TextChanged="TxtGridFilter_TextChanged"/>
                            </DockPanel>
                        </Border>
                        <!-- Table strip for the multi-table categories (Services, ODBC, Dialogs
                             and the rest). Collapsed for every single-table category. -->
                        <Border x:Name="FormGroupStripHost" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="{DynamicResource NavBarBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="FormGroupStrip" Orientation="Horizontal" Margin="8,6"/>
                            </ScrollViewer>
                        </Border>

                        <DataGrid x:Name="FormGrid" AutoGenerateColumns="True" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="All"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                                  Background="Transparent" BorderThickness="0"
                                  AutoGeneratingColumn="FormGrid_AutoGeneratingColumn"
                                  RowBackground="Transparent"
                                  CellStyle="{StaticResource CellStyle}"
                                  RowStyle="{StaticResource RowStyle}"
                                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </DockPanel>

                    <!-- Friendly Properties editor (key/value form, not a raw grid) -->
                    <DockPanel x:Name="FormPropsPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="PropCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Width="220" Height="26" Margin="0,0,12,0"
                                        VerticalAlignment="Center" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource PageBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}">
                                    <DockPanel>
                                        <Button x:Name="PropPrev" DockPanel.Dock="Left" Content="◀" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="PropPrev_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11" Margin="2,0,2,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Button x:Name="PropNext" DockPanel.Dock="Right" Content="▶" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="PropNext_Click"/>
                                        <TextBlock x:Name="PropSearchCount" DockPanel.Dock="Right" Margin="4,0,6,0"
                                                   VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Grid>
                                            <TextBox x:Name="PropSearch" BorderThickness="0" Background="Transparent" Padding="2,0"
                                                     VerticalContentAlignment="Center" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     TextChanged="PropSearch_Changed" KeyDown="PropSearch_Key"/>
                                            <TextBlock x:Name="PropSearchPh" Text="Search properties" IsHitTestVisible="False"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Properties" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,1,0,0">
                            <DockPanel Margin="10,8">
                                <Button x:Name="BtnAddProp" DockPanel.Dock="Right" Content="➕ Add" Width="80" Height="28"
                                        Margin="6,0,0,0" Cursor="Hand" Click="BtnAddProp_Click"/>
                                <TextBox x:Name="TxtNewPropName" DockPanel.Dock="Left" Width="248" Height="28" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center" Padding="8,0"
                                         Background="{DynamicResource NavBarBgBrush}"
                                         BorderBrush="{DynamicResource BorderMainBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="New property name"/>
                                <TextBox x:Name="TxtNewPropValue" Height="28" VerticalContentAlignment="Center" Padding="8,0"
                                         Background="{DynamicResource NavBarBgBrush}"
                                         BorderBrush="{DynamicResource BorderMainBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="New property value"/>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="PropList" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="#556C63FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                                    Margin="8,0,0,0" Cursor="Hand" Click="PropDelete_Click"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    ToolTip="Delete this property"/>
                                            <TextBox DockPanel.Dock="Left" Width="260" Height="28"
                                                     VerticalContentAlignment="Center" Padding="6,0"
                                                     Text="{Binding [Property], Mode=OneWay}"
                                                     FontSize="12" Margin="0,0,10,0"
                                                     Background="{DynamicResource InputBgBrush}"
                                                     BorderBrush="{DynamicResource BorderMainBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     ToolTip="Property name. It is the table's key, so it has to be unique."
                                                     LostFocus="PropName_Lost" KeyDown="PropName_KeyDown"/>
                                            <TextBox Height="28" VerticalContentAlignment="Center" Padding="6,0"
                                                     Text="{Binding [Value], Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Background="{DynamicResource InputBgBrush}"
                                                     BorderBrush="{DynamicResource BorderMainBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     LostFocus="PropValue_Lost"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Files view: folder tree (left) + files in the selected folder (right) -->
                    <DockPanel x:Name="FormFilesPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="FileCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Width="200" Height="26" Margin="0,0,12,0"
                                        VerticalAlignment="Center" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource PageBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}">
                                    <DockPanel>
                                        <Button x:Name="FilePrev" DockPanel.Dock="Left" Content="◀" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="FilePrev_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11" Margin="2,0,2,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Button x:Name="FileNext" DockPanel.Dock="Right" Content="▶" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="FileNext_Click"/>
                                        <TextBlock x:Name="FileSearchCount" DockPanel.Dock="Right" Margin="4,0,6,0"
                                                   VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Grid>
                                            <TextBox x:Name="FileSearch" BorderThickness="0" Background="Transparent" Padding="2,0"
                                                     VerticalContentAlignment="Center" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     TextChanged="FileSearch_Changed" KeyDown="FileSearch_Key"/>
                                            <TextBlock x:Name="FileSearchPh" Text="Search files, folders" IsHitTestVisible="False"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Files" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: directory tree -->
                            <TreeView x:Name="DirTree" Grid.Column="0" BorderThickness="0"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseRightButtonDown="DirTree_RightDown"
                                      ContextMenuOpening="DirTree_ContextMenuOpening"
                                      SelectedItemChanged="DirTree_SelectedItemChanged">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add File(s)" Click="DirAddFiles_Click">
                                            <MenuItem.Icon><TextBlock Text="📄" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Create Folder" Click="DirCreateFolder_Click">
                                            <MenuItem.Icon><TextBlock Text="📁" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <!-- Filled in code each time it opens: which standard folders
                                             the package already defines changes as folders are added
                                             and deleted, so a fixed list here would go stale. -->
                                        <MenuItem x:Name="MiShowPredefined" Header="Show Predefined Folder"
                                                  SubmenuOpened="MiShowPredefined_Opened"
                                                  ToolTip="Show a standard Windows location under Target Computer. One this package does not define yet is added to the Directory table.">
                                            <MenuItem.Icon><TextBlock Text="🗂" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Standard Windows locations" IsEnabled="False"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiDirRename" Header="Rename Folder" InputGestureText="F2" Click="DirRenameFolder_Click">
                                            <MenuItem.Icon><TextBlock Text="✏" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiDirDelete" Header="Delete Folder" InputGestureText="Del" Click="DirDeleteFolder_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Permissions" Click="DirFolderPermissions_Click"
                                                  ToolTip="Set who can access this folder once it is installed (LockPermissions table)">
                                            <MenuItem.Icon><TextBlock Text="🔒" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Expand" Click="DirExpand_Click">
                                            <MenuItem.Icon><TextBlock Text="▸" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Collapse" Click="DirCollapse_Click">
                                            <MenuItem.Icon><TextBlock Text="▾" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource TreeNodeIcon}" Stroke="#4C9AFF"
                                                  Data="{Binding IconGeometry}"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Background="{DynamicResource BorderMainBrush}"/>

                            <!-- Right: files in the selected folder -->
                            <DockPanel Grid.Column="2">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel Margin="10,6">
                                        <TextBlock x:Name="DirFilesTitle" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Select a folder"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="DirFileList" AutoGenerateColumns="False" IsReadOnly="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" FontSize="12"
                                          HeadersVisibility="Column" GridLinesVisibility="None"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="False"
                                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                          SelectionMode="Single" RowHeight="26"
                                          PreviewMouseRightButtonDown="DirFileList_RightDown"
                                          CellStyle="{StaticResource FilesCellStyle}"
                                          RowStyle="{StaticResource FilesRowStyle}"
                                          ColumnHeaderStyle="{StaticResource FilesHeaderStyle}"
                                          Foreground="{DynamicResource TextPrimaryBrush}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <!-- Same handler as the folder tree's: it works from the
                                                 selected folder, which is the one whose files are
                                                 listed here. -->
                                            <MenuItem Header="Add File(s)" Click="DirAddFiles_Click">
                                                <MenuItem.Icon><TextBlock Text="📄" FontSize="13"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Set Key Path" Click="FileSetKeyPath_Click">
                                                <MenuItem.Icon><TextBlock Text="🔑" FontSize="13"/></MenuItem.Icon>
                                            </MenuItem>
                                            <!-- No icon: this is the counterpart to Set Key Path, and a
                                                 second key glyph beside it would read as another way to
                                                 set one. -->
                                            <MenuItem Header="Clear Key Path" Click="FileClearKeyPath_Click"/>
                                            <MenuItem Header="Delete File" InputGestureText="Del" Click="DirFileDelete_Click">
                                                <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Permissions" Click="FilePermissions_Click"
