                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#EC6B9A"
                                      Data="M3,4.5 H21 V19.5 H3 Z M6.5,9 L9.5,12 L6.5,15 M12.5,15 H17.5"/>
                                <TextBlock Text="Custom actions" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="table:IniFile">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#60A5FA"
