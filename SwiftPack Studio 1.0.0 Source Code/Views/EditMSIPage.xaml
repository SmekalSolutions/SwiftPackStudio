                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ScMenuNewShortcut" Header="New Shortcut" Click="ScNewShortcut_Click">
                                            <MenuItem.Icon>
                                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#E8912D" Margin="0"
                                                      Data="M13,4 H5 V19 H20 V11 M14,10 L20.5,3.5 M15.5,3.5 H20.5 V8.5"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator x:Name="ScMenuSep1"/>
                                        <MenuItem x:Name="ScMenuRename" Header="Rename" InputGestureText="F2" Click="ScRename_Click">
                                            <MenuItem.Icon>
                                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#4C9AFF" Margin="0"
