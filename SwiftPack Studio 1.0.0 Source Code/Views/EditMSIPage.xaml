                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: registry key tree -->
                            <TreeView x:Name="RegTree" Grid.Column="0" BorderThickness="0"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseRightButtonDown="RegTree_RightDown"
                                      SelectedItemChanged="RegTree_SelectedItemChanged">
                                <TreeView.ContextMenu>
<ContextMenu Opened="RegMenu_Opened">
                                        <MenuItem Header="New Value" Click="RegAddValue_Click">
                                            <MenuItem.Icon><TextBlock Text="✚" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Key" Click="RegAddKey_Click">
                                            <MenuItem.Icon><TextBlock Text="🗝" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiRegRename" Header="Rename Key" InputGestureText="F2" Click="RegRenameKey_Click">
                                            <MenuItem.Icon><TextBlock Text="✏" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiRegDelete" Header="Delete Key" InputGestureText="Del" Click="RegDeleteKey_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="MiRegPermissions" Header="Permissions" Click="RegKeyPermissions_Click"
                                                  ToolTip="Set who can access this registry key once it is created (LockPermissions table)">
                                            <MenuItem.Icon><TextBlock Text="🔒" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Import Registry" Click="RegImport_Click">
                                            <MenuItem.Icon><TextBlock Text="⮈" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Export Registry" Click="RegExport_Click">
                                            <MenuItem.Icon><TextBlock Text="⮊" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Export All Registry" Click="RegExportAll_Click">
                                            <MenuItem.Icon><TextBlock Text="⮊" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Expand" Click="RegExpand_Click">
                                            <MenuItem.Icon><TextBlock Text="▸" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Collapse" Click="RegCollapse_Click">
                                            <MenuItem.Icon><TextBlock Text="▾" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
