                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="UpgList" Grid.Column="0" BorderThickness="0" FontSize="12"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="UpgList_SelectionChanged"
                                     PreviewMouseRightButtonDown="UpgList_RightDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New Upgrade Entry" Click="UpgNew_Click">
                                            <MenuItem.Icon><TextBlock Text="⬆" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete Upgrade Entry" InputGestureText="Del" Click="UpgDelete_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Arrow}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Background="{DynamicResource BorderMainBrush}"/>

                            <DockPanel Grid.Column="2">
                                <ScrollViewer x:Name="UpgEditorHost" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent" Padding="0"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <Border x:Name="FormPlaceholder" Visibility="Collapsed"
                            Background="{DynamicResource CardBgBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="FormPlaceholderText" FontSize="13" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Button x:Name="BtnGoTables" Content="Open in Tables view" Width="170" Height="30"
                                    HorizontalAlignment="Center" Cursor="Hand" Click="BtnGoTables_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Bottom panel: Validation / View Changes (collapsible) ────── -->
        <Border x:Name="BottomPanel" Grid.Row="3" Margin="0,6,0,0" Visibility="Collapsed"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6">
            <StackPanel>
                <!-- Header bar: collapse toggle + view tabs + export + summary -->
                <DockPanel>
                    <Button x:Name="BtnPanelToggle" Content="▾" Width="24" Height="24"
                            Click="BtnPanelToggle_Click" Cursor="Hand" DockPanel.Dock="Left"
                            ToolTip="Collapse / expand this panel"/>
                    <Button x:Name="BtnExportPanel" Content="⬇ Export CSV" Width="130" Height="24"
                            Margin="6,0,0,0" DockPanel.Dock="Right"
                            Click="BtnExportPanel_Click" Cursor="Hand" IsEnabled="False"
                            ToolTip="Export validation results and changes to a CSV file"/>
                    <Button x:Name="BtnPanelClose" Content="✕ Close" Width="100" Height="24"
                            Margin="6,0,0,0" DockPanel.Dock="Right"
                            Click="BtnPanelClose_Click" Cursor="Hand"
                            ToolTip="Close this panel"/>
                    <TextBlock x:Name="TxtPanelSummary" DockPanel.Dock="Right"
                               VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <RadioButton x:Name="TabValidation" Content="Validation" GroupName="BottomView"
                                     IsChecked="True" Checked="BottomView_Changed" FontSize="12"
                                     VerticalContentAlignment="Center" Margin="0,0,16,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <RadioButton x:Name="TabTransform" Content="View Changes" GroupName="BottomView"
                                     Checked="BottomView_Changed" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Body: one of the two views is visible at a time -->
                <Grid x:Name="PanelBody" Margin="0,6,0,0">
                    <!-- Validation results -->
                    <Border x:Name="ViewValidation" BorderBrush="{DynamicResource BorderMainBrush}"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <ListView x:Name="LstValidation" Height="120" FontSize="12"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ItemContainerStyle="{StaticResource GvItemStyle}"
                                  MouseDoubleClick="LstValidation_DoubleClick"
                                  ToolTip="Double-click a result to jump to the offending row">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" Width="80"
                                                    DisplayMemberBinding="{Binding Severity}"/>
                                    <GridViewColumn Header="Code" Width="110"
                                                    DisplayMemberBinding="{Binding Code}"/>
                                    <GridViewColumn Header="Table" Width="130"
                                                    DisplayMemberBinding="{Binding Table}"/>
                                    <GridViewColumn Header="Row" Width="150"
                                                    DisplayMemberBinding="{Binding RowKey}"/>
                                    <GridViewColumn Header="Column" Width="110"
                                                    DisplayMemberBinding="{Binding Column}"/>
                                    <GridViewColumn Header="Message" Width="360"
                                                    DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Transform changes -->
                    <Border x:Name="ViewTransform" Visibility="Collapsed"
                            BorderBrush="{DynamicResource BorderMainBrush}"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <ListView x:Name="LstTransform" Height="120" FontSize="12"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  MouseDoubleClick="LstTransform_DoubleClick"
                                  ToolTip="Double-click a change to jump to that row">
                            <ListView.Resources>
                                <!-- Translucent action tints (low alpha → readable in light & dark) -->
                                <SolidColorBrush x:Key="TintAdd"    Color="#3343A047"/>
                                <SolidColorBrush x:Key="TintModify" Color="#33E0A020"/>
                                <SolidColorBrush x:Key="TintDelete" Color="#33E24B4A"/>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template" Value="{StaticResource GvItemTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Action}" Value="Add">
                                            <Setter Property="Background" Value="{StaticResource TintAdd}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Action}" Value="Modify">
                                            <Setter Property="Background" Value="{StaticResource TintModify}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Action}" Value="Delete">
                                            <Setter Property="Background" Value="{StaticResource TintDelete}"/>
                                        </DataTrigger>
                                        <!-- Selection last so it stays readable over any action tint. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#556C63FF"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Action" Width="80"
                                                    DisplayMemberBinding="{Binding Action}"/>
                                    <GridViewColumn Header="Table" Width="130"
                                                    DisplayMemberBinding="{Binding Table}"/>
                                    <GridViewColumn Header="Row / key" Width="170"
                                                    DisplayMemberBinding="{Binding RowKey}"/>
                                    <GridViewColumn Header="Column" Width="110"
                                                    DisplayMemberBinding="{Binding Column}"/>
                                    <GridViewColumn Header="Old → New" Width="360"
                                                    DisplayMemberBinding="{Binding Change}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Status (with pending-edit count) ──────────────────────── -->
        <DockPanel Grid.Row="4" Margin="6,6,6,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtEditCount" DockPanel.Dock="Right" FontSize="11"
                       Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="TxtStatus" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Open an MSI to browse its tables and stage MST changes."/>
        </DockPanel>
    </Grid>
</Page>
