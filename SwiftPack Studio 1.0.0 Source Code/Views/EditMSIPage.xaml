                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource TreeNodeIcon}" Stroke="#2FB3A3"
                                                  Data="{Binding IconGeometry}"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <!-- BorderMainBrush is tuned to sit on the input surfaces, so on the dark
                                 theme it is within a couple of levels of the page background and the
                                 splitter disappears. TextMutedBrush contrasts against the page on both
                                 themes; the opacity holds it back to a divider rather than a rule. -->
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Opacity="0.45"
                                          Background="{DynamicResource TextMutedBrush}"/>

