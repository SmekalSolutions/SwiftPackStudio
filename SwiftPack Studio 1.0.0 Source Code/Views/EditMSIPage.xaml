                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Background="{DynamicResource BorderMainBrush}"/>

                            <Grid x:Name="DlgPropsArea" Grid.Column="2">
