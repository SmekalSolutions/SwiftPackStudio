                                                FontSize="11" Click="DlgSubDel_Click"/>
                                        <Button x:Name="DlgSubAdd" DockPanel.Dock="Right" Content="➕ Add"
                                                Height="24" Width="72" Margin="6,0,0,0" Cursor="Hand"
                                                FontSize="11" Click="DlgSubAdd_Click"/>
