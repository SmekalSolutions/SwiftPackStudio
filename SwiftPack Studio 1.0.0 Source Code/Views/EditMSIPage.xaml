                                <Grid.ColumnDefinitions>
                                    <!-- Zero-width until a component's Registry Data is selected, so
                                         every other detail view still fills the pane. -->
                                    <ColumnDefinition x:Name="FeatSideCol" Width="0"/>
                                    <ColumnDefinition x:Name="FeatSideSplitCol" Width="0"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TreeView x:Name="FeatRegTree" Grid.Column="0" Visibility="Collapsed"
                                          Background="Transparent" BorderThickness="0" FontSize="12"
                                          SelectedItemChanged="FeatRegTree_SelectionChanged"
                                          PreviewMouseRightButtonDown="RegTree_RightDown"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <TreeView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#2FB3A3"
                                                      Data="{Binding IconGeometry}"/>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <!-- The component's shortcuts, in the same slot as the registry tree.
                                     Only one of the two is ever on screen. -->
                                <TreeView x:Name="FeatScTree" Grid.Column="0" Visibility="Collapsed"
                                          Background="Transparent" BorderThickness="0" FontSize="12"
                                          SelectedItemChanged="FeatScTree_SelectionChanged"
                                          PreviewMouseRightButtonDown="ScTree_RightDown"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <TreeView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#E8912D"
                                                      Data="{Binding IconGeometry}"/>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <GridSplitter x:Name="FeatSideSplit" Grid.Column="1" Width="4" Visibility="Collapsed"
                                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                              Background="{DynamicResource BorderMainBrush}"/>

                                <DataGrid x:Name="FeatCompList" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" FontSize="12"
                                          HeadersVisibility="Column" GridLinesVisibility="None"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="False"
                                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                          SelectionMode="Single" RowHeight="26"
                                          MouseDoubleClick="FeatProps_DoubleClick"
                                          PreviewMouseRightButtonDown="FeatCompList_RightDown"
                                          ContextMenuOpening="FeatCompList_MenuOpening"
                                          CellStyle="{StaticResource FilesCellStyle}"
                                          RowStyle="{StaticResource FilesRowStyle}"
                                          ColumnHeaderStyle="{StaticResource FilesHeaderStyle}"
                                          Foreground="{DynamicResource TextPrimaryBrush}">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    </DataGrid.Resources>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MiCompSetKeyPath" Header="Set Keypath" Click="CompSetKeyPath_Click">
                                                <MenuItem.Icon><TextBlock Text="🔑" FontSize="13"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="MiCompClearKeyPath" Header="Clear Keypath" Click="CompClearKeyPath_Click"/>
                                            <MenuItem x:Name="MiCompDelete" Header="Delete File" InputGestureText="Del" Click="CompDelete_Click">
                                                <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>

                                <!-- Editable component form (shown when a component node is selected) -->
                                <ScrollViewer x:Name="FeatCompForm" Grid.Column="2" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled" Padding="0">
                                    <Grid Margin="12,10,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Destination" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                                            <ComboBox x:Name="CompDest" IsEditable="True" Height="26" FontSize="12"
                                                      Background="{DynamicResource InputBgBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderMainBrush}"/>
                                            <!-- Where that key actually lands, resolved up the Directory table.
                                                 The key on its own says nothing: MyLang could be anywhere. -->
                                            <TextBlock x:Name="CompDestPath" FontSize="11" Margin="2,3,0,0"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Component GUID" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="CompGuid" Grid.Row="1" Grid.Column="1" Height="26" FontSize="12" VerticalContentAlignment="Center"
                                                 Margin="0,4,0,4" Padding="8,0" Background="{DynamicResource InputBgBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Key path" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="CompKey" Grid.Row="2" Grid.Column="1" Height="26" FontSize="12" VerticalContentAlignment="Center"
                                                 Margin="0,4,0,4" Padding="8,0" Background="{DynamicResource InputBgBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Condition" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="CompCond" Grid.Row="3" Grid.Column="1" Height="26" FontSize="12" VerticalContentAlignment="Center"
                                                 Margin="0,4,0,4" Padding="8,0" Background="{DynamicResource InputBgBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderMainBrush}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Install location" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,4">
                                            <RadioButton x:Name="CompLocLocal" Content="Run local" GroupName="CompLoc"
                                                         FontSize="12" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <RadioButton x:Name="CompLocSource" Content="Run from source" GroupName="CompLoc"
                                                         FontSize="12" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <RadioButton x:Name="CompLocOptional" Content="Optional" GroupName="CompLoc"
                                                         FontSize="12" VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Options" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,9,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                                            <CheckBox x:Name="CompPerm" Content="Permanent" FontSize="12" Width="195"
                                                      Margin="0,2,12,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <CheckBox x:Name="CompNever" Content="Never overwrite" FontSize="12" Width="195"
                                                      Margin="0,2,12,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <CheckBox x:Name="Comp64" Content="64-bit" FontSize="12" Width="195"
                                                      Margin="0,2,12,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <CheckBox x:Name="CompUninst" Content="Uninstall on supersedence" FontSize="12" Width="195"
                                                      Margin="0,2,12,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <CheckBox x:Name="CompShared" Content="Shared component" FontSize="12" Width="195"
                                                      Margin="0,2,12,2" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </WrapPanel>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Editable feature form (shown when a feature node is selected) -->
                                <ScrollViewer x:Name="FeatFeatureForm" Grid.Column="2" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent" Padding="0"/>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Custom actions: list + decoded detail -->
                    <DockPanel x:Name="FormCustomActionsPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="CaCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Width="200" Height="26" Margin="0,0,12,0"
                                        VerticalAlignment="Center" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource PageBgBrush}" BorderBrush="{DynamicResource BorderMainBrush}">
                                    <DockPanel>
                                        <Button x:Name="CaPrev" DockPanel.Dock="Left" Content="◀" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="CaPrev_Click"/>
                                        <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11" Margin="2,0,2,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Button x:Name="CaNext" DockPanel.Dock="Right" Content="▶" Width="20" Height="20"
                                                Padding="0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}" Click="CaNext_Click"/>
                                        <TextBlock x:Name="CaSearchCount" DockPanel.Dock="Right" Margin="4,0,6,0"
                                                   VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Grid>
                                            <TextBox x:Name="CaSearch" BorderThickness="0" Background="Transparent" Padding="2,0"
                                                     VerticalContentAlignment="Center" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     TextChanged="CaSearch_Changed" KeyDown="CaSearch_Key"/>
                                            <TextBlock x:Name="CaSearchPh" Text="Search custom actions" IsHitTestVisible="False"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Custom actions" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: the actions as a tree under one Custom Actions root, the way
                                 the reference tools show them. The root carries the New menu; an
                                 action carries only Rename and Delete. -->
                            <TreeView x:Name="CaList" Grid.Column="0" BorderThickness="0" FontSize="12"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItemChanged="CaTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="RegTree_RightDown">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="CaMenu_Opened">
                                        <!-- The reference tools' taxonomy: what kind of action first,
                                             then where its code lives. Each item lands straight in the
                                             editor with that type set. Tag carries the MSI base type. -->
                                        <MenuItem x:Name="MiCaNewExe" Header="New EXE">
                                            <MenuItem.Icon><TextBlock Text="▶" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Stored in Binary table" Tag="2"  Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Installed with product" Tag="18" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Path referencing a directory" Tag="34" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Path in property value" Tag="50" Click="CaNewTyped_Click"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewDll" Header="New DLL">
                                            <MenuItem.Icon><TextBlock Text="🧩" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Stored in Binary table" Tag="1"  Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Installed with product" Tag="17" Click="CaNewTyped_Click"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewVbs" Header="New VBScript">
                                            <MenuItem.Icon><TextBlock Text="📜" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Stored in Binary table" Tag="6"  Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Stored in custom action" Tag="38" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Stored in property value" Tag="54" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Installed with product" Tag="22" Click="CaNewTyped_Click"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewJs" Header="New JScript">
                                            <MenuItem.Icon><TextBlock Text="📜" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Stored in Binary table" Tag="5"  Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Stored in custom action" Tag="37" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Stored in property value" Tag="53" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Installed with product" Tag="21" Click="CaNewTyped_Click"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewSetProp" Header="New Set Property" Tag="51" Click="CaNewTyped_Click">
                                            <MenuItem.Icon><TextBlock Text="⚙" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewSetDir" Header="New Set Directory" Tag="35" Click="CaNewTyped_Click">
                                            <MenuItem.Icon><TextBlock Text="📁" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewNested" Header="New Nested MSI">
                                            <MenuItem.Icon><TextBlock Text="📦" FontSize="13"/></MenuItem.Icon>
                                            <MenuItem Header="Inside this package" Tag="7"  Click="CaNewTyped_Click"/>
                                            <MenuItem Header="On source location" Tag="23" Click="CaNewTyped_Click"/>
                                            <MenuItem Header="Advertised or Installed" Tag="39" Click="CaNewTyped_Click"/>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaNewError" Header="New Error" Tag="19" Click="CaNewTyped_Click">
                                            <MenuItem.Icon><TextBlock Text="⛔" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator x:Name="SepCaNew"/>
                                        <MenuItem x:Name="MiCaNewChoose" Header="New Custom Action (choose type)" Click="CaNew_Click">
                                            <MenuItem.Icon><TextBlock Text="✚" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaRename" Header="Rename" InputGestureText="F2" Click="CaRename_Click">
                                            <MenuItem.Icon><TextBlock Text="✏" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCaDelete" Header="Delete" InputGestureText="Del" Click="CaDelete_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Path Style="{StaticResource TreeNodeIcon}" Stroke="#EC6B9A"
                                                  Data="M3,4.5 H21 V19.5 H3 Z M6.5,9 L9.5,12 L6.5,15 M12.5,15 H17.5"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Action}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Background="{DynamicResource BorderMainBrush}"/>

                            <!-- Right: decoded detail -->
                            <DockPanel Grid.Column="2">
                                <ScrollViewer x:Name="CaEditorHost" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent" Padding="0"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Environment variables: a tree of the variables with a decoded editor
                         beside it. Everything the MSI hides in punctuation is a named control. -->
                    <DockPanel x:Name="FormEnvPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="EnvCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Environment variables" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" MinWidth="200"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="1.6*" MinWidth="260"/>
                            </Grid.ColumnDefinitions>

                            <TreeView x:Name="EnvTree" Grid.Column="0" BorderThickness="0" FontSize="12"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItemChanged="EnvTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="RegTree_RightDown">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="EnvMenu_Opened">
                                        <MenuItem x:Name="MiEnvNew" Header="New Variable" Click="EnvNew_Click">
                                            <MenuItem.Icon><TextBlock Text="✚" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiEnvDelete" Header="Delete" InputGestureText="Del" Click="EnvDelete_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Path Style="{StaticResource TreeNodeIcon}" Stroke="#34D399"
                                                  Data="M9,4.5 L4.5,12 L9,19.5 M15,4.5 L19.5,12 L15,19.5 M13.5,7.5 L10.5,16.5"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch" Background="{DynamicResource BorderMainBrush}"/>

                            <ScrollViewer x:Name="EnvEditorHost" Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent" Padding="0"/>
                        </Grid>
                    </DockPanel>

                    <!-- Services: one node per service name, with ServiceInstall and
                         ServiceControl edited together as the two halves of one thing. -->
                    <DockPanel x:Name="FormServicesPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="10,8">
                                <TextBlock x:Name="SvcCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Services" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="200"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="1.8*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <TreeView x:Name="SvcTree" Grid.Column="0" BorderThickness="0" FontSize="12"
                                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItemChanged="SvcTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="RegTree_RightDown">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="SvcMenu_Opened">
                                        <MenuItem x:Name="MiSvcNew" Header="New Service" Click="SvcNew_Click">
                                            <MenuItem.Icon><TextBlock Text="✚" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiSvcDelete" Header="Delete" InputGestureText="Del" Click="SvcDelete_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
