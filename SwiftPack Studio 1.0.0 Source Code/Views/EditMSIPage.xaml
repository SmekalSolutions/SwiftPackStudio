                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ScMenuDelete" Header="Delete" InputGestureText="Del" Click="ScDelete_Click">
                                            <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ScMenuCopy" Header="Copy" InputGestureText="Ctrl+C" Click="ScCopy_Click">
                                            <MenuItem.Icon>
                                                <Path Style="{StaticResource TreeNodeIcon}" Stroke="#4C9AFF" Margin="0"
                                                      Data="M9,9 H20 V20 H9 Z M5,15 H4 V4 H15 V5"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ScMenuPaste" Header="Paste" InputGestureText="Ctrl+V" Click="ScPaste_Click">
