                                              SelectionChanged="RegValueList_SelectionChanged"
                                              CellStyle="{StaticResource FilesCellStyle}"
                                              RowStyle="{StaticResource FilesRowStyle}"
                                              ColumnHeaderStyle="{StaticResource FilesHeaderStyle}"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Set Key Path" Click="RegSetKeyPath_Click">
                                                    <MenuItem.Icon><TextBlock Text="🔑" FontSize="13"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Clear Key Path" Click="RegClearKeyPath_Click"/>
                                                <MenuItem Header="Delete Value" InputGestureText="Del" Click="RegDeleteValue_Click">
                                                    <MenuItem.Icon><TextBlock Text="🗑" FontSize="13"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#556C63FF"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#556C63FF"/>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="" Binding="{Binding KeyPathGlyph}" Width="44">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="ToolTip" Value="Key path of its component"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding NameDisplay}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="130"/>
                                            <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="*"/>
                                            <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="160"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>

                                <!-- Same reason as the tree splitter above: BorderMainBrush is invisible
                                     against the dark page background. -->
                                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                                              ResizeDirection="Rows" Opacity="0.45"
                                              Background="{DynamicResource TextMutedBrush}"/>

                                <DockPanel Grid.Row="2">
                                    <ScrollViewer x:Name="RegValueEditorHost" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="Transparent" Padding="0"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>

                    <DockPanel x:Name="FormShortcutsPanel" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InputBgBrush}"
