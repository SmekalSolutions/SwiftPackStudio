<Page x:Class="SwiftPack.Views.ValidatePackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBgBrush}"
      AllowDrop="True"
      DragOver="Page_DragOver"
      Drop="Page_Drop">

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══ TOOLBAR - CardStyle outer box with curve edges ══ -->
    <Border Grid.Row="0" Style="{StaticResource CardStyle}"
            Margin="8,8,8,8" Padding="14,10">

      <!-- Shared button style: uniform grey background, equal width, equal gap -->
      <Border.Resources>
        <Style x:Key="QABtn" TargetType="Button">
          <Setter Property="Background"       Value="{DynamicResource InputBgBrush}"/>
          <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderBrush"      Value="{DynamicResource BorderInputBrush}"/>
          <Setter Property="BorderThickness"  Value="1"/>
          <Setter Property="Height"           Value="28"/>
          <Setter Property="Width"            Value="82"/>
          <Setter Property="FontSize"         Value="11"/>
          <Setter Property="Cursor"           Value="Hand"/>
          <Setter Property="Margin"           Value="0,0,6,0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background"
                            Value="{DynamicResource NavBarBgBrush}"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Border.Resources>

      <StackPanel>

        <!-- ── Row 1: Log File + QAsnap Path + Browse ── -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>        <!-- "Log Path" label -->
            <ColumnDefinition Width="*"/>            <!-- log path textbox - fills half -->
            <ColumnDefinition Width="Auto"/>        <!-- Browse button -->
            <ColumnDefinition Width="21"/>          <!-- divider spacer -->
            <ColumnDefinition Width="Auto"/>        <!-- "QAsnap Path" label -->
            <ColumnDefinition Width="*"/>            <!-- qasnap textbox - fills other half -->
            <ColumnDefinition Width="Auto"/>        <!-- folder Browse button -->
          </Grid.ColumnDefinitions>

          <TextBox x:Name="TxtPackageFolder" Visibility="Collapsed"/>

          <!-- Log File label -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="Log Path" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text=" *" FontSize="11" Foreground="#F7584F"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Log path textbox with X clear button -->
          <Grid Grid.Column="1" Margin="0,0,8,0">
            <TextBox x:Name="TxtLogPath"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Height="28" FontSize="11" Padding="8,0,28,0"
                     Tag="Browse for a .log file, or drag and drop a .log file anywhere on this page."
                     AllowDrop="True" Drop="TxtLogPath_Drop"
                     PreviewDragOver="TxtLogPath_DragOver"/>
            <Button x:Name="BtnClearLogPath" Content="✕"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="22" Height="18" Margin="0,0,4,0"
                    FontSize="10" Cursor="Hand" BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="BtnClearLogPath_Click" ToolTip="Clear log path"/>
          </Grid>

          <!-- Status text overlay -->
          <TextBlock x:Name="TxtQAStatus" Grid.Column="1"
                     Text="" FontSize="11" FontStyle="Italic"
                     Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right"
                     Margin="0,0,12,0" IsHitTestVisible="False"/>

          <!-- Browse (log) button -->
          <Button Grid.Column="2" Style="{StaticResource QABtn}" Content="📄 Browse"
                  Margin="0,0,0,0"
                  Click="BtnBrowseLog_Click"/>

          <!-- Vertical divider between the two path groups -->
          <Rectangle Grid.Column="3" Width="1" Height="20"
                     Fill="{DynamicResource BorderMainBrush}"
                     VerticalAlignment="Center" Margin="10,0"/>

          <!-- QAsnap Path label -->
          <TextBlock Grid.Column="4" Text="SVR Path" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>

          <!-- QAsnap path textbox with X clear button -->
          <Grid Grid.Column="5" Margin="0,0,8,0">
            <TextBox x:Name="TxtQAsnapPath"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Height="28" FontSize="11" Padding="8,0,28,0"
                     Tag="Browse for SVR file name…"
                     TextChanged="TxtQAsnapPath_TextChanged"/>
            <Button x:Name="BtnClearQAsnapPath" Content="✕"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="22" Height="18" Margin="0,0,4,0"
                    FontSize="10" Cursor="Hand" BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="BtnClearQAsnapPath_Click" ToolTip="Clear SVR path"/>
          </Grid>

          <!-- QAsnap folder Browse button -->
          <Button Grid.Column="6" Style="{StaticResource QABtn}" Content="📁 Browse"
                  Click="BtnBrowseQAsnapPath_Click" ToolTip="Select SVR folder"/>

        </Grid>

        <!-- ── Row 2: Verify, All, Export, Copy, Clear, ←, Search, → ── -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

          <!-- Pass/Fail hidden - keep for code-behind refs -->
          <Button x:Name="BtnShowPass" Visibility="Collapsed" Click="BtnShowPass_Click"/>
          <Button x:Name="BtnShowFail" Visibility="Collapsed" Click="BtnShowFail_Click"/>

          <!-- Verify -->
          <Button x:Name="BtnRunQA" Content="▶  Verify"
                  ToolTip="Verify the package"
                  Background="{DynamicResource InputBgBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderInputBrush}"
                  BorderThickness="1" Height="28" Width="82"
                  FontSize="11" Margin="0,0,6,0" Cursor="Hand"
                  Click="BtnRunQA_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background"
                            Value="{DynamicResource NavBarBgBrush}"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Export -->
          <Button x:Name="BtnExportReport" Style="{StaticResource QABtn}" Content="📄 Export"
                  ToolTip="Export as .html &amp; .xlsx"
                  Click="BtnExportReport_Click"/>

          <!-- Import -->
          <Button x:Name="BtnImportReport" Style="{StaticResource QABtn}" Content="📥 Import"
                  Click="BtnImportReport_Click" ToolTip="Import results from an exported .html or .csv report"/>

          <!-- Copy -->
          <Button x:Name="BtnCopyRow" Style="{StaticResource QABtn}" Content="📋 Copy"
                  Click="BtnCopyRow_Click" ToolTip="Copy selected row to clipboard"/>

          <!-- Save -->
          <Button x:Name="BtnSaveReport" Style="{StaticResource QABtn}" Content="💾 Save"
                  Click="BtnSaveReport_Click" ToolTip="Save both .html and .xlsx to the report folder (no prompt)"/>

          <!-- New -->
          <Button x:Name="BtnClearQA" Style="{StaticResource QABtn}" Content="🆕 New"
                  Click="BtnClearQA_Click" ToolTip="Reset and reload SVR path from ValidatePackage.json"/>

          <!-- Settings -->
          <Button x:Name="BtnVpSettings" Style="{StaticResource QABtn}" Content="⚙ Settings"
                  Click="BtnVpSettings_Click" ToolTip="Edit ValidatePackage.json settings"/>


          <!-- Prev search -->
          <Button x:Name="BtnQASearchPrev" Style="{StaticResource QABtn}"
                  Content="◀" Width="28" Margin="0,0,0,0"
                  Click="BtnQASearchPrev_Click" ToolTip="Previous match"/>

          <!-- Search box -->
          <Border x:Name="SearchBorder"
                  Background="{DynamicResource InputBgBrush}"
                  BorderBrush="{DynamicResource BorderInputBrush}"
                  BorderThickness="1" CornerRadius="6"
                  Height="28" Width="180" VerticalAlignment="Center" Margin="0,0,0,0">
            <Grid>
              <TextBlock x:Name="TxtSearchPlaceholder"
                         Text="🔍  Search"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Left"
                         Margin="8,0,0,0" IsHitTestVisible="False"/>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQASearch" Grid.Column="0"
                         Height="26" FontSize="11"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" Padding="6,4,2,4"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Left"
                         TextChanged="TxtQASearch_TextChanged"/>
                <TextBlock x:Name="TxtQASearchCount" Grid.Column="1"
                           Text="" FontSize="10" MinWidth="32"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="2,0,2,0"/>
                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕"
                        Width="20" Height="18" Margin="0,0,3,0"
                        FontSize="9" Cursor="Hand" BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="BtnClearSearch_Click" ToolTip="Clear search"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Next search -->
          <Button x:Name="BtnQASearchNext" Style="{StaticResource QABtn}"
                  Content="▶" Width="28" Margin="0"
                  Click="BtnQASearchNext_Click" ToolTip="Next match"/>

        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ PROGRESS BAR - overlaid on bottom edge of toolbar, zero extra height ══ -->
    <ProgressBar x:Name="PrgVerifyProgress"
                 Grid.Row="0"
                 Height="3" Minimum="0" Maximum="100" Value="0"
                 IsIndeterminate="True"
                 VerticalAlignment="Bottom"
                 Visibility="Collapsed"
                 Margin="8,0,8,0"
                 Foreground="{DynamicResource AccentBlueBrush}"/>

    <!-- ══ CONTENT ══ -->
    <Grid Grid.Row="1" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── LEFT summary ── -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>  <!-- header row - matches right column -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Header - same style as right column header -->
          <Border Grid.Row="0" CornerRadius="10,10,0,0"
                  Background="{DynamicResource FooterBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TxtQASummaryTitle" Text="QA SUMMARY"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="12,0"/>
          </Border>

          <!-- Content wrapper with padding -->
          <Grid Grid.Row="1" Grid.RowSpan="6" Margin="12,10,12,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>  <!-- ALL   col 0 -->
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>  <!-- PASS  col 2 -->
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>  <!-- FAIL  col 4 -->
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>  <!-- SKIP  col 6 -->
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>  <!-- IGNORE col 8 -->
              </Grid.ColumnDefinitions>

              <!-- ALL filter button -->
              <Border x:Name="BdrAllBox" Grid.Column="0" CornerRadius="8" Padding="4,8"
                      Background="{DynamicResource InputBgBrush}"
                      BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="1"
                      Cursor="Hand" ToolTip="Show all rows"
                      MouseLeftButtonUp="BdrAllBox_Click">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="☰" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" Margin="0,0,0,1"/>
                  <TextBlock x:Name="TxtAllCount" Text="-" FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="ALL" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- PASS filter button -->
              <Border x:Name="BdrPassBox" Grid.Column="2" CornerRadius="8" Padding="4,8"
                      Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                      Cursor="Hand" ToolTip="Show Pass rows only"
                      MouseLeftButtonUp="BdrPassBox_Click">
                <StackPanel HorizontalAlignment="Center">
                  <Path Stroke="#2E7D32" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" Margin="0,2,0,3"
                        Data="M 0,4 L 3,8 L 9,0"/>
                  <TextBlock x:Name="TxtPassCount" Text="-" FontSize="11" FontWeight="Bold"
                             Foreground="#2E7D32" HorizontalAlignment="Center"/>
                  <TextBlock Text="PASS" FontSize="9" FontWeight="Bold"
                             Foreground="#388E3C" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- FAIL filter button -->
              <Border x:Name="BdrFailBox" Grid.Column="4" CornerRadius="8" Padding="4,8"
                      Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                      Cursor="Hand" ToolTip="Show Fail rows only"
                      MouseLeftButtonUp="BdrFailBox_Click">
                <StackPanel HorizontalAlignment="Center">
                  <Path Stroke="#C62828" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" Margin="0,2,0,3"
                        Data="M 0,0 L 8,8 M 8,0 L 0,8"/>
                  <TextBlock x:Name="TxtFailCount" Text="-" FontSize="11" FontWeight="Bold"
                             Foreground="#C62828" HorizontalAlignment="Center"/>
                  <TextBlock Text="FAIL" FontSize="9" FontWeight="Bold"
                             Foreground="#C62828" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- SKIP filter button -->
              <Border x:Name="BdrSkipBox" Grid.Column="6" CornerRadius="8" Padding="4,8"
                      Background="#F5F5F5" BorderBrush="#BDBDBD" BorderThickness="1"
                      Cursor="Hand" ToolTip="Show Skip rows only"
                      MouseLeftButtonUp="BdrSkipBox_Click">
                <StackPanel HorizontalAlignment="Center">
                  <Path Stroke="#757575" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" Margin="0,2,0,3"
                        Data="M 0,0 L 4,4 L 0,8 M 5,0 L 9,4 L 5,8"/>
                  <TextBlock x:Name="TxtSkipCount" Text="-" FontSize="11" FontWeight="Bold"
                             Foreground="#757575" HorizontalAlignment="Center"/>
                  <TextBlock Text="SKIP" FontSize="9" FontWeight="Bold"
                             Foreground="#757575" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- IGNORE filter button -->
              <Border x:Name="BdrIgnoreBox" Grid.Column="8" CornerRadius="8" Padding="4,8"
                      Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                      Cursor="Hand" ToolTip="Show Ignored rows only"
                      MouseLeftButtonUp="BdrIgnoreBox_Click">
                <StackPanel HorizontalAlignment="Center">
                  <Path Stroke="#E65100" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" Margin="0,2,0,3">
                    <Path.Data>
                      <GeometryGroup>
                        <EllipseGeometry Center="4.5,4.5" RadiusX="4.5" RadiusY="4.5"/>
                        <LineGeometry StartPoint="1.5,7.5" EndPoint="7.5,1.5"/>
                      </GeometryGroup>
                    </Path.Data>
                  </Path>
                  <TextBlock x:Name="TxtIgnoreCount" Text="-" FontSize="11" FontWeight="Bold"
                             Foreground="#E65100" HorizontalAlignment="Center"/>
                  <TextBlock Text="IGNORE" FontSize="9" FontWeight="Bold"
                             Foreground="#E65100" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

          <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderMainBrush}" Margin="0,0,0,10"/>

          <StackPanel Grid.Row="2">
            <TextBlock Text="PACKAGE INFO" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="App Name" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
            <TextBlock x:Name="InfoAppName" Text="-" FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="App Vendor" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
            <TextBlock x:Name="InfoPublisher" Text="-" FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="App Version" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
            <TextBlock x:Name="InfoVersion" Text="-" FontSize="10"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,0"/>
            <TextBlock x:Name="InfoScript" Visibility="Collapsed"/>
            <TextBlock x:Name="InfoLog"    Visibility="Collapsed"/>
          </StackPanel>

          <TextBlock Grid.Row="4" Text="COMMANDS" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>

          <!-- Commands list - scrollable so all nav items are reachable -->
          <ScrollViewer Grid.Row="5"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,0">
            <StackPanel x:Name="CommandNavPanel" Margin="0,0,0,0"/>
          </ScrollViewer>

          </Grid><!-- end inner content Grid -->
        </Grid><!-- end outer layout Grid -->
      </Border>

      <!-- ── RIGHT results ── -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- Header row -->
          <Border Grid.Row="0" CornerRadius="8,8,0,0"
                  Background="{DynamicResource FooterBgBrush}"
                  BorderBrush="{DynamicResource BorderMainBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="36"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="No." FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Commands" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="Type" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="Check List and Paths" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="Result" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </Border>
          <!-- Result rows.
               A plain StackPanel realizes EVERY row, so a package with 1000+ files built 1000+
               live visual trees and re-laid them out on every filter / search / scroll / resize.
               A ListBox virtualizes: only rows in the viewport get a container, and it also gives
               us ScrollIntoView, which works correctly with virtualization (TranslatePoint does
               not - an unrealized row has no position).

               The ListBoxItem template is stripped to a bare ContentPresenter and made
               non-focusable, so the ListBox contributes no selection chrome and no keyboard
               behaviour of its own; each row Border keeps its own background, click handling and
               selection exactly as before. Rows use MouseLeftButtonUp, and ListBoxItem only
               handles MouseLeftButtonDown, so row clicks are not swallowed.

               ScrollUnit=Pixel keeps smooth pixel scrolling despite the rows being
               variable-height (details wrap). -->
          <ListBox x:Name="QAResultsPanel" Grid.Row="1" Margin="0,2,0,6"
                   Background="Transparent" BorderThickness="0" Focusable="False"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Standard"
                   VirtualizingStackPanel.ScrollUnit="Pixel">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
