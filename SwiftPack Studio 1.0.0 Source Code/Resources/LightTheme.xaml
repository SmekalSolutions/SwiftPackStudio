<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== LIGHT THEME ===== -->
    <SolidColorBrush x:Key="WindowBgBrush"         Color="#F0F2F8"/>
    <SolidColorBrush x:Key="NavBarBgBrush"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush"           Color="#F7F8FC"/>
    <SolidColorBrush x:Key="InputBgAltBrush"        Color="#EEF0F8"/>
    <SolidColorBrush x:Key="DropdownBgBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScriptBgBrush"          Color="#FAFAFA"/>
    <SolidColorBrush x:Key="LineNumBgBrush"         Color="#F0F0F0"/>
    <SolidColorBrush x:Key="CommandPanelBgBrush"    Color="#F5F6FA"/>
    <SolidColorBrush x:Key="ParamPanelBgBrush"      Color="#F8F9FD"/>
    <SolidColorBrush x:Key="FooterBgBrush"          Color="#EBEDF5"/>
    <SolidColorBrush x:Key="BorderMainBrush"        Color="#D0D4E8"/>
    <SolidColorBrush x:Key="BorderInputBrush"       Color="#C5CADB"/>
    <SolidColorBrush x:Key="BorderCardBrush"        Color="#D0D4E8"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#1A1D2E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#4A5068"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#8B92A9"/>
    <SolidColorBrush x:Key="TextHeadingBrush"       Color="#0D0F1C"/>
    <SolidColorBrush x:Key="AccentBlueBrush"        Color="#3A7BE8"/>
    <!-- Hover state for a filled accent-blue surface (the selected tab on Validate Source).
         Lighter than the base, matching the direction the retired hardcoded pair used: that was
         #1565C0 with #1976D2 on hover, i.e. up ~17 on green and blue. This reuses the dark theme's
         accent value, which is already a lighter blue from the same palette family. -->
    <SolidColorBrush x:Key="AccentBlueHoverBrush"   Color="#4F8EF7"/>
    <SolidColorBrush x:Key="AccentGreenBrush"       Color="#2EBF8A"/>
    <SolidColorBrush x:Key="AccentAmberBrush"       Color="#C4850A"/>
    <SolidColorBrush x:Key="AccentRedBrush"         Color="#D93025"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"       Color="#55000000"/>
    <SolidColorBrush x:Key="NavHoverBrush"          Color="#11000000"/>
    <SolidColorBrush x:Key="ListItemHoverBrush"     Color="#EAF0FB"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush"  Color="#D8E6FA"/>
    <SolidColorBrush x:Key="GridSplitterBrush"      Color="#D0D4E8"/>
    <SolidColorBrush x:Key="SearchBoxBgBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoScriptBgBrush"        Color="#F0F2F8"/>
    <SolidColorBrush x:Key="RunningBadgeBgBrush"    Color="#DFF6EC"/>
    <!-- Semi-transparent for script editor (light) -->
    <Color x:Key="ScriptEditorBgColor">#E6F5F8FA</Color>
    <!-- Line highlight -->
    <Color x:Key="LineHighlightColor">#60E8F4FF</Color>
    <!-- Inline button accent colours adapted for light -->
    <SolidColorBrush x:Key="ImportBtnBgBrush"       Color="#F3EEFF"/>
    <SolidColorBrush x:Key="ImportBtnFgBrush"       Color="#6B3FC2"/>
    <SolidColorBrush x:Key="ImportBtnBorderBrush"   Color="#9B72E0"/>
    <SolidColorBrush x:Key="SaveBtnBgBrush"         Color="#EAF1FE"/>
    <SolidColorBrush x:Key="SaveBtnFgBrush"         Color="#2A6DD9"/>
    <SolidColorBrush x:Key="SaveBtnBorderBrush"     Color="#3A7BE8"/>
    <SolidColorBrush x:Key="OpenBtnFgBrush"         Color="#1A1D2E"/>
    <SolidColorBrush x:Key="OpenBtnBgBrush"         Color="#F0F5FF"/>
    <SolidColorBrush x:Key="OpenBtnBorderBrush"     Color="#C5CADB"/>
    <SolidColorBrush x:Key="CancelBtnBgBrush"       Color="#F5F5FA"/>
    <SolidColorBrush x:Key="CancelBtnFgBrush"       Color="#9098B8"/>
    <SolidColorBrush x:Key="CancelBtnBorderBrush"   Color="#C0C4D8"/>
    <SolidColorBrush x:Key="CancelActiveBgBrush"    Color="#FDECEA"/>
    <SolidColorBrush x:Key="CancelActiveFgBrush"    Color="#C0271E"/>
    <SolidColorBrush x:Key="CancelActiveBorderBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="TbBtnHoverBgBrush"      Color="#E8EDF8"/>
    <SolidColorBrush x:Key="TbBtnPressedBgBrush"    Color="#D8E0F4"/>
    <SolidColorBrush x:Key="TbBtnDisabledFgBrush"   Color="#B0B4C8"/>
    <SolidColorBrush x:Key="TbSaveBgBrush"          Color="#EAF1FE"/>
    <!-- Script editor -->
    <SolidColorBrush x:Key="LineHighlightFillBrush"     Color="#30B0D0FF"/>
    <SolidColorBrush x:Key="ScriptCaretBrush"           Color="#1A56CC"/>
    <!-- Script editor bg (semi-transparent over highlight canvas) -->
    <SolidColorBrush x:Key="ScriptEditorBgBrush"        Color="#E6F5F8FA"/>
    <!-- ── Dialog semantic colours (light) ── -->
    <SolidColorBrush x:Key="DlgBodyBgBrush"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DlgFooterBgBrush"           Color="#F0F2F8"/>
    <SolidColorBrush x:Key="DlgBorderBrush"             Color="#D0D4E8"/>
    <!-- Dialog header accents -->
    <Color x:Key="DlgHdrNeutralBg">#E8EBF5</Color>
    <Color x:Key="DlgHdrNeutralFg">#1A1D2E</Color>
    <Color x:Key="DlgHdrRedBg">#FDECEA</Color>
    <Color x:Key="DlgHdrRedFg">#C0271E</Color>
    <Color x:Key="DlgHdrAmberBg">#FEF6E4</Color>
    <Color x:Key="DlgHdrAmberFg">#8A5A00</Color>
    <Color x:Key="DlgHdrGreenBg">#E4F7F0</Color>
    <Color x:Key="DlgHdrGreenFg">#1A7A50</Color>
    <Color x:Key="DlgHdrBlueBg">#E8F0FE</Color>
    <Color x:Key="DlgHdrBlueFg">#1A56CC</Color>
    <!-- Dialog button styles -->
    <SolidColorBrush x:Key="DlgBtnNeutralBgBrush"       Color="#F0F2F8"/>
    <SolidColorBrush x:Key="DlgBtnNeutralFgBrush"       Color="#4A5068"/>
    <SolidColorBrush x:Key="DlgBtnNeutralBorderBrush"   Color="#C0C4D8"/>
    <SolidColorBrush x:Key="DlgBtnBlueBgBrush"          Color="#EAF1FE"/>
    <SolidColorBrush x:Key="DlgBtnBlueFgBrush"          Color="#1A56CC"/>
    <SolidColorBrush x:Key="DlgBtnBlueBorderBrush"      Color="#3A7BE8"/>
    <SolidColorBrush x:Key="DlgBtnGreenBgBrush"         Color="#E4F7F0"/>
    <SolidColorBrush x:Key="DlgBtnGreenFgBrush"         Color="#1A7A50"/>
    <SolidColorBrush x:Key="DlgBtnGreenBorderBrush"     Color="#2EBF8A"/>
    <SolidColorBrush x:Key="DlgBtnRedBgBrush"           Color="#FDECEA"/>
    <SolidColorBrush x:Key="DlgBtnRedFgBrush"           Color="#C0271E"/>
    <SolidColorBrush x:Key="DlgBtnRedBorderBrush"       Color="#D93025"/>
    <SolidColorBrush x:Key="DlgBtnAmberBgBrush"         Color="#FEF6E4"/>
    <SolidColorBrush x:Key="DlgBtnAmberFgBrush"         Color="#8A5A00"/>
    <SolidColorBrush x:Key="DlgBtnAmberBorderBrush"     Color="#C4850A"/>
    <!-- Reboot warning -->
    <SolidColorBrush x:Key="RebootWarnBgBrush"          Color="#FEF3DC"/>
    <SolidColorBrush x:Key="RebootWarnFgBrush"          Color="#8A5A00"/>
    <!-- Log/muted info text -->
    <SolidColorBrush x:Key="DlgInfoTextBrush"           Color="#7080A8"/>
    <!-- ── Nav icon accent pill backgrounds (light) ── -->
    <SolidColorBrush x:Key="NavIconMSTBrush"            Color="#EDE9FE"/>
    <SolidColorBrush x:Key="NavIconMSTFgBrush"          Color="#6D28D9"/>
    <SolidColorBrush x:Key="NavIconPkgBrush"            Color="#DBEAFE"/>
    <SolidColorBrush x:Key="NavIconPkgFgBrush"          Color="#1D4ED8"/>
    <SolidColorBrush x:Key="NavIconModBrush"            Color="#FEF3C7"/>
    <SolidColorBrush x:Key="NavIconModFgBrush"          Color="#B45309"/>
    <SolidColorBrush x:Key="NavIconExecBrush"           Color="#DCFCE7"/>
    <SolidColorBrush x:Key="NavIconExecFgBrush"         Color="#166534"/>
    <SolidColorBrush x:Key="NavIconIntuneBrush"         Color="#E0F2FE"/>
    <SolidColorBrush x:Key="NavIconIntuneFgBrush"       Color="#0369A1"/>
    <SolidColorBrush x:Key="NavIconPublishBrush"        Color="#FCE7F3"/>
    <SolidColorBrush x:Key="NavIconPublishFgBrush"      Color="#9D174D"/>
    <SolidColorBrush x:Key="NavIconAutoBrush"           Color="#FFF7ED"/>
    <SolidColorBrush x:Key="NavIconAutoFgBrush"         Color="#C2410C"/>
    <SolidColorBrush x:Key="NavIconQABrush"             Color="#F0FDF4"/>
    <SolidColorBrush x:Key="NavIconQAFgBrush"           Color="#15803D"/>
    <!-- ── Deploy type card styles (light) ── -->
    <SolidColorBrush x:Key="DeployCardInstallBgBrush"   Color="#F0FDF4"/>
    <SolidColorBrush x:Key="DeployCardInstallFgBrush"   Color="#166534"/>
    <SolidColorBrush x:Key="DeployCardInstallBorderBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="DeployCardUninstallBgBrush" Color="#FEF9EC"/>
    <SolidColorBrush x:Key="DeployCardUninstallFgBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="DeployCardUninstallBorderBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="DeployCardRepairBgBrush"    Color="#EFF6FF"/>
    <SolidColorBrush x:Key="DeployCardRepairFgBrush"    Color="#1E40AF"/>
    <SolidColorBrush x:Key="DeployCardRepairBorderBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="DeployCardInactiveBgBrush"  Color="#F8F9FD"/>
    <SolidColorBrush x:Key="DeployCardInactiveFgBrush"  Color="#6B7280"/>
    <SolidColorBrush x:Key="DeployCardInactiveBorderBrush" Color="#E5E7EB"/>
    <!-- ── Log panel (light) ── -->
    <SolidColorBrush x:Key="LogPanelBgBrush"            Color="#1E1E2E"/>
    <SolidColorBrush x:Key="LogPanelFgBrush"            Color="#CDD6F4"/>
    <!-- ── Toolbar button colour groups (light) ── -->
    <!-- Undo/Redo: Purple -->
    <SolidColorBrush x:Key="TbUndoBgBrush"              Color="#EDE9FE"/>
    <SolidColorBrush x:Key="TbUndoFgBrush"              Color="#6D28D9"/>
    <SolidColorBrush x:Key="TbUndoBorderBrush"          Color="#C4B5FD"/>
    <!-- Delete: Red -->
    <SolidColorBrush x:Key="TbDeleteBgBrush"            Color="#FDECEA"/>
    <SolidColorBrush x:Key="TbDeleteFgBrush"            Color="#C0271E"/>
    <SolidColorBrush x:Key="TbDeleteBorderBrush"        Color="#FCA5A5"/>
    <!-- Cut/Copy/Paste: Amber -->
    <SolidColorBrush x:Key="TbClipboardBgBrush"         Color="#FEF3C7"/>
    <SolidColorBrush x:Key="TbClipboardFgBrush"         Color="#B45309"/>
    <SolidColorBrush x:Key="TbClipboardBorderBrush"     Color="#FCD34D"/>
    <!-- MoveUp/Down: Blue -->
    <SolidColorBrush x:Key="TbMoveBgBrush"              Color="#DBEAFE"/>
    <SolidColorBrush x:Key="TbMoveFgBrush"              Color="#1D4ED8"/>
    <SolidColorBrush x:Key="TbMoveBorderBrush"          Color="#93C5FD"/>
    <!-- Comment/Uncomment: Teal -->
    <SolidColorBrush x:Key="TbCommentBgBrush"           Color="#DCFCE7"/>
    <SolidColorBrush x:Key="TbCommentFgBrush"           Color="#166534"/>
    <SolidColorBrush x:Key="TbCommentBorderBrush"       Color="#86EFAC"/>
    <!-- Insert: Indigo/Sky -->
    <SolidColorBrush x:Key="TbInsertBgBrush"            Color="#E0F2FE"/>
    <SolidColorBrush x:Key="TbInsertFgBrush"            Color="#0369A1"/>
    <SolidColorBrush x:Key="TbInsertBorderBrush"        Color="#7DD3FC"/>
    <!-- Tab buttons (Info / Script) -->
    <SolidColorBrush x:Key="TabInfoBgBrush"             Color="#EDE9FE"/>
    <SolidColorBrush x:Key="TabInfoFgBrush"             Color="#6D28D9"/>
    <SolidColorBrush x:Key="TabScriptBgBrush"           Color="#DCFCE7"/>
    <SolidColorBrush x:Key="TabScriptFgBrush"           Color="#166534"/>
</ResourceDictionary>